@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = null;
    var s = Model.Stats;
    var skillsDisplay = s.TotalSkills >= 100 ? $"{s.TotalSkills:N0}+" : s.TotalSkills.ToString("N0");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CogniCareer — Career Intelligence Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>
        /* ═══════════════════════════════════════════
           TRUST SIGNAL BAR
        ═══════════════════════════════════════════ */
        .lp-trust-bar {
            display: flex; align-items: center; justify-content: center;
            gap: 16px; padding: 18px 48px;
            background: var(--warm);
            border-bottom: 1px solid var(--line);
        }
        .lp-trust-avatars {
            display: flex; align-items: center;
        }
        .lp-trust-avatar {
            width: 28px; height: 28px; border-radius: 50%;
            border: 2px solid var(--warm);
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 700; color: var(--ink);
            flex-shrink: 0;
        }
        .lp-trust-avatar:not(:first-child) { margin-left: -8px; }
        .lp-trust-avatar-a { background: linear-gradient(135deg, var(--lime), var(--lime-d)); z-index: 3; }
        .lp-trust-avatar-f { background: linear-gradient(135deg, var(--lime-d), #6db800); z-index: 2; }
        .lp-trust-avatar-h { background: linear-gradient(135deg, #a0e020, var(--lime)); z-index: 1; }
        .lp-trust-text {
            font-size: 12px; color: var(--muted); font-weight: 400; letter-spacing: -.01em;
            font-family: var(--f-sans);
        }
        .lp-trust-text strong { color: var(--ink); font-weight: 700; }

        /* ═══════════════════════════════════════════
           MARQUEE STRIP
        ═══════════════════════════════════════════ */
        .lp-marquee-section {
            position: relative; z-index: 2;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            background: var(--warm);
            padding: 0; overflow: hidden;
        }
        .lp-marquee-inner {
            display: flex; align-items: stretch;
        }
        .lp-marquee-label {
            flex-shrink: 0; padding: 0 32px;
            display: flex; align-items: center;
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .2em;
            text-transform: uppercase; color: var(--muted); font-weight: 600;
            border-right: 1px solid var(--line);
            white-space: nowrap;
        }
        .lp-marquee-track {
            flex: 1; overflow: hidden; padding: 20px 0;
        }
        .lp-marquee-content {
            display: flex; gap: 0;
            animation: marqueeScroll 28s linear infinite;
            width: max-content;
        }
        .lp-marquee-content:hover { animation-play-state: paused; }
        @@keyframes marqueeScroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .lp-marquee-item {
            display: flex; align-items: center; gap: 10px;
            padding: 0 36px;
            font-family: var(--f-mono); font-size: 10px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--muted); font-weight: 600;
            white-space: nowrap;
            border-right: 1px solid var(--line);
            transition: color .2s;
        }
        .lp-marquee-item:hover { color: var(--ink); }
        .lp-marquee-num {
            font-family: var(--f-serif); font-size: 18px; font-weight: 900;
            letter-spacing: -.04em; line-height: 1;
            background: linear-gradient(135deg, var(--lime-d), var(--lime));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        /* ═══════════════════════════════════════════
           BENTO FEATURE GRID
        ═══════════════════════════════════════════ */
        .lp-bento-section {
            position: relative; z-index: 2;
            padding: 120px 80px;
            background: var(--paper);
            max-width: 100%;
        }
        @@media(max-width:768px) { .lp-bento-section { padding: 80px 24px; } }

        .lp-section-tag {
            display: inline-flex; align-items: center; gap: 12px;
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .28em;
            text-transform: uppercase; color: var(--ink); font-weight: 700;
            margin-bottom: 24px;
        }
        .lp-section-tag::before {
            content: ''; width: 32px; height: 1.5px;
            background: linear-gradient(to right, var(--lime-d), var(--muted));
            border-radius: 2px; flex-shrink: 0;
        }

        .lp-section-headline {
            font-family: var(--f-serif);
            font-size: clamp(36px, 5vw, 68px);
            font-weight: 900; line-height: .92;
            letter-spacing: -.05em; color: var(--ink);
            margin-bottom: 72px;
        }
        .lp-section-headline em {
            font-style: italic; font-weight: 400;
            background: linear-gradient(100deg, var(--lime-d), var(--muted));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        /* Bento grid */
        .lp-bento-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            grid-template-rows: auto;
            gap: 16px;
        }
        .lp-bento-card {
            background: var(--warm);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 36px 32px;
            position: relative; overflow: hidden;
            transition: transform .35s ease, box-shadow .35s ease, border-color .25s;
            cursor: default;
        }
        .lp-bento-card::before {
            content: ''; position: absolute; inset: 0; border-radius: inherit;
            background: linear-gradient(135deg, rgba(184,255,53,.06) 0%, transparent 60%);
            pointer-events: none;
        }
        .lp-bento-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 40px rgba(15,14,13,.10), 0 0 0 1px rgba(143,212,0,.25);
            border-color: rgba(143,212,0,.35);
        }

        /* Grid spans */
        .lp-bc-1 { grid-column: span 5; }
        .lp-bc-2 { grid-column: span 7; }
        .lp-bc-3 { grid-column: span 4; }
        .lp-bc-4 { grid-column: span 4; }
        .lp-bc-5 { grid-column: span 4; }
        .lp-bc-6 { grid-column: span 7; }
        .lp-bc-7 { grid-column: span 5; }

        @@media(max-width:900px) {
            .lp-bc-1,.lp-bc-2,.lp-bc-3,.lp-bc-4,.lp-bc-5,.lp-bc-6,.lp-bc-7 { grid-column: span 12; }
        }

        .lp-bento-card-accent {
            position: absolute; top: 0; left: 0; right: 0; height: 2px;
            opacity: 0; transition: opacity .3s;
        }
        .lp-bento-card:hover .lp-bento-card-accent { opacity: 1; }

        /* Icon in bento */
        .lp-bento-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 24px; flex-shrink: 0;
            position: relative; z-index: 1;
            transition: transform .3s ease;
        }
        .lp-bento-card:hover .lp-bento-icon { transform: scale(1.1) rotate(-6deg); }
        .lp-bi-lime  { background: rgba(143,212,0,.12); box-shadow: 0 0 20px rgba(184,255,53,.12); }
        .lp-bi-lime svg  { stroke: var(--lime-d); }

        .lp-bento-icon svg { width: 22px; height: 22px; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; fill: none; }

        .lp-bento-tag {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .18em; text-transform: uppercase;
            font-weight: 700; margin-bottom: 10px; display: inline-block;
            color: var(--lime-d);
            position: relative; z-index: 1;
        }
        .lp-bento-title {
            font-family: var(--f-serif); font-size: clamp(20px,2.2vw,28px); font-weight: 900;
            letter-spacing: -.04em; line-height: 1.05; margin-bottom: 14px; color: var(--ink);
            position: relative; z-index: 1;
        }
        .lp-bento-desc {
            font-size: 13.5px; line-height: 1.75; color: var(--muted); font-weight: 400;
            position: relative; z-index: 1;
        }
        .lp-bento-stat {
            display: inline-flex; align-items: center; gap: 6px; margin-top: 18px;
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--muted); font-weight: 600;
            padding: 5px 12px; border: 1px solid var(--line); border-radius: 100px;
            position: relative; z-index: 1;
        }

        /* Large bento card variant */
        .lp-bento-card-large { min-height: 260px; }
        .lp-bento-flex { display: flex; flex-direction: column; height: 100%; }
        .lp-bento-visual {
            margin-top: auto; padding-top: 24px;
            position: relative; z-index: 1;
        }

        /* Mini bar chart in bento */
        .lp-mini-bars {
            display: flex; align-items: flex-end; gap: 5px;
            height: 64px; margin-top: 8px;
        }
        .lp-mini-bar {
            flex: 1; border-radius: 3px 3px 0 0;
            background: linear-gradient(to top, var(--lime-d), var(--lime));
            opacity: .7; transition: opacity .2s, transform .2s;
            min-width: 8px;
        }
        .lp-bento-card:hover .lp-mini-bar { opacity: 1; }
        .lp-mini-bar:hover { transform: scaleY(1.06); opacity: 1 !important; }

        /* ═══════════════════════════════════════════
           HOW IT WORKS
        ═══════════════════════════════════════════ */
        .lp-how-section {
            position: relative; z-index: 2;
            padding: 120px 80px;
            background: var(--paper);
            max-width: 100%;
        }
        @@media(max-width:768px) { .lp-how-section { padding: 80px 24px; } }

        .lp-steps-wrap {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 0;
            position: relative;
        }
        @@media(max-width:768px) { .lp-steps-wrap { grid-template-columns: 1fr; } }

        .lp-steps-wrap::before {
            content: ''; position: absolute;
            top: 36px; left: calc(100%/6); right: calc(100%/6);
            height: 1.5px;
            background: linear-gradient(to right, var(--lime-d), var(--lime), var(--line));
            opacity: .5; pointer-events: none; z-index: 0;
        }
        @@media(max-width:768px) { .lp-steps-wrap::before { display: none; } }

        .lp-step {
            padding: 0 40px 0 0;
            position: relative; z-index: 1;
            transition: transform .3s ease;
        }
        .lp-step:hover { transform: translateY(-4px); }
        .lp-step:last-child { padding-right: 0; }

        .lp-step-num-wrap {
            display: flex; align-items: center; gap: 16px; margin-bottom: 28px;
        }
        .lp-step-num {
            width: 72px; height: 72px; border-radius: 50%; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-family: var(--f-serif); font-size: 26px; font-weight: 900;
            letter-spacing: -.04em; line-height: 1;
            background: var(--warm); border: 1.5px solid var(--line);
            color: var(--ink);
            box-shadow: 0 0 0 8px var(--paper);
            transition: border-color .3s, box-shadow .3s, background .3s;
            position: relative; z-index: 1;
        }
        .lp-step:hover .lp-step-num {
            border-color: var(--lime-d);
            box-shadow: 0 0 0 8px var(--paper), 0 0 24px rgba(184,255,53,.18);
            background: rgba(184,255,53,.06);
        }
        .lp-step-num-gradient {
            background: linear-gradient(135deg, var(--lime-d), var(--ink));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .lp-step-title {
            font-family: var(--f-serif); font-size: 22px; font-weight: 900;
            letter-spacing: -.04em; color: var(--ink); margin-bottom: 12px; line-height: 1.1;
        }
        .lp-step-desc {
            font-size: 14px; line-height: 1.78; color: var(--muted); font-weight: 400;
        }

        /* ═══════════════════════════════════════════
           CTA BAND
        ═══════════════════════════════════════════ */
        .lp-cta-band {
            position: relative; z-index: 2;
            margin: 0 48px 80px;
            border-radius: 16px;
            overflow: hidden;
            padding: 80px;
            background: var(--ink);
            border: 1px solid rgba(255,255,255,.08);
        }
        @@media(max-width:768px) { .lp-cta-band { margin: 0 16px 60px; padding: 48px 28px; } }

        .lp-cta-band-bg {
            position: absolute; inset: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 60% 100% at 0% 50%, rgba(184,255,53,.1) 0%, transparent 60%),
                radial-gradient(ellipse 40% 80% at 100% 50%, rgba(143,212,0,.06) 0%, transparent 60%);
        }
        .lp-cta-band-grid {
            position: absolute; inset: 0; pointer-events: none;
            background-image:
                linear-gradient(rgba(184,255,53,.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(184,255,53,.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .lp-cta-band-content { position: relative; z-index: 2; max-width: 680px; }
        .lp-cta-kicker {
            display: inline-flex; align-items: center; gap: 8px;
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .24em; text-transform: uppercase;
            color: var(--lime); font-weight: 700; margin-bottom: 24px;
        }
        .lp-cta-kicker::before { content: ''; width: 24px; height: 1.5px; background: var(--lime); border-radius: 2px; }
        .lp-cta-band-h {
            font-family: var(--f-serif);
            font-size: clamp(38px, 5.5vw, 76px);
            font-weight: 900; line-height: .9; letter-spacing: -.055em;
            color: var(--paper); margin-bottom: 24px;
        }
        .lp-cta-band-h em {
            font-style: italic; font-weight: 400;
            background: linear-gradient(100deg, var(--lime), var(--lime-d));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .lp-cta-band-sub {
            font-size: 15px; color: rgba(245,240,232,.55); line-height: 1.75; margin-bottom: 44px; font-weight: 300;
        }
        .lp-cta-row {
            display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
        }
        .lp-btn-primary {
            display: inline-flex; align-items: center; gap: 10px;
            font-family: var(--f-sans); font-size: 13px; font-weight: 700;
            letter-spacing: .08em; text-transform: uppercase;
            padding: 16px 36px; border-radius: 12px;
            background: var(--lime);
            color: var(--ink); border: none; cursor: pointer;
            box-shadow: 0 4px 24px rgba(184,255,53,.25);
            transition: all .3s ease;
            position: relative; overflow: hidden;
            text-decoration: none;
        }
        .lp-btn-primary::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,.15), transparent);
            opacity: 0; transition: opacity .2s;
        }
        .lp-btn-primary:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 16px 48px rgba(184,255,53,.32); background: var(--lime-d); color: var(--ink); }
        .lp-btn-primary:hover::before { opacity: 1; }
        .lp-btn-arrow { transition: transform .2s ease; }
        .lp-btn-primary:hover .lp-btn-arrow { transform: translateX(5px); }

        .lp-btn-ghost {
            display: inline-flex; align-items: center; gap: 8px;
            font-family: var(--f-sans); font-size: 12px; font-weight: 600;
            letter-spacing: .08em; text-transform: uppercase;
            padding: 15px 28px; border-radius: 12px;
            background: transparent; color: rgba(245,240,232,.55);
            border: 1.5px solid rgba(255,255,255,.12);
            cursor: pointer;
            transition: all .25s ease;
            position: relative;
            text-decoration: none;
        }
        .lp-btn-ghost::after {
            content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 1.5px;
            background: linear-gradient(to right, var(--lime), var(--lime-d));
            transform: scaleX(0); transform-origin: left;
            transition: transform .3s ease;
        }
        .lp-btn-ghost:hover { border-color: var(--lime); color: var(--paper); }
        .lp-btn-ghost:hover::after { transform: scaleX(1); }

        /* ═══════════════════════════════════════════
           FOOTER
        ═══════════════════════════════════════════ */
        .lp-footer {
            position: relative; z-index: 2;
            border-top: 1px solid var(--line);
            background: var(--paper);
            padding: 40px 80px 48px;
        }
        @@media(max-width:768px) { .lp-footer { padding: 32px 24px 40px; } }

        .lp-footer-top {
            display: flex; align-items: flex-start; justify-content: space-between;
            gap: 40px; margin-bottom: 40px;
            flex-wrap: wrap;
        }
        .lp-footer-brand .lp-footer-logo {
            font-family: var(--f-serif); font-size: 22px; font-weight: 900;
            letter-spacing: -.04em; color: var(--ink);
            display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
        }
        .lp-footer-brand .lp-footer-logo em { color: var(--lime-d); font-style: italic; font-weight: 400; }
        .lp-footer-tagline {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .16em;
            text-transform: uppercase; color: var(--muted); font-weight: 600;
        }
        .lp-footer-links {
            display: flex; gap: 40px; flex-wrap: wrap;
        }
        .lp-footer-col h4 {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .2em; text-transform: uppercase;
            color: var(--ink); font-weight: 700; margin-bottom: 16px;
        }
        .lp-footer-col a {
            display: block; font-size: 13px; color: var(--muted); margin-bottom: 10px;
            cursor: pointer; transition: color .15s; font-weight: 500;
            position: relative; width: fit-content;
            text-decoration: none;
        }
        .lp-footer-col a::after {
            content: ''; position: absolute; left: 0; bottom: -1px; right: 0; height: 1px;
            background: linear-gradient(to right, var(--lime-d), var(--lime));
            transform: scaleX(0); transform-origin: left;
            transition: transform .22s ease;
        }
        .lp-footer-col a:hover { color: var(--ink); }
        .lp-footer-col a:hover::after { transform: scaleX(1); }
        .lp-footer-bottom {
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
            border-top: 1px solid var(--line); padding-top: 28px;
        }
        .lp-footer-meta {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--muted); font-weight: 600;
        }
        .lp-footer-status {
            display: flex; align-items: center; gap: 8px;
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--lime-d); font-weight: 700;
            padding: 5px 14px; border-radius: 100px;
            background: rgba(184,255,53,.08); border: 1px solid rgba(184,255,53,.25);
            transition: box-shadow .2s;
        }
        .lp-footer-status:hover { box-shadow: 0 0 16px rgba(184,255,53,.18); }
        .lp-footer-status-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--lime-d); animation: lp-pulseDot 2s infinite; }
        @@keyframes lp-pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: .5; transform: scale(.8); }
        }

        /* Logo glyph in footer */
        .lp-footer-logo-glyph {
            width: 26px; height: 26px; border-radius: 6px;
            background: linear-gradient(135deg, var(--lime-d), var(--lime));
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; box-shadow: 0 0 16px rgba(184,255,53,.18);
        }

    </style>
</head>
<body class="home-page">
    <div id="cursor-dot"></div>
    <div id="cursor-ring"></div>

    <nav id="topbar">
        <div style="display:flex;align-items:center;gap:14px;">
            <div class="nav-logo" onclick="window.location.href='/'">
                <div class="nav-logo-glyph">
                    <svg viewBox="0 0 12 12" style="width:12px;height:12px;stroke:var(--lime);fill:none;stroke-width:2;stroke-linecap:round">
                        <path d="M2 9 L6 3 L10 9" />
                        <path d="M4 7h4" />
                    </svg>
                </div>
                Cogni<span>Career</span>
            </div>
            <div class="nav-divider"></div>
            <div class="nav-badge"><span class="nav-badge-dot"></span>v1.0 · 2026</div>
        </div>
        <div class="nav-center">
            <a href="/">Platform</a>
            <div class="nav-dropdown-wrap">
                <a href="#">Portals <span class="nav-caret"></span></a>
                <div class="nav-dropdown">
                    <div class="nav-dd-divider" style="margin:4px 0 4px"></div>
                    <a href="/Auth/StudentAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-s"><svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3.33 1.67 8.67 1.67 12 0v-5" /></svg></div>
                        <div><div class="nav-dd-label">Students</div><div class="nav-dd-sub">Career dashboard &amp; skill matching</div></div>
                    </a>
                    <a href="/Auth/CompanyAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-c"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /></svg></div>
                        <div><div class="nav-dd-label">Companies</div><div class="nav-dd-sub">Post jobs &amp; ranked applicants</div></div>
                    </a>
                    <a href="/Auth/AdminAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-a"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg></div>
                        <div><div class="nav-dd-label">Admin</div><div class="nav-dd-sub">Platform analytics &amp; control</div></div>
                    </a>
                    <div class="nav-dd-divider"></div>
                </div>
            </div>
