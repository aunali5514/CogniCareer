@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CogniCareer — Career Intelligence Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#0f0e0d;--ink-2:#1e1c1a;--paper:#f5f0e8;--warm:#ede8e0;--line:#d6cfc4;--muted:#8a847b;--lime:#b8ff35;--lime-d:#8fd400;--red:#ff3f3f;--blue:#3b7fff;--white:#ffffff;--f-serif:'Playfair Display',Georgia,serif;--f-mono:'DM Mono','Courier New',monospace;--f-sans:'Jost',sans-serif;--r-sm:3px;--r:6px;--r-lg:12px;--shadow:0 2px 16px rgba(15,14,13,.08);--shadow-lg:0 8px 48px rgba(15,14,13,.16)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--f-sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
button{font-family:var(--f-sans)}
h1,h2,h3,h4{font-family:var(--f-serif);font-weight:700;line-height:1.05;letter-spacing:-.03em}
.serif-i{font-style:italic;font-weight:400}
.btn{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:10px 22px;border-radius:var(--r-sm);border:1.5px solid transparent;cursor:pointer;transition:all .16s;white-space:nowrap}
.btn-dark{background:var(--ink);color:var(--paper);border-color:var(--ink)}.btn-dark:hover{background:var(--ink-2)}
.btn-lime{background:var(--lime);color:var(--ink);border-color:var(--lime)}.btn-lime:hover{background:var(--lime-d)}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--ink)}.btn-outline:hover{background:var(--ink);color:var(--paper)}
.btn-ghost{background:transparent;color:var(--muted);border-color:var(--line)}.btn-ghost:hover{border-color:var(--ink);color:var(--ink)}
.btn-lg{font-size:13px;padding:14px 36px}
.btn-xl{font-size:14px;padding:16px 48px}
/* Topbar */
#topbar{position:fixed;top:0;left:0;right:0;z-index:900;height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 48px;background:rgba(245,240,232,.92);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);transition:box-shadow .3s}
#topbar.scrolled{box-shadow:0 2px 32px rgba(15,14,13,.08);background:rgba(245,240,232,.97)}
.nav-logo{font-family:var(--f-serif);font-size:20px;font-weight:900;letter-spacing:-.04em;cursor:pointer;display:flex;align-items:center;gap:10px}
.nav-logo-glyph{width:26px;height:26px;border-radius:6px;background:var(--ink);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .2s}
.nav-logo:hover .nav-logo-glyph{transform:rotate(8deg) scale(1.08)}
.nav-logo-glyph svg{width:13px;height:13px;stroke:var(--lime);fill:none;stroke-width:2;stroke-linecap:round}
.nav-logo span{color:var(--lime-d);font-style:italic;font-weight:400}
.nav-center{display:flex;gap:40px;align-items:center}
.nav-center a{font-size:11.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);cursor:pointer;transition:color .15s}
.nav-center a:hover{color:var(--ink)}
.nav-right{display:flex;gap:8px;align-items:center}
/* Ticker */
.ticker-wrap{overflow:hidden;background:var(--ink);padding:10px 0}
.ticker-track{display:flex;white-space:nowrap;animation:ticker 32s linear infinite}
.ticker-item{font-family:var(--f-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.38);padding:0 36px;flex-shrink:0;border-right:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:8px}
.ticker-item em{color:var(--lime);font-style:normal;font-weight:600}
/* Hero */
.hero{padding:120px 48px 80px;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 480px;gap:60px;align-items:center}
.hero-kicker{font-family:var(--f-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);display:inline-flex;align-items:center;gap:10px;margin-bottom:26px;border:1px solid rgba(143,212,0,.4);border-radius:100px;padding:7px 16px 7px 12px;background:var(--white);box-shadow:0 0 0 3px rgba(143,212,0,.08)}
.hero-kicker-dot{width:6px;height:6px;border-radius:50%;background:var(--lime-d);animation:pulseDot 2s infinite}
.hero-h{font-family:var(--f-serif);font-size:clamp(48px,6vw,80px);font-weight:900;letter-spacing:-.05em;line-height:.95;margin-bottom:22px}
.hero-h em{font-style:italic;font-weight:400;color:var(--lime-d)}
.hero-sub{font-size:16px;color:var(--muted);line-height:1.7;margin-bottom:36px;max-width:500px;font-weight:300}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap}
/* Features section */
.features-section{padding:80px 48px;max-width:1200px;margin:0 auto}
.section-eyebrow{font-family:var(--f-mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;display:flex;align-items:center;gap:10px}
.section-eyebrow::before{content:'';width:20px;height:1px;background:var(--muted)}
.section-h{font-family:var(--f-serif);font-size:clamp(28px,4vw,48px);font-weight:900;letter-spacing:-.04em;margin-bottom:40px}
.features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.feat-card{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:28px;transition:transform .2s,box-shadow .2s}
.feat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.feat-num{font-family:var(--f-serif);font-size:11px;font-weight:900;color:rgba(15,14,13,.15);margin-bottom:16px;letter-spacing:-.02em}
.feat-icon{width:40px;height:40px;border-radius:var(--r);display:flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:18px}
.feat-title{font-family:var(--f-serif);font-size:18px;font-weight:700;letter-spacing:-.02em;margin-bottom:8px}
.feat-desc{font-size:13px;color:var(--muted);line-height:1.65;font-weight:300}
/* Footer */
footer{background:var(--ink);padding:40px 48px;display:flex;align-items:center;justify-content:space-between}
.footer-logo{font-family:var(--f-serif);font-size:17px;font-weight:900;color:var(--paper);letter-spacing:-.04em}
.footer-logo span{color:var(--lime);font-style:italic;font-weight:400}
.footer-copy{font-family:var(--f-mono);font-size:10px;letter-spacing:.08em;color:rgba(255,255,255,.25)}
@@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@@keyframes pulseDot{0%,100%{transform:scale(1)}50%{transform:scale(1.4)}}
.au{animation:fadeUp .55s ease both}
.au1{animation:fadeUp .55s ease .07s both}
.au2{animation:fadeUp .55s ease .14s both}
.au3{animation:fadeUp .55s ease .21s both}
</style>
</head>
<body>
<!-- Topbar -->
<nav id="topbar">
  <div class="nav-logo" onclick="window.location.href='/'">
    <div class="nav-logo-glyph"><svg viewBox="0 0 24 24"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/></svg></div>
    Cogni<span>Career</span>
  </div>
  <div class="nav-center">
    <a href="/Auth/StudentAuth">Students</a>
    <a href="/Auth/CompanyAuth">Companies</a>
    <a href="/Auth/AdminAuth">Admin</a>
  </div>
  <div class="nav-right">
    <a href="/Auth/StudentAuth" class="btn btn-ghost btn-sm">Sign In</a>
    <a href="/Auth/StudentAuth" class="btn btn-dark btn-sm">Get Started →</a>
  </div>
</nav>

<!-- Ticker -->
<div class="ticker-wrap" style="margin-top:62px">
  <div class="ticker-track">
    <span class="ticker-item"><em>AI-Powered</em> Match Scoring</span>
    <span class="ticker-item">Real-Time <em>Skill Gap</em> Analysis</span>
    <span class="ticker-item">Peer <em>Benchmarking</em></span>
    <span class="ticker-item">Smart <em>Career Alerts</em></span>
    <span class="ticker-item">Auto-Ranked <em>Applications</em></span>
    <span class="ticker-item"><em>AI-Powered</em> Match Scoring</span>
    <span class="ticker-item">Real-Time <em>Skill Gap</em> Analysis</span>
    <span class="ticker-item">Peer <em>Benchmarking</em></span>
    <span class="ticker-item">Smart <em>Career Alerts</em></span>
    <span class="ticker-item">Auto-Ranked <em>Applications</em></span>
  </div>
</div>

<!-- Hero -->
<section>
  <div class="hero">
    <div>
      <div class="hero-kicker au"><div class="hero-kicker-dot"></div>Career Intelligence Platform</div>
      <h1 class="hero-h au1">Match.<br><em>Score.</em><br>Hire.</h1>
      <p class="hero-sub au2">CogniCareer calculates your exact skill match score for every job, shows your peer percentile, and guides you to close every gap — before you apply.</p>
      <div class="hero-cta au3">
        <a href="/Auth/StudentAuth" class="btn btn-dark btn-xl">Student Portal →</a>
        <a href="/Auth/CompanyAuth" class="btn btn-lime btn-xl">Post Jobs →</a>
      </div>
    </div>
    <div class="au2" style="background:var(--ink);border-radius:var(--r-lg);padding:32px;border:1px solid rgba(184,255,53,.1)">
      <div style="font-family:var(--f-mono);font-size:8px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:16px">Live Match Preview</div>
      <div style="font-family:var(--f-serif);font-size:32px;font-weight:900;color:var(--lime);letter-spacing:-.04em;line-height:1;margin-bottom:4px">87%</div>
      <div style="font-family:var(--f-mono);font-size:10px;color:rgba(255,255,255,.4);margin-bottom:20px">Match Score · Software Engineer Intern</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        @foreach(var feat in new[]{"✓ React.js — Advanced","✓ Node.js — Intermediate","✓ Git — Advanced","✗ Docker — Missing","✗ AWS — Missing"})
        {
          var isMatch = feat.StartsWith("✓");
          <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:@(isMatch ? "#b8ff35" : "rgba(255,255,255,.3)")">@feat</div>
        }
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="features-section">
  <div class="section-eyebrow">How It Works</div>
  <h2 class="section-h">Intelligence at every step<br>of your career.</h2>
  <div class="features-grid">
    <div class="feat-card">
      <div class="feat-num">01</div>
      <div class="feat-icon" style="background:rgba(143,212,0,.12);color:var(--lime-d)">📊</div>
      <div class="feat-title">Match Score on Every Job</div>
      <div class="feat-desc">Your exact % skill compatibility is calculated before you apply. Know when to apply and when to upskill first.</div>
    </div>
    <div class="feat-card">
      <div class="feat-num">02</div>
      <div class="feat-icon" style="background:rgba(59,127,255,.1);color:var(--blue)">🔍</div>
      <div class="feat-title">Gap Analysis with Resources</div>
      <div class="feat-desc">Every missing skill links to a curated learning path. Close gaps systematically, not randomly.</div>
    </div>
    <div class="feat-card">
      <div class="feat-num">03</div>
      <div class="feat-icon" style="background:rgba(26,122,58,.1);color:#1a7a3a">📈</div>
      <div class="feat-title">Live Peer Benchmarking</div>
      <div class="feat-desc">Know your percentile among all applicants for any role in real time. Stay ahead of the curve.</div>
    </div>
    <div class="feat-card">
      <div class="feat-num">04</div>
      <div class="feat-icon" style="background:rgba(255,63,63,.08);color:var(--red)">🏢</div>
      <div class="feat-title">Auto-Ranked Applicants</div>
      <div class="feat-desc">Companies receive applicants ranked by match score the moment they apply. Zero manual screening needed.</div>
    </div>
    <div class="feat-card">
      <div class="feat-num">05</div>
      <div class="feat-icon" style="background:rgba(143,212,0,.12);color:var(--lime-d)">🔔</div>
      <div class="feat-title">Smart Alerts</div>
      <div class="feat-desc">Get notified when your score improves, when you're near the top, or when a high-match job is posted.</div>
    </div>
    <div class="feat-card">
      <div class="feat-num">06</div>
      <div class="feat-icon" style="background:rgba(59,127,255,.1);color:var(--blue)">⚡</div>
      <div class="feat-title">Pipeline Management</div>
      <div class="feat-desc">One-click status updates for companies. Candidates are notified automatically at every stage.</div>
    </div>
  </div>
</section>

<footer>
  <div class="footer-logo">Cogni<span>Career</span></div>
  <div class="footer-copy">© 2025 CogniCareer · Career Intelligence Platform</div>
</footer>

<script>
window.addEventListener('scroll', function(){
  document.getElementById('topbar').classList.toggle('scrolled', window.scrollY > 20);
});
</script>
</body>
</html>