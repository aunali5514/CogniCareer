@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = null;
    var s = Model.Stats;
    var skillsDisplay = s.TotalSkills >= 100 ? $"{s.TotalSkills:N0}+" : s.TotalSkills.ToString("N0");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CogniCareer — Career Intelligence Platform</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%238fd400'/%3E%3Cstop offset='100%25' stop-color='%23b8ff35'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='28' height='28' rx='6' fill='url(%23g)'/%3E%3Cpath d='M7 20 L14 8 L21 20' stroke='%230f0e0d' stroke-width='2.4' stroke-linecap='round' fill='none'/%3E%3Cpath d='M10 16h8' stroke='%230f0e0d' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>
    /* ═══════════════════════════════════════════
       NEW SECTIONS — ZIP COLOUR PALETTE
       Uses: --ink, --paper, --warm, --line, --muted,
             --lime, --lime-d, --red, --blue
             --f-serif, --f-mono, --f-sans
    ═══════════════════════════════════════════ */

    /* Shared section tokens (remapped to zip palette) */
    .lp-tx1   { color: var(--ink); }
    .lp-tx2   { color: var(--muted); }
    .lp-tx3   { color: var(--muted); opacity:.7; }

    /* ── Scroll-reveal ── */
    .sr { opacity:0; transform:translateY(32px); transition:opacity .7s ease, transform .7s cubic-bezier(.16,1,.3,1); }
    .sr.visible { opacity:1; transform:translateY(0); }
    .sr-d1 { transition-delay:.1s; }
    .sr-d2 { transition-delay:.2s; }
    .sr-d3 { transition-delay:.3s; }

    /* ── Marquee Strip ── */
    .lp-marquee-section {
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        background: var(--warm);
        overflow: hidden;
    }
    .lp-marquee-inner { display:flex; align-items:stretch; }
    .lp-marquee-label {
        flex-shrink:0; padding:0 28px;
        display:flex; align-items:center;
        font-family:var(--f-mono); font-size:9px; letter-spacing:.2em;
        text-transform:uppercase; color:var(--muted); font-weight:600;
        border-right:1px solid var(--line); white-space:nowrap;
    }
    .lp-marquee-track { flex:1; overflow:hidden; padding:18px 0; }
    .lp-marquee-content {
        display:flex; gap:0;
        animation:marqueeScroll 32s linear infinite; width:max-content;
    }
    .lp-marquee-content:hover { animation-play-state:paused; }
    @@keyframes marqueeScroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
    .lp-marquee-item {
        display:flex; align-items:center; gap:10px;
        padding:0 32px;
        font-family:var(--f-mono); font-size:10px; letter-spacing:.12em;
        text-transform:uppercase; color:var(--muted); font-weight:600;
        white-space:nowrap; border-right:1px solid var(--line);
        transition:color .2s;
    }
    .lp-marquee-item:hover { color:var(--ink); }
    .lp-marquee-num {
        font-family:var(--f-serif); font-size:18px; font-weight:900;
        letter-spacing:-.04em; line-height:1; color:var(--lime-d);
    }

    /* ── Section Headers ── */
    .lp-section-tag {
        display:inline-flex; align-items:center; gap:12px;
        font-family:var(--f-mono); font-size:9px; letter-spacing:.28em;
        text-transform:uppercase; color:var(--lime-d); font-weight:700;
        margin-bottom:20px;
    }
    .lp-section-tag::before {
        content:''; width:28px; height:1.5px;
        background:linear-gradient(to right, var(--lime-d), var(--lime));
        border-radius:2px; flex-shrink:0;
    }
    .lp-section-headline {
        font-family:var(--f-serif);
        font-size:@("clamp(34px, 5vw, 64px)");
        font-weight:900; line-height:.93;
        letter-spacing:-.05em; color:var(--ink);
        margin-bottom:64px;
    }
    .lp-section-headline em {
        font-style:italic; font-weight:400; color:var(--lime-d);
    }

    /* ── Bento Grid ── */
    .lp-bento-section {
        padding:100px 72px; max-width:1400px; margin:0 auto;
    }
    @@media(max-width:768px){ .lp-bento-section{padding:64px 24px;} }

    .lp-bento-grid {
        display:grid;
        grid-template-columns:repeat(12,1fr);
        gap:14px;
    }
    .lp-bento-card {
        background:var(--paper);
        border:1px solid var(--line);
        border-radius:var(--r-lg);
        padding:32px 28px;
        position:relative; overflow:hidden;
        transition:transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s, border-color .25s;
        cursor:default;
    }
    .lp-bento-card:hover {
        transform:translateY(-4px);
        box-shadow:var(--shadow-lg);
        border-color:var(--lime-d);
    }
    .lp-bento-card-accent {
        position:absolute; top:0; left:0; right:0; height:2px;
        opacity:0; transition:opacity .3s;
    }
    .lp-bento-card:hover .lp-bento-card-accent { opacity:1; }

    .lp-bc-1 { grid-column:span 5; }
    .lp-bc-2 { grid-column:span 7; }
    .lp-bc-3 { grid-column:span 4; }
    .lp-bc-4 { grid-column:span 4; }
    .lp-bc-5 { grid-column:span 4; }
    .lp-bc-6 { grid-column:span 7; }
    .lp-bc-7 { grid-column:span 5; }
    @@media(max-width:900px){
        .lp-bc-1,.lp-bc-2,.lp-bc-3,.lp-bc-4,.lp-bc-5,.lp-bc-6,.lp-bc-7 { grid-column:span 12; }
    }

    .lp-bento-icon {
        width:44px; height:44px; border-radius:var(--r);
        display:flex; align-items:center; justify-content:center;
        margin-bottom:20px; flex-shrink:0;
        background:var(--warm); border:1px solid var(--line);
        transition:transform .3s cubic-bezier(.34,1.56,.64,1);
    }
    .lp-bento-card:hover .lp-bento-icon { transform:scale(1.1) rotate(-6deg); }
    .lp-bento-icon svg { width:20px; height:20px; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; fill:none; stroke:var(--ink); }
    .lp-bento-icon.ic-lime svg { stroke:var(--lime-d); }

    .lp-bento-tag {
        font-family:var(--f-mono); font-size:9px; letter-spacing:.18em; text-transform:uppercase;
        font-weight:700; margin-bottom:8px; color:var(--muted); display:inline-block;
    }
    .lp-bento-tag.tag-lime { color:var(--lime-d); }
    .lp-bento-title {
        font-family:var(--f-serif); font-size:@("clamp(19px,2vw,26px)"); font-weight:900;
        letter-spacing:-.04em; line-height:1.05; margin-bottom:12px; color:var(--ink);
    }
    .lp-bento-desc {
        font-size:13.5px; line-height:1.75; color:var(--muted); font-weight:400;
    }
    .lp-bento-stat {
        display:inline-flex; align-items:center; gap:6px; margin-top:16px;
        font-family:var(--f-mono); font-size:9px; letter-spacing:.12em;
        text-transform:uppercase; color:var(--muted); font-weight:600;
        padding:4px 12px; border:1px solid var(--line); border-radius:100px;
    }
    .lp-bento-card-large { min-height:260px; }
    .lp-bento-flex { display:flex; flex-direction:column; height:100%; }
    .lp-bento-visual { margin-top:auto; padding-top:20px; }
    .lp-mini-bars { display:flex; align-items:flex-end; gap:4px; height:56px; margin-top:8px; }
    .lp-mini-bar {
        flex:1; border-radius:2px 2px 0 0;
        background:linear-gradient(to top, var(--lime-d), var(--lime));
        opacity:.6; transition:opacity .2s;
    }
    .lp-mini-bar.gap-bar { background:linear-gradient(to top, var(--muted), var(--line)); opacity:.35; }
    .lp-bento-card:hover .lp-mini-bar { opacity:1; }

    /* ── How It Works ── */
    .lp-how-section {
        padding:0 72px 100px; max-width:1400px; margin:0 auto;
    }
    @@media(max-width:768px){ .lp-how-section{padding:0 24px 72px;} }

    .lp-steps-wrap {
        display:grid; grid-template-columns:1fr 1fr 1fr; gap:0;
        position:relative;
    }
    @@media(max-width:768px){ .lp-steps-wrap{grid-template-columns:1fr;} }
    .lp-steps-wrap::before {
        content:''; position:absolute;
        top:36px; left:@("calc(100%/6)"); right:@("calc(100%/6)");
        height:1.5px;
        background:linear-gradient(to right, var(--lime-d), var(--lime), var(--line));
        opacity:.4; pointer-events:none;
    }
    @@media(max-width:768px){ .lp-steps-wrap::before{display:none;} }
    .lp-step {
        padding:0 32px 0 0; position:relative; z-index:1;
        transition:transform .3s cubic-bezier(.16,1,.3,1);
    }
    .lp-step:hover { transform:translateY(-4px); }
    .lp-step:last-child { padding-right:0; }
    .lp-step-num-wrap { display:flex; align-items:center; gap:16px; margin-bottom:24px; }
    .lp-step-num {
        width:72px; height:72px; border-radius:50%; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        font-family:var(--f-serif); font-size:24px; font-weight:900;
        letter-spacing:-.04em; line-height:1;
        background:var(--paper); border:1.5px solid var(--line);
        color:var(--ink); box-shadow:0 0 0 8px var(--paper);
        transition:border-color .3s, box-shadow .3s;
    }
    .lp-step:hover .lp-step-num {
        border-color:var(--lime-d);
        box-shadow:0 0 0 8px var(--paper), 0 0 24px rgba(184,255,53,.3);
    }
    .lp-step-num-gradient { color:var(--lime-d); }
    .lp-step-title {
        font-family:var(--f-serif); font-size:22px; font-weight:900;
        letter-spacing:-.04em; color:var(--ink); margin-bottom:10px; line-height:1.1;
    }
    .lp-step-desc { font-size:13.5px; line-height:1.78; color:var(--muted); }

    /* ── CTA Band ── */
    .lp-cta-band {
        position:relative; margin:0 48px 80px;
        border-radius:var(--r-lg); overflow:hidden;
        padding:72px 72px;
        background:var(--ink); border:1px solid var(--ink-2);
    }
    @@media(max-width:768px){ .lp-cta-band{margin:0 16px 60px;padding:48px 28px;} }
    .lp-cta-band-bg {
        position:absolute; inset:0; pointer-events:none;
        background:
            radial-gradient(ellipse 60% 80% at 10% 50%, rgba(184,255,53,.07) 0%, transparent 60%),
            radial-gradient(ellipse 40% 60% at 90% 50%, rgba(184,255,53,.04) 0%, transparent 60%);
    }
    .lp-cta-band-grid {
        position:absolute; inset:0; pointer-events:none;
        background-image:
            linear-gradient(rgba(184,255,53,.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(184,255,53,.025) 1px, transparent 1px);
        background-size:40px 40px;
    }
    .lp-cta-band-content { position:relative; z-index:2; max-width:680px; }
    .lp-cta-kicker {
        display:inline-flex; align-items:center; gap:8px;
        font-family:var(--f-mono); font-size:9px; letter-spacing:.24em; text-transform:uppercase;
        color:var(--lime); font-weight:700; margin-bottom:20px;
    }
    .lp-cta-kicker::before { content:''; width:20px; height:1.5px; background:var(--lime); border-radius:2px; }
    .lp-cta-band-h {
        font-family:var(--f-serif);
        font-size:@("clamp(36px, 5.5vw, 72px)");
        font-weight:900; line-height:.9; letter-spacing:-.055em;
        color:var(--paper); margin-bottom:20px;
    }
    .lp-cta-band-h em { font-style:italic; font-weight:400; color:var(--lime); }
    .lp-cta-band-sub {
        font-size:14.5px; color:rgba(245,240,232,.6); line-height:1.75; margin-bottom:40px;
    }
    .lp-cta-row { display:flex; gap:14px; align-items:center; flex-wrap:wrap; }
    .lp-btn-primary {
        display:inline-flex; align-items:center; gap:10px;
        font-family:var(--f-sans); font-size:12px; font-weight:700;
        letter-spacing:.08em; text-transform:uppercase;
        padding:15px 32px; border-radius:var(--r);
        background:var(--lime); color:var(--ink); border:none; cursor:pointer;
        box-shadow:0 4px 24px rgba(184,255,53,.3);
        transition:all .3s cubic-bezier(.16,1,.3,1);
    }
    .lp-btn-primary:hover { transform:translateY(-3px); box-shadow:0 10px 32px rgba(184,255,53,.4); background:var(--lime-d); }
    .lp-btn-arrow { transition:transform .2s cubic-bezier(.34,1.56,.64,1); }
    .lp-btn-primary:hover .lp-btn-arrow { transform:translateX(5px); }
    .lp-btn-ghost {
        display:inline-flex; align-items:center; gap:8px;
        font-family:var(--f-sans); font-size:12px; font-weight:600;
        letter-spacing:.08em; text-transform:uppercase;
        padding:14px 26px; border-radius:var(--r);
        background:transparent; color:rgba(245,240,232,.5);
        border:1.5px solid rgba(245,240,232,.18); cursor:pointer;
        transition:all .25s ease;
    }
    .lp-btn-ghost:hover { border-color:var(--lime); color:var(--lime); }

    /* ── Footer ── */
    .lp-footer {
        border-top:1px solid var(--line);
        padding:40px 72px 48px;
        background:var(--paper);
    }
    @@media(max-width:768px){ .lp-footer{padding:32px 24px 40px;} }
    .lp-footer-top {
        display:flex; align-items:flex-start; justify-content:space-between;
        gap:40px; margin-bottom:40px; flex-wrap:wrap;
    }
    .lp-footer-logo {
        font-family:var(--f-serif); font-size:20px; font-weight:900;
        letter-spacing:-.04em; color:var(--ink);
        display:flex; align-items:center; gap:10px; margin-bottom:10px;
    }
    .lp-footer-logo span { color:var(--lime-d); }
    .lp-footer-tagline {
        font-family:var(--f-mono); font-size:9px; letter-spacing:.16em;
        text-transform:uppercase; color:var(--muted); font-weight:600;
    }
    .lp-footer-links { display:flex; gap:40px; flex-wrap:wrap; }
    .lp-footer-col h4 {
        font-family:var(--f-mono); font-size:9px; letter-spacing:.2em; text-transform:uppercase;
        color:var(--ink); font-weight:700; margin-bottom:14px;
    }
    .lp-footer-col a {
        display:block; font-size:13px; color:var(--muted); margin-bottom:9px;
        cursor:pointer; transition:color .15s; font-weight:500;
    }
    .lp-footer-col a:hover { color:var(--ink); }
    .lp-footer-bottom {
        display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;
        border-top:1px solid var(--line); padding-top:24px;
    }
    .lp-footer-meta {
        font-family:var(--f-mono); font-size:9px; letter-spacing:.12em;
        text-transform:uppercase; color:var(--muted); font-weight:600;
    }
    .lp-footer-status {
        display:flex; align-items:center; gap:8px;
        font-family:var(--f-mono); font-size:9px; letter-spacing:.12em;
        text-transform:uppercase; color:var(--lime-d); font-weight:700;
        padding:4px 12px; border-radius:100px;
        background:rgba(184,255,53,.07); border:1px solid rgba(184,255,53,.25);
    }
    .lp-footer-status-dot {
        width:5px; height:5px; border-radius:50%; background:var(--lime-d);
        animation:pulseDot 2s infinite;
    }
    @@keyframes pulseDot {
        0%,100%{box-shadow:0 0 0 0 rgba(184,255,53,.4)}
        50%{box-shadow:0 0 0 4px rgba(184,255,53,0)}
    }

    /* Notification preview box */
    .notif-preview {
        margin-top:16px; background:var(--warm); border:1px solid var(--line);
        border-radius:var(--r); padding:10px 12px;
        display:flex; align-items:flex-start; gap:8px;
    }
    .notif-dot {
        width:6px; height:6px; border-radius:50%; background:var(--lime-d);
        margin-top:4px; flex-shrink:0; animation:pulseDot 2s infinite;
    }
    </style>
</head>
<body class="home-page">
    <div id="cursor-dot"></div>
    <div id="cursor-ring"></div>

    <!-- ═══════════ NAV (UNCHANGED — from zip) ═══════════ -->
    <nav id="topbar">
        <div style="display:flex;align-items:center;gap:14px;">
            <div class="nav-logo" onclick="window.location.href='/'">
                <div class="nav-logo-glyph">
                    <svg viewBox="0 0 12 12" style="width:12px;height:12px;stroke:var(--lime);fill:none;stroke-width:2;stroke-linecap:round">
                        <path d="M2 9 L6 3 L10 9" />
                        <path d="M4 7h4" />
                    </svg>
                </div>
                Cogni<span>Career</span>
            </div>
            <div class="nav-divider"></div>
            <div class="nav-badge"><span class="nav-badge-dot"></span>v1.0 · 2026</div>
        </div>
        <div class="nav-center">
            <a href="/">Platform</a>
            <div class="nav-dropdown-wrap">
                <a href="#">Portals <span class="nav-caret"></span></a>
                <div class="nav-dropdown">
                    <div class="nav-dd-divider" style="margin:4px 0 4px"></div>
                    <a href="/Auth/StudentAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-s"><svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3.33 1.67 8.67 1.67 12 0v-5" /></svg></div>
                        <div><div class="nav-dd-label">Students</div><div class="nav-dd-sub">Career dashboard &amp; skill matching</div></div>
                    </a>
                    <a href="/Auth/CompanyAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-c"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /></svg></div>
                        <div><div class="nav-dd-label">Companies</div><div class="nav-dd-sub">Post jobs &amp; ranked applicants</div></div>
                    </a>
                    <a href="/Auth/AdminAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-a"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg></div>
                        <div><div class="nav-dd-label">Admin</div><div class="nav-dd-sub">Platform analytics &amp; control</div></div>
                    </a>
                    <div class="nav-dd-divider"></div>
                </div>
            </div>
        </div>
        <div class="nav-right">
            <a href="/Auth/StudentAuth" class="btn btn-ghost btn-sm">Sign In</a>
            <a href="/Auth/CompanyAuth" class="btn btn-lime btn-sm">Get Started →</a>
        </div>
    </nav>

    <!-- ═══════════ TICKER (UNCHANGED — from zip) ═══════════ -->
    <div class="ticker-wrap">
        <div class="ticker-track">
            <span class="ticker-item">Match Score <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Skills Tracked <em>@skillsDisplay</em></span>
            <span class="ticker-item">Active Students <em>@s.TotalStudents.ToString("N0")</em></span>
            <span class="ticker-item">Companies Hiring <em>@s.TotalCompanies.ToString("N0")</em></span>
            <span class="ticker-item">Match Accuracy <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Applications Today <em>@s.ApplicationsToday.ToString("N0")</em></span>
            <span class="ticker-item">Active Jobs <em>@s.TotalActiveJobs.ToString("N0")</em></span>
            <span class="ticker-item">Jobs Posted This Week <em>@s.JobsPostedThisWeek.ToString("N0")</em></span>
            <span class="ticker-item">Match Score <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Skills Tracked <em>@skillsDisplay</em></span>
            <span class="ticker-item">Active Students <em>@s.TotalStudents.ToString("N0")</em></span>
            <span class="ticker-item">Companies Hiring <em>@s.TotalCompanies.ToString("N0")</em></span>
            <span class="ticker-item">Match Accuracy <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Applications Today <em>@s.ApplicationsToday.ToString("N0")</em></span>
            <span class="ticker-item">Active Jobs <em>@s.TotalActiveJobs.ToString("N0")</em></span>
            <span class="ticker-item">Jobs Posted This Week <em>@s.JobsPostedThisWeek.ToString("N0")</em></span>
        </div>
    </div>

    <!-- ═══════════ HERO (UNCHANGED — exact from screenshot) ═══════════ -->
    <div class="hero-wrap">
        <div>
            <div class="hero-kicker au"><span class="kicker-dot"></span>Career Intelligence Platform · 2026</div>
            <h1 class="hero-h1 au1">
                <span class="grad-text">Know</span><br>
                the <span class="stroke">Gap.</span><br>
                <span class="grad-text">Close It.</span>
            </h1>
            <p class="hero-sub au2">AI-calculated skill matching between students and real opportunities. See exactly where you stand, what you're missing, and the fastest path forward.</p>
            <div class="hero-actions au3">
                <a href="/Auth/StudentAuth" class="btn btn-dark btn-lg">Student Portal →</a>
                <a href="/Auth/CompanyAuth" class="btn btn-lime btn-lg">Hire Talent →</a>
                <a href="/Auth/AdminAuth" class="btn btn-outline btn-lg">Admin</a>
