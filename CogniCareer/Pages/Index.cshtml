  <div class="footer-left">
    <div class="footer-logo-mark">Cogni<span>Career</span></div>
    <div class="footer-sep"></div>
    <div class="footer-tagline">Career Intelligence &amp; Skill Gap Platform</div>
  </div>
  <div class="footer-right">
    <span class="footer-meta">© 2026 CogniCareer</span>
    <div class="footer-pill"><span class="footer-pill-dot"></span>Career Intelligence Platform</div>
  </div>
</footer>

