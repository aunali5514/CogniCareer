@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = null;
    var s = Model.Stats;
    var skillsDisplay = s.TotalSkills >= 100 ? $"{s.TotalSkills:N0}+" : s.TotalSkills.ToString("N0");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CogniCareer — Career Intelligence Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="home-page">
    <div id="cursor-dot"></div>
    <div id="cursor-ring"></div>

    <nav id="topbar">
        <div style="display:flex;align-items:center;gap:14px;">
            <div class="nav-logo" onclick="window.location.href='/'">
                <div class="nav-logo-glyph">
                    <svg viewBox="0 0 12 12" style="width:12px;height:12px;stroke:var(--lime);fill:none;stroke-width:2;stroke-linecap:round">
                        <path d="M2 9 L6 3 L10 9" />
                        <path d="M4 7h4" />
                    </svg>
                </div>
                Cogni<span>Career</span>
            </div>
            <div class="nav-divider"></div>
            <div class="nav-badge"><span class="nav-badge-dot"></span>v1.0 · 2026</div>
        </div>
        <div class="nav-center">
            <a href="/">Platform</a>
            <div class="nav-dropdown-wrap">
                <a href="#">Portals <span class="nav-caret"></span></a>
                <div class="nav-dropdown">
                    <div class="nav-dd-divider" style="margin:4px 0 4px"></div>
                    <a href="/Auth/StudentAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-s"><svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3.33 1.67 8.67 1.67 12 0v-5" /></svg></div>
                        <div><div class="nav-dd-label">Students</div><div class="nav-dd-sub">Career dashboard &amp; skill matching</div></div>
                    </a>
                    <a href="/Auth/CompanyAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-c"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /></svg></div>
                        <div><div class="nav-dd-label">Companies</div><div class="nav-dd-sub">Post jobs &amp; ranked applicants</div></div>
                    </a>
                    <a href="/Auth/AdminAuth" class="nav-dd-item">
                        <div class="nav-dd-ico nav-dd-ico-a"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg></div>
                        <div><div class="nav-dd-label">Admin</div><div class="nav-dd-sub">Platform analytics &amp; control</div></div>
                    </a>
                    <div class="nav-dd-divider"></div>
                </div>
            </div>
        </div>
        <div class="nav-right">
            <a href="/Auth/StudentAuth" class="btn btn-ghost btn-sm">Sign In</a>
            <a href="/Auth/CompanyAuth" class="btn btn-lime btn-sm">Get Started →</a>
        </div>
    </nav>

    <div class="ticker-wrap">
        <div class="ticker-track">
            <span class="ticker-item">Match Score <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Skills Tracked <em>@skillsDisplay</em></span>
            <span class="ticker-item">Active Students <em>@s.TotalStudents.ToString("N0")</em></span>
            <span class="ticker-item">Companies Hiring <em>@s.TotalCompanies.ToString("N0")</em></span>
            <span class="ticker-item">Match Accuracy <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Applications Today <em>@s.ApplicationsToday.ToString("N0")</em></span>
            <span class="ticker-item">Active Jobs <em>@s.TotalActiveJobs.ToString("N0")</em></span>
            <span class="ticker-item">Jobs Posted This Week <em>@s.JobsPostedThisWeek.ToString("N0")</em></span>
            <span class="ticker-item">Match Score <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Skills Tracked <em>@skillsDisplay</em></span>
            <span class="ticker-item">Active Students <em>@s.TotalStudents.ToString("N0")</em></span>
            <span class="ticker-item">Companies Hiring <em>@s.TotalCompanies.ToString("N0")</em></span>
            <span class="ticker-item">Match Accuracy <em>@s.MatchScorePercent%</em></span>
            <span class="ticker-item">Applications Today <em>@s.ApplicationsToday.ToString("N0")</em></span>
            <span class="ticker-item">Active Jobs <em>@s.TotalActiveJobs.ToString("N0")</em></span>
            <span class="ticker-item">Jobs Posted This Week <em>@s.JobsPostedThisWeek.ToString("N0")</em></span>
        </div>
    </div>

    <div class="hero-wrap">
        <div>
            <div class="hero-kicker au"><span class="kicker-dot"></span>Career Intelligence Platform · 2026</div>
            <h1 class="hero-h1 au1">
                <span class="grad-text">Know</span><br>
                the <span class="stroke">Gap.</span><br>
                <span class="grad-text">Close It.</span>
            </h1>
            <p class="hero-sub au2">AI-calculated skill matching between students and real opportunities. See exactly where you stand, what you're missing, and the fastest path forward.</p>
            <div class="hero-actions au3">
                <a href="/Auth/StudentAuth" class="btn btn-dark btn-lg">Student Portal →</a>
                <a href="/Auth/CompanyAuth" class="btn btn-lime btn-lg">Hire Talent →</a>
                <a href="/Auth/AdminAuth" class="btn btn-outline btn-lg">Admin</a>
            </div>
        </div>
        <div class="hero-card au2">
            <div class="hc-label">Your Top Match Today</div>
            <div class="hc-score countup" data-target="@s.MatchScorePercent">0</div>
            <div class="hc-role">% match · Software Engineer Intern</div>
            <div class="hc-mini-cards">
                <div class="hc-mini"><div class="hc-mini-val">#2</div><div class="hc-mini-lbl">Your Rank</div></div>
                <div class="hc-mini"><div class="hc-mini-val">142</div><div class="hc-mini-lbl">Applicants</div></div>
                <div class="hc-mini"><div class="hc-mini-val">6/8</div><div class="hc-mini-lbl">Skills Met</div></div>
            </div>
            <div class="hc-row"><span>Skills matched</span><span class="val">6 / 8</span></div>
            <div class="hc-row"><span>Your rank</span><span class="val">#2 of 142</span></div>
            <div class="hc-row"><span>Gap to close</span><span class="val">Docker, AWS</span></div>
            <a href="/Auth/StudentAuth" class="hc-apply" style="position:relative;overflow:hidden">
                Apply Now
                <span style="font-family:var(--f-mono);font-size:10px;letter-spacing:.06em">→</span>
                <span style="position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.18) 50%,transparent 60%);background-size:200% 100%;animation:hcShimmer 2.4s ease-in-out infinite"></span>
            </a>
            <style>@("@keyframes hcShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}")</style>
        </div>
    </div>

    <div class="stats-strip au3">
        <div class="stats-inner">
            <div class="stat-cell">
                <div class="stat-num"><span class="countup" data-target="@s.MatchScorePercent">0</span><sup>%</sup></div>
                <div class="stat-label">Match accuracy</div>
            </div>
            <div class="stat-cell">
                <div class="stat-num"><span class="countup" data-target="@s.TotalSkills">0</span><sup>+</sup></div>
                <div class="stat-label">Skills tracked</div>
            </div>
            <div class="stat-cell">
                <div class="stat-num"><span class="countup" data-target="@s.TotalStudents">0</span></div>
                <div class="stat-label">Active students</div>
            </div>
            <div class="stat-cell">
                <div class="stat-num"><span class="countup" data-target="@s.TotalCompanies">0</span></div>
                <div class="stat-label">Companies hiring</div>
            </div>
        </div>
    </div>

    <div class="portals-section au4">
        <div class="section-eye">Access</div>
        <h2 class="section-title">Three portals.<br><em class="serif-i">One platform.</em></h2>
        <div class="section-subtitle-row">
            <div class="ssr-line"></div>
            <div class="ssr-dot"></div>
            <span class="ssr-text">Choose your role to continue</span>
        </div>
        <div class="portals-grid">
            <a href="/Auth/StudentAuth" class="portal-card portal-s">
                <div class="portal-num">01 — Student</div>
                <div class="portal-icon">
                    <svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3.33 1.67 8.67 1.67 12 0v-5" /></svg>
                </div>
                <div class="portal-name">Students</div>
                <p class="portal-desc">Track your career trajectory. Discover skill gaps. Apply to matched jobs with a calculated compatibility score. Benchmark against peers in real time.</p>
                <div class="portal-cta">Enter Portal →</div>
            </a>
            <a href="/Auth/CompanyAuth" class="portal-card portal-c">
                <div class="portal-num">02 — Employer</div>
                <div class="portal-icon">
                    <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /><line x1="12" y1="12" x2="12" y2="16" /><line x1="10" y1="14" x2="14" y2="14" /></svg>
                </div>
                <div class="portal-name">Companies</div>
                <p class="portal-desc">Post positions with required skills. Receive applicants ranked by match score automatically. One-click status updates across your hiring pipeline.</p>
                <div class="portal-cta">Enter Portal →</div>
            </a>
            <a href="/Auth/AdminAuth" class="portal-card portal-a">
                <div class="portal-num">03 — Control</div>
                <div class="portal-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                </div>
                <div class="portal-name">Admin</div>
                <p class="portal-desc">Platform-wide analytics. Company approvals. Master skills library curation. Complete visibility into all activity across the entire system.</p>
                <div class="portal-cta">Enter Panel →</div>
            </a>
        </div>
    </div>

    <div class="features-dark" id="features-section">
        <div class="features-inner">
            <div class="section-eye" style="color:rgba(255,255,255,.28)">Capabilities</div>
            <h2 class="section-title" style="color:var(--paper);margin-bottom:12px">Built for <em class="serif-i">precision.</em></h2>
            <div class="section-subtitle-row" style="margin-bottom:44px">
                <div class="ssr-line" style="background:linear-gradient(to right,rgba(255,255,255,.3),transparent)"></div>
                <div class="ssr-dot" style="background:var(--lime)"></div>
                <span class="ssr-text" style="color:rgba(255,255,255,.25)">Six intelligent tools, one unified system</span>
            </div>
            <div class="features-grid">
                <div class="feature-cell">
                    <span class="feature-cell-num">01</span>
                    <div class="feature-tag">Matching</div>
                    <div class="feature-h">Auto Match Score</div>
                    <p class="feature-p">Every student–job pair gets an instant compatibility score based on skills, proficiency levels, and role requirements. No guessing.</p>
                    <div class="feature-stat">@s.MatchScorePercent% accuracy · real-time</div>
                    <div class="feature-arrow">Explore →</div>
                </div>
                <div class="feature-cell">
                    <span class="feature-cell-num">02</span>
                    <div class="feature-tag">Intelligence</div>
                    <div class="feature-h">Skill Gap View</div>
                    <p class="feature-p">See exactly which skills unlock each role — matched, partial, and missing — with curated learning resources for every gap.</p>
                    <div class="feature-stat">@skillsDisplay skills mapped</div>
                    <div class="feature-arrow">Explore →</div>
                </div>
                <div class="feature-cell">
                    <span class="feature-cell-num">03</span>
                    <div class="feature-tag">Benchmarking</div>
                    <div class="feature-h">Peer Position</div>
                    <p class="feature-p">Know your percentile among all applicants for any job. See the top score and the exact gap between you and the leader.</p>
                    <div class="feature-stat">Live · @s.TotalStudents.ToString("N0") students ranked</div>
                    <div class="feature-arrow">Explore →</div>
                </div>
                <div class="feature-cell">
                    <span class="feature-cell-num">04</span>
                    <div class="feature-tag">Roadmap</div>
                    <div class="feature-h">Career Trajectory</div>
                    <p class="feature-p">A milestone timeline of your projected career path — with smart, prioritized next steps based on your current skills and goals.</p>
                    <div class="feature-stat">Auto-generated · personalized</div>
                    <div class="feature-arrow">Explore →</div>
                </div>
                <div class="feature-cell">
                    <span class="feature-cell-num">05</span>
                    <div class="feature-tag">Analysis</div>
                    <div class="feature-h">Resume Score</div>
                    <p class="feature-p">Paste your resume and get an instant breakdown: skills alignment, completeness, keyword density, and actionable improvement tips.</p>
                    <div class="feature-stat">4 dimensions scored</div>
                    <div class="feature-arrow">Explore →</div>
                </div>
                <div class="feature-cell">
                    <span class="feature-cell-num">06</span>
                    <div class="feature-tag">AI</div>
                    <div class="feature-h">AI Advisor</div>
                    <p class="feature-p">Context-aware career chat. Ask what to learn next, how to improve for a specific role, or how to prepare for an upcoming interview.</p>
                    <div class="feature-stat">Always online · instant answers</div>
                    <div class="feature-arrow">Explore →</div>
                </div>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="footer-left">
            <div class="footer-logo-mark">Cogni<span>Career</span></div>
            <div class="footer-sep"></div>
            <div class="footer-tagline">Career Intelligence &amp; Skill Gap Platform</div>
        </div>
        <div class="footer-links">
            <a href="/" class="footer-link">Platform</a>
            <a href="/Auth/StudentAuth" class="footer-link">Students</a>
            <a href="/Auth/CompanyAuth" class="footer-link">Companies</a>
            <a href="/Auth/AdminAuth" class="footer-link">Admin</a>
        </div>
        <div class="footer-right">
            <span class="footer-meta">© 2026</span>
            <div class="footer-pill"><span class="footer-pill-dot"></span>Active</div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Count-up animation for stat numbers
        document.querySelectorAll('.countup[data-target]').forEach(el => {
        const target = parseInt(el.dataset.target) || 0;
        let current = 0;
        const step = Math.ceil(target / 60);
        const timer = setInterval(() => {
        current = Math.min(current + step, target);
        el.textContent = current;
        if (current >= target) clearInterval(timer);
        }, 18);
        });
        // Animate-in classes
        document.querySelectorAll('.au,.au1,.au2,.au3,.au4').forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
        el.style.transition = 'opacity .6s ease, transform .6s cubic-bezier(.4,0,.2,1)';
        setTimeout(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; }, 100 + i * 120);
        });
    </script>
</body>
</html>
