    <script>
        // Count-up animation for stat numbers
        document.querySelectorAll('.countup[data-target]').forEach(el => {
        const target = parseInt(el.dataset.target) || 0;
        let current = 0;
        const step = Math.ceil(target / 60);
        const timer = setInterval(() => {
        current = Math.min(current + step, target);
        el.textContent = current;
        if (current >= target) clearInterval(timer);
        }, 18);
        });
        // Animate-in classes
        document.querySelectorAll('.au,.au1,.au2,.au3,.au4').forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
        el.style.transition = 'opacity .6s ease, transform .6s cubic-bezier(.4,0,.2,1)';
        setTimeout(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; }, 100 + i * 120);
        });
    </script>
