.metric-row-label{font-size:13px;font-weight:600;color:var(--ink)}
.metric-row-val{font-family:var(--f-mono);font-size:11px;color:var(--muted)}
.metric-row-bar{height:4px;background:var(--warm);border-radius:0;overflow:hidden}
.metric-row-fill{height:100%;background:var(--lime-d);width:0;transition:width 1s cubic-bezier(.4,0,.2,1)}
.ai-feedback{margin-top:18px;padding:12px 14px;border-radius:var(--r-sm);background:var(--warm);border-left:3px solid var(--lime-d);font-size:12.5px;line-height:1.55;color:var(--ink)}
