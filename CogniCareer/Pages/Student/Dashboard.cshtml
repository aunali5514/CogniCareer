.jlb-blue{background:rgba(59,127,255,.07)}.jlb-green{background:rgba(26,122,58,.07)}.jlb-orange{background:rgba(180,100,0,.07)}.jlb-purple{background:rgba(123,94,167,.07)}.jlb-teal{background:rgba(0,180,150,.07)}.jlb-red{background:rgba(255,63,63,.07)}
