                }

            .ai-modal-body {
                padding: 22px;
                overflow-y: auto;
                line-height: 1.65;
                font-size: 14px;
                color: var(--ink)
            }

                .ai-modal-body .match-line {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    margin-bottom: 16px;
                    padding-bottom: 14px;
                    border-bottom: 1px dashed var(--line)
                }

                .ai-modal-body .match-pill {
                    font-family: var(--f-mono);
                    font-size: 11px;
                    padding: 4px 10px;
                    border-radius: 100px;
                    background: var(--ink);
                    color: var(--paper);
                    letter-spacing: .04em
                }

            .btn-explain {
                background: transparent;
                border: 1px solid var(--line);
                border-radius: 6px;
                font-family: var(--f-sans);
                font-size: 10.5px;
                font-weight: 600;
                padding: 5px 11px;
                cursor: pointer;
                color: var(--ink);
                letter-spacing: .02em;
                margin-left: 8px;
                transition: all .15s
            }

                .btn-explain:hover {
                    background: var(--ink);
                    color: var(--paper);
                    border-color: var(--ink)
                }

                .btn-explain:disabled {
                    opacity: .5;
                    cursor: wait
                }
                /* ===== PDF Upload button ===== */
.resume-head-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:14px;flex-wrap:wrap}
.upload-pdf-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px dashed var(--line);border-radius:6px;background:var(--white);font-family:var(--f-sans);font-size:11.5px;color:var(--ink);cursor:pointer;transition:all .15s;white-space:nowrap}
.upload-pdf-btn:hover{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.upload-pdf-btn.is-busy{pointer-events:none;opacity:.7}
            /* ===== Cover Letter modal ===== */
            .btn-cover {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: transparent;
                border: 1px solid var(--line);
                border-radius: 6px;
                font-family: var(--f-sans);
                font-size: 10.5px;
                font-weight: 600;
                padding: 5px 11px;
                cursor: pointer;
                color: var(--ink);
                letter-spacing: .02em;
                margin-left: 6px;
                transition: all .15s
            }

                .btn-cover:hover {
                    background: var(--lime);
                    border-color: var(--lime-d)
                }

            .cl-modal {
                max-width: 680px
            }

            .cl-tone-row {
                display: flex;
                gap: 6px;
                padding: 12px 22px;
                border-bottom: 1px solid var(--line);
                background: var(--paper);
                align-items: center;
                flex-wrap: wrap
            }

            .cl-tone-label {
                font-family: var(--f-mono);
                font-size: 9px;
                letter-spacing: .12em;
                text-transform: uppercase;
                color: var(--muted);
                margin-right: 6px
            }

            .cl-tone-btn {
                font-family: var(--f-sans);
                font-size: 11px;
                padding: 5px 11px;
                border: 1px solid var(--line);
                border-radius: 100px;
                background: var(--white);
                color: var(--ink);
                cursor: pointer;
                transition: all .15s
            }

                .cl-tone-btn:hover {
                    border-color: var(--ink)
                }

                .cl-tone-btn.is-active {
                    background: var(--ink);
                    color: var(--paper);
                    border-color: var(--ink)
                }

            .cl-body {
                padding: 22px;
                overflow-y: auto;
                font-family: 'Times New Roman',Georgia,serif;
                font-size: 13px;
                line-height: 1.65;
                color: var(--ink);
                background: var(--white);
                white-space: pre-wrap;
                min-height: 300px;
                max-height: 55vh
            }

                .cl-body.is-loading {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: var(--muted);
                    font-family: var(--f-mono);
                    font-size: 12px
                }

            .cl-actions {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 14px 22px;
                border-top: 1px solid var(--line);
                background: var(--paper);
                gap: 10px
            }

                .cl-actions .left {
                    display: flex;
                    gap: 8px
                }

                .cl-actions .right {
                    display: flex;
                    gap: 8px
                }

            .cl-copy-btn {
                font-family: var(--f-sans);
                font-size: 11px;
                font-weight: 700;
                padding: 8px 16px;
                background: var(--ink);
                color: var(--paper);
                border: none;
                border-radius: 6px;
                cursor: pointer;
                letter-spacing: .04em;
                text-transform: uppercase;
                transition: background .15s
            }

                .cl-copy-btn:hover {
                    background: var(--ink-2)
                }

                .cl-copy-btn.is-copied {
                    background: var(--lime-d)
                }

            .cl-regen-btn {
                font-family: var(--f-sans);
                font-size: 11px;
                padding: 8px 14px;
                background: var(--white);
                color: var(--ink);
                border: 1px solid var(--line);
                border-radius: 6px;
                cursor: pointer;
                letter-spacing: .04em
            }

                .cl-regen-btn:hover {
                    border-color: var(--ink)
                }

                .cl-regen-btn:disabled {
                    opacity: .5;
                    cursor: wait
                }
/* ===== END NEW AI styles ===== */
.dash-menu-btn{display:none;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:none;border-radius:var(--r-sm);background:var(--ink);color:var(--paper);cursor:pointer;flex-direction:column;gap:5px;flex-shrink:0}
.dash-menu-btn span{display:block;width:18px;height:2px;background:currentColor;border-radius:1px}
.dash-drawer-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:85}
.dash-drawer-overlay.is-visible{display:block}
.table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
@@media(max-width:900px){
  .dash-menu-btn{display:flex;position:fixed;top:10px;left:10px;z-index:95}
  .dash-sidebar{width:280px;left:-280px;transition:none}
  .dash-sidebar.is-open{left:0;z-index:90;box-shadow:var(--shadow-lg)}
  .dash-main{margin-left:0}
  .dash-topbar{padding:0 16px 0 56px}
  .dash-content,.dash-body{padding:24px 16px}
  .two-col,.field-row,.gap-visual-section{grid-template-columns:1fr;display:block}
  .gap-visual-section{display:flex;flex-direction:column}
  .gap-col-have{border-right:none;border-bottom:1px solid var(--line)}
  .metric-strip,.peer-bench{grid-template-columns:repeat(2,1fr)}
  .app-stat-cards{grid-template-columns:repeat(2,1fr)}
  .wb-banner{padding:22px 20px}
  .wb-stats{width:100%;justify-content:space-between}
  .profile-hero-inner{flex-direction:column;align-items:flex-start;padding:22px 20px}
  .score-head{flex-direction:column;align-items:flex-start}
}
@@media(prefers-reduced-motion:no-preference){
  @@media(max-width:900px){
    .dash-sidebar{transition:left .25s ease}
  }
}
@@media(max-width:640px){
  .dash-topbar{padding:0 12px 0 52px;height:50px}
  .dash-topbar-title{font-size:17px}
  .topbar-date{display:none!important}
  .dash-content,.dash-body{padding:16px 12px}
  .metric-strip,.peer-bench,.app-stat-cards{grid-template-columns:1fr}
  .metric-cell,.peer-cell{border-right:none!important}
  .card{margin-left:auto;margin-right:auto;max-width:calc(100% - 0px)}
  .card-head{padding:12px 14px}
  .card-body{padding:14px}
  .wb-banner{padding:18px 16px;margin-bottom:16px}
  .wb-stat-val{font-size:18px}
  .job-row-wow{flex-wrap:wrap;align-items:flex-start;padding:14px 16px}
  .job-row-wow .job-logo-bubble{order:1}
  .job-row-wow>div[style*="flex:1"]{order:2;flex:1 1 calc(100% - 58px);min-width:0}
  .job-row-wow>div[style*="flex:1"] form,.job-row-wow>div[style*="flex:1"] .btn-explain,.job-row-wow>div[style*="flex:1"] .btn-cover,.job-row-wow>div[style*="flex:1"]>.badge,.job-row-wow>div[style*="flex:1"] .btn{margin-top:8px;margin-left:0!important;margin-right:6px}
  .job-row-wow .match-ring-wow{order:3;flex:0 0 100%;width:100%;margin-top:10px;justify-content:flex-start;padding-left:58px;box-sizing:border-box}
  .chat-msg{max-width:88%}
  .chat-send{padding:0 18px;font-size:10px;min-height:44px}
  .quick-row{flex-wrap:wrap}
  .quick-btn{min-height:44px}
  .field-input,.field-select,.field-textarea{min-height:44px}
  .btn,.sb-link{min-height:44px}
  .sb-link{align-items:center}
  .prof-btn{min-height:44px;padding:8px 14px}
  .ai-modal{width:calc(100vw - 24px)!important;max-width:560px;max-height:90vh}
  .ai-modal-head,.ai-modal-body,.cl-body,.cl-tone-row,.cl-actions{padding-left:16px;padding-right:16px}
  .ai-modal-body,.cl-body{max-height:55vh}
  .score-head{gap:16px}
  .toast{left:12px;right:12px;bottom:16px;max-width:none}
  .data-table{min-width:600px}
}
@@media(max-width:380px){
  .dash-topbar-title{font-size:15px}
  .hc-score{font-size:22px}
}
</style>
</head>
<body>
<div id="toast" class="toast"><div class="toast-dot"></div><span id="toast-msg"></span></div>
    <!-- ===== Explain Match modal (used by Browse Jobs) ===== -->
    <div class="ai-modal-overlay" id="explain-modal" onclick="if(event.target===this)closeExplainModal()">
        <div class="ai-modal">
            <div class="ai-modal-head">
                <div>
                    <div class="ai-modal-title" id="em-title">Why this match?</div>
                    <div class="ai-modal-sub" id="em-sub">AI-generated breakdown</div>
                </div>
                <button class="ai-modal-close" onclick="closeExplainModal()">×</button>
            </div>
            <div class="ai-modal-body">
                <div class="match-line" id="em-match-line" style="display:none">
                    <span class="match-pill" id="em-pill">— %</span>
                    <span style="font-size:12px;color:var(--muted);font-family:var(--f-mono)">match score</span>
                </div>
                <div id="em-text"><span class="ai-spinner"></span>&nbsp; Asking AI...</div>
            </div>
        </div>
    </div>
    <!-- ===== Cover Letter modal ===== -->
    <div class="ai-modal-overlay" id="cover-modal" onclick="if(event.target===this)closeCoverModal()">
        <div class="ai-modal cl-modal">
            <div class="ai-modal-head">
                <div>
                    <div class="ai-modal-title" id="cl-title">Cover Letter</div>
                    <div class="ai-modal-sub" id="cl-sub">AI-generated · personalized to your profile</div>
                </div>
                <button class="ai-modal-close" onclick="closeCoverModal()">×</button>
            </div>
            <div class="cl-tone-row">
                <span class="cl-tone-label">Tone:</span>
                <button class="cl-tone-btn is-active" data-tone="professional" onclick="setCoverTone(this)">Professional</button>
                <button class="cl-tone-btn" data-tone="enthusiastic" onclick="setCoverTone(this)">Enthusiastic</button>
                <button class="cl-tone-btn" data-tone="concise" onclick="setCoverTone(this)">Concise</button>
            </div>
            <div class="cl-body is-loading" id="cl-body"><span class="ai-spinner"></span>&nbsp; Writing your cover letter...</div>
            <div class="cl-actions">
                <div class="left">
                    <button class="cl-regen-btn" id="cl-regen" onclick="regenerateCoverLetter()" disabled>↻ Regenerate</button>
                </div>
                <div class="right">
                    <button class="cl-copy-btn" id="cl-copy" onclick="copyCoverLetter()" disabled>Copy to clipboard</button>
                </div>
            </div>
        </div>
    </div>
<div class="dash-shell">
  <button type="button" class="dash-menu-btn" id="dash-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="dash-sidebar"><span></span><span></span><span></span></button>
  <div class="dash-drawer-overlay" id="dash-drawer-overlay" aria-hidden="true"></div>
  <!-- Sidebar -->
  <aside class="dash-sidebar" id="dash-sidebar">
    <div class="sidebar-logo" onclick="window.location.href='/'">Cogni<span>Career</span></div>
    <div class="sb-section">Main</div>
    <a class="sb-link on" id="lnk-overview" onclick="sw('sp-overview','Overview')">
      <span class="sb-ico">⬡</span>Overview
    </a>
    <a class="sb-link" id="lnk-browse" onclick="sw('sp-browse','Browse Jobs')">
      <span class="sb-ico">◈</span>Browse Jobs
    </a>
    <a class="sb-link" id="lnk-apps" onclick="sw('sp-apps','My Applications')">
      <span class="sb-ico">◫</span>Applications
    </a>
    <a class="sb-link" id="lnk-skills" onclick="sw('sp-skills','My Skills')">
      <span class="sb-ico">◇</span>My Skills
    </a>
    <div class="sb-section">Intelligence</div>
    <a class="sb-link" id="lnk-gap" onclick="sw('sp-gap','Skill Gap Analysis')"><span class="sb-ico">△</span>Skill Gap</a>
<a class="sb-link" id="lnk-resume" onclick="sw('sp-resume','Resume Score')"><span class="sb-ico">▤</span>Resume Score</a>
<a class="sb-link" id="lnk-advisor" onclick="sw('sp-advisor','AI Advisor')"><span class="sb-ico">◎</span>AI Advisor</a>
    <div class="sb-section">Account</div>
    <a class="sb-link" id="lnk-alerts" onclick="sw('sp-alerts','Alerts')"><span class="sb-ico">◉</span>Alerts @if (Model.UnreadAlerts > 0) { <span class="sb-badge">@Model.UnreadAlerts</span> }</a>
    <a class="sb-link" id="lnk-profile" onclick="sw('sp-profile','My Profile')"><span class="sb-ico">◌</span>Profile</a>
    <div class="sb-foot">
      <div class="sb-user">
        <div class="sb-avatar av-student">@Model.Initials</div>
        <div>
          <div class="sb-uname">@Model.UserName</div>
          <div class="sb-urole">Student</div>
        </div>
      </div>
      <form method="post" asp-page-handler="Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="sb-signout">Sign Out</button>
      </form>
    </div>
  </aside>

  <!-- Main -->
  <div class="dash-main">
    <div class="dash-topbar">
      <div class="dash-topbar-title" id="page-title">Overview</div>
      <div style="display:flex;align-items:center;gap:10px">
        @if(!Model.ProfileComplete)
        {
          <span class="badge badge-red" style="font-size:9px">Profile Incomplete</span>
        }
        <span class="badge badge-default topbar-date">@DateTime.Now.ToString("MMM dd, yyyy")</span>
      </div>
    </div>
    <div class="dash-content">

      <!-- ── OVERVIEW ── -->
      <div class="panel active" id="sp-overview">
        <!-- Change 2: v5 light welcome banner layout; same data sources as before -->
        <div class="wb-banner au">
          <div style="position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
            <div>
              <div class="wb-greeting">Welcome Back</div>
              @{
                var nameParts = Model.UserName.Split(' ');
                var firstName = nameParts.Length > 0 ? nameParts[0] : Model.UserName;
                var lastName = nameParts.Length > 1 ? string.Join(" ", nameParts.Skip(1)) : "";
                var uni = Model.Profile?.University ?? "University";
                var sem = Model.Profile?.Semester ?? 0;
                var deg = Model.Profile?.Degree ?? "Degree";
                var gpa = Model.Profile?.GPA ?? 0;
              }
              <div class="wb-name">@firstName <em>@lastName</em>@(string.IsNullOrEmpty(lastName) ? "" : "") — @uni</div>
              <div class="wb-meta">@(sem > 0 ? $"Semester {sem}" : "—") · @(string.IsNullOrEmpty(deg) ? "—" : deg) · GPA @(gpa > 0 ? gpa.ToString("F1") : "—")</div>
            </div>
            <div class="wb-stats">
              <div class="wb-stat wb-stat-match">
                <div class="wb-stat-val">@Model.AvgMatchScore%</div>
                <div class="wb-stat-lbl">Top Match</div>
              </div>
              <div class="wb-stat wb-stat-rank">
                <div class="wb-stat-val">#@(Model.TopBenchmark.TotalApplicants > 0 ? Math.Round(Model.TopBenchmark.Percentile) : 0)</div>
                <div class="wb-stat-lbl">Your Rank</div>
              </div>
              <div class="wb-stat wb-stat-applied">
                <div class="wb-stat-val countup" data-target="@Model.TotalApplications">0</div>
                <div class="wb-stat-lbl">Applied</div>
              </div>
              <div class="wb-stat wb-stat-profile">
                <div class="wb-stat-val">@(Model.ProfileComplete ? "100%" : "~50%")</div>
                <div class="wb-stat-lbl">Profile Done</div>
              </div>
            </div>
          </div>
        </div>

        @if (!Model.ProfileComplete)
        {
          <div class="notice notice-warn">⚠ Complete your profile to start applying for jobs. <a onclick="sw('sp-profile','My Profile')" style="cursor:pointer;text-decoration:underline">Set up profile →</a></div>
        }

        <!-- Change 3: v5 four-card KPI layout matching screenshot 5 exactly -->
        <div class="metric-strip v5-kpi au">
          <div class="metric-cell mc-ink">
            <div class="m-label">Top Match Score</div>
            <div class="m-value countup" data-target="@Model.AvgMatchScore">0</div>
            <div class="m-sub">@(Model.TopMatchedJobs.Any() ? Model.TopMatchedJobs.First().Job.CompanyName + " · " + Model.TopMatchedJobs.First().Job.Title : "Avg across applications")</div>
            <div class="m-delta">↑ Active this month</div>
          </div>
          <div class="metric-cell mc-lime">
            <div class="m-label">Your Rank</div>
            <div class="m-value">#@(Model.TopBenchmark.TotalApplicants > 0 ? (int)Math.Round(Model.TopBenchmark.Percentile) : 0)</div>
            <div class="m-sub">of @Model.TopBenchmark.TotalApplicants applicants</div>
            <div class="m-delta">↑ Top score: @Model.TopBenchmark.TopScore%</div>
          </div>
          <div class="metric-cell mc-muted">
            <div class="m-label">Skills Matched</div>
            <div class="m-value countup" data-target="@Model.TotalSkills">0</div>
            <div class="m-sub">skills in your profile</div>
            <div class="m-delta" style="color:var(--muted)">Gap analysis available</div>
          </div>
          <div class="metric-cell mc-blue">
            <div class="m-label">Applications</div>
            <div class="m-value countup" data-target="@Model.TotalApplications">0</div>
            <div class="m-sub">Active this month</div>
            <div class="m-delta">@Model.ShortlistedCount shortlisted</div>
          </div>
        </div>

        <div class="two-col">
          <div class="card">
            <div class="card-head"><span class="card-title">Recent Applications</span><a onclick="sw('sp-apps','My Applications')" style="cursor:pointer" class="btn btn-ghost btn-sm">View All →</a></div>
            <div class="card-body-p0">
              @if (!Model.RecentApplications.Any())
              {
                <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">No applications yet. <a onclick="sw('sp-browse','Browse Jobs')" style="color:var(--ink);text-decoration:underline;cursor:pointer">Browse jobs →</a></div>
              }
              @foreach (var app in Model.RecentApplications)
              {
                var scoreColor = app.MatchScore >= 80 ? "#1a7a3a" : app.MatchScore >= 60 ? "#b46400" : "var(--red)";
                <div class="job-row-wow">
                  <div class="job-logo-bubble jlb-blue">🏢</div>
                  <div style="flex:1;min-width:0">
                    <div style="font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@app.JobTitle</div>
                    <div style="font-family:var(--f-mono);font-size:9.5px;color:var(--muted)">@app.CompanyName · @app.AppliedAt.ToString("MMM dd")</div>
                  </div>
                  <span class="status @CogniCareer.Helpers.SessionHelper.GetStatusClass(app.CurrentStatus)">@app.CurrentStatus</span>
                  <div style="font-family:var(--f-serif);font-size:14px;font-weight:900;color:@scoreColor;min-width:36px;text-align:right">@app.MatchScore%</div>
                </div>
              }
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Top Matched Jobs</span><a onclick="sw('sp-browse','Browse Jobs')" style="cursor:pointer" class="btn btn-dark btn-sm">Browse All →</a></div>
            <div class="card-body-p0">
              @if (!Model.TopMatchedJobs.Any())
              {
                <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">Complete your profile and add skills to see matches.</div>
              }
              @foreach (var jm in Model.TopMatchedJobs.Take(5))
              {
                var scoreColor = jm.MatchScore >= 80 ? "#1a7a3a" : jm.MatchScore >= 60 ? "#b46400" : "var(--red)";
                <div class="job-row-wow">
                  <div class="job-logo-bubble jlb-green">💼</div>
                  <div style="flex:1;min-width:0">
                    <div style="font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@jm.Job.Title</div>
                    <div style="font-family:var(--f-mono);font-size:9.5px;color:var(--muted)">@jm.Job.CompanyName · @jm.Job.JobType · Due @jm.Job.Deadline.ToString("MMM dd")</div>
                  </div>
                  <div style="font-family:var(--f-serif);font-size:16px;font-weight:900;color:@scoreColor">@jm.MatchScore%</div>
                </div>
              }
            </div>
          </div>
        </div>
      </div>

      <!-- ── BROWSE JOBS ── v5 layout with search bar, type+sort dropdowns, skill chips, aligned ring/action column -->
      <div class="panel" id="sp-browse">
        <!-- Search bar + filter dropdowns -->
        <div class="browse-search-bar">
          <div class="browse-search-input-wrap">
            <svg class="browse-search-icon" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input id="browse-search" class="browse-search-input" type="text" placeholder="Search jobs, skills, companies..." oninput="browseFilter()">
          </div>
          <select id="browse-type" class="browse-filter-select" onchange="browseFilter()">
            <option value="">All Types</option>
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Remote">Remote</option>
            <option value="Internship">Internship</option>
          </select>
          <select id="browse-sort" class="browse-filter-select" onchange="browseSort()">
            <option value="match">Best Match</option>
            <option value="deadline">Deadline</option>
            <option value="newest">Newest</option>
          </select>
        </div>
        <div class="v5-jobs-header">
          <span class="v5-jobs-count" id="browse-count">@Model.AllJobs.Count JOBS FOUND</span>
          <span class="badge badge-default" id="browse-filter-chip" style="display:none">BEST MATCH ×</span>
        </div>
        <div class="card">
          <div class="card-body-p0">
            @{
              var _jobSkillData = new CogniCareer.Data.JobSkillData();
              // Icon tiles cycle through 6 variants
              string[] _tileClasses = {"jlb-blue","jlb-green","jlb-amber","jlb-purple","jlb-red","jlb-teal"};
              string[] _tileIcons   = {"🚀","💡","📱","🔬","⚡","🔧"};
              int _rowIdx = 0;
            }
            @if (!Model.AllJobs.Any())
            {
              <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">No active jobs available right now.</div>
            }
            @foreach (var jm in Model.AllJobs)
            {
              var sc = jm.MatchScore;
              var ringClass = sc >= 80 ? "ring-fill-high" : sc >= 60 ? "ring-fill-mid" : "ring-fill-low";
              var pctClass  = sc >= 80 ? "ring-pct-high"  : sc >= 60 ? "ring-pct-mid"  : "ring-pct-low";
              var offset    = Math.Round(145 - (sc / 100m * 145), 1);
              var alreadyApplied = Model.AppliedJobIds.Contains(jm.Job.JobID);
              var tileClass = _tileClasses[_rowIdx % 6];
              var tileIcon  = _tileIcons[_rowIdx % 6];
              var jobSkills = _jobSkillData.GetByJobID(jm.Job.JobID);
              _rowIdx++;
              <div class="job-row-wow">
                <!-- Company icon tile -->
                <div class="job-logo-bubble @tileClass" style="flex-shrink:0;font-size:18px">@tileIcon</div>
                <!-- Info column -->
                <div style="flex:1;min-width:0">
                  <div class="job-co">@jm.Job.CompanyName &middot; @jm.Job.JobType &middot; Deadline @jm.Job.Deadline.ToString("MMMM dd").ToUpper()</div>
                  <div class="job-title">@jm.Job.Title</div>
                  <!-- Skill chips with colored dots -->
                  <div class="job-tags" style="margin-top:7px;display:flex;flex-wrap:wrap;gap:5px">
                    @{int _ci = 0;}
                    @foreach (var sk in jobSkills.Take(4))
                    {
                      <span class="skill-chip scc-@(_ci % 6)"><span class="sc-dot"></span>@sk.SkillName</span>
                      _ci++;
                    }
                    @if (!jobSkills.Any())
                    {
                      <span class="skill-chip scc-0"><span class="sc-dot"></span>@jm.Job.JobType</span>
                    }
                  </div>
                </div>
                <!-- Right: ring column (fixed width) + action column (fixed width) — aligned vertically -->
                <div class="job-right-col">
                  <div class="match-ring-wow">
                    <svg viewBox="0 0 58 58"><circle class="ring-track" cx="29" cy="29" r="23" stroke-dasharray="145" stroke-dashoffset="0"/><circle class="@ringClass" cx="29" cy="29" r="23" stroke-dasharray="145" stroke-dashoffset="@offset"/></svg>
                    <span class="ring-pct @pctClass">@sc%</span>
                  </div>
                  <div class="job-action-col">
                    @if (alreadyApplied)
                    {
                      <span class="badge badge-dark job-action-btn">&#10003; Applied</span>
                      <button type="button" class="btn-explain job-action-btn" onclick="explainMatch(@jm.Job.JobID)">✨ Why?</button>
                      <button type="button" class="btn-cover job-action-btn" onclick="generateCoverLetter(@jm.Job.JobID, '@jm.Job.Title.Replace("'", "\'")', '@jm.Job.CompanyName.Replace("'", "\'")')">&#128221; Cover</button>
                    }
                    else if (jm.Job.Deadline < DateTime.Now)
                    {
                      <span class="badge badge-red job-action-btn">Closed</span>
                    }
                    else
                    {
                      <form method="post" asp-page-handler="Apply" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@jm.Job.JobID">
                        <input type="hidden" name="matchScore" value="@jm.MatchScore">
                        <button type="submit" class="btn btn-dark btn-sm job-action-btn">Apply →</button>
                      </form>
                      <button type="button" class="btn-explain job-action-btn" onclick="explainMatch(@jm.Job.JobID)">✨ Why?</button>
                      <button type="button" class="btn-cover job-action-btn" onclick="generateCoverLetter(@jm.Job.JobID, '@jm.Job.Title.Replace("'", "\'")', '@jm.Job.CompanyName.Replace("'", "\'")')">&#128221; Cover</button>
                    }
                  </div>
                </div>
              </div>
            }
          </div>
        </div>
      </div>

      <!-- ── MY APPLICATIONS ── v5 layout matching screenshot 4 -->
      <div class="panel" id="sp-apps">
        @{
          var _appsAll      = Model.Applications;
          var _appsTotal    = _appsAll.Count();
          var _appsPending  = _appsAll.Count(a => a.CurrentStatus == "Applied" || a.CurrentStatus == "Pending");
          var _appsShort    = _appsAll.Count(a => a.CurrentStatus == "Shortlisted");
          var _appsInter    = _appsAll.Count(a => a.CurrentStatus == "Interview");
          var _appsReject   = _appsAll.Count(a => a.CurrentStatus == "Rejected" || a.CurrentStatus == "Not Selected");
        }
        <div class="app-stat-cards">
          <div class="app-stat-card asc-total">
            <div class="app-stat-icon asi-total"><i class="devicon-googlecloud-plain" style="font-size:15px;color:var(--ink)"></i></div>
            <div class="app-stat-num">@_appsTotal</div>
            <div class="app-stat-lbl">Total Applied</div>
          </div>
          <div class="app-stat-card asc-pending">
            <div class="app-stat-icon asi-pending"><i class="devicon-trello-plain" style="font-size:15px;color:#b46400"></i></div>
            <div class="app-stat-num" style="color:#b46400">@_appsPending</div>
            <div class="app-stat-lbl">Pending</div>
          </div>
          <div class="app-stat-card asc-short">
            <div class="app-stat-icon asi-short"><i class="devicon-jetbrains-plain" style="font-size:15px;color:var(--lime-d)"></i></div>
            <div class="app-stat-num" style="color:var(--lime-d)">@_appsShort</div>
            <div class="app-stat-lbl">Shortlisted</div>
          </div>
          <div class="app-stat-card asc-inter">
            <div class="app-stat-icon asi-inter"><i class="devicon-slack-plain" style="font-size:15px;color:var(--blue)"></i></div>
            <div class="app-stat-num" style="color:var(--blue)">@_appsInter</div>
            <div class="app-stat-lbl">Interview</div>
          </div>
          <div class="app-stat-card asc-reject">
            <div class="app-stat-icon asi-reject"><i class="devicon-jira-plain" style="font-size:15px;color:var(--red)"></i></div>
            <div class="app-stat-num" style="color:var(--red)">@_appsReject</div>
            <div class="app-stat-lbl">Not Selected</div>
          </div>
        </div>
        <div class="card">
          <div class="card-head" style="border-bottom:1px solid var(--line);padding:18px 24px">
            <span class="card-title" style="font-family:var(--f-serif);font-size:18px;font-weight:700;letter-spacing:-.03em">My Applications</span>
            <span class="badge badge-default">@Model.TotalApplications TOTAL</span>
          </div>
          <div class="card-body-p0">
            @if (!Model.Applications.Any())
            {
              <div style="padding:36px;text-align:center;color:var(--muted);font-size:13px">You haven't applied to any jobs yet. <a onclick="sw('sp-browse','Browse Jobs')" style="color:var(--ink);text-decoration:underline;cursor:pointer">Browse jobs →</a></div>
            }
            @{
              var _appJobSkillData = new CogniCareer.Data.JobSkillData();
              string[] _appTileClasses = {"jlb-blue","jlb-green","jlb-amber","jlb-purple","jlb-red","jlb-teal"};
              string[] _appTileIcons   = {"🚀","💡","📱","🔬","⚡","🔧"};
              int _appIdx = 0;
            }
            @foreach (var app in Model.Applications)
            {
              var sc = app.MatchScore;
              var scoreColor = sc >= 80 ? "#1a7a3a" : sc >= 60 ? "#b46400" : "var(--red)";
              var offset = Math.Round(113 - (sc / 100m * 113), 1);
              var stClass = CogniCareer.Helpers.SessionHelper.GetStatusClass(app.CurrentStatus);
              var appTile = _appTileClasses[_appIdx % 6];
              var appIcon = _appTileIcons[_appIdx % 6];
              var appJobSkills = _appJobSkillData.GetByJobID(app.JobID);
              // Find matching job for type/location from AllJobs
              var matchedJob = Model.AllJobs.FirstOrDefault(j => j.Job.JobID == app.JobID)?.Job;
              var jobType = matchedJob?.JobType ?? "Full-time";
              _appIdx++;
              <div class="v5-app-row">
                <!-- Left accent bar (status color) -->
                <div class="v5-app-accent @stClass"></div>
                <!-- Icon tile -->
                <div class="job-logo-bubble @appTile" style="flex-shrink:0;margin:14px 14px 0 16px;width:40px;height:40px;font-size:18px;line-height:1;align-self:flex-start">@appIcon</div>
                <!-- Body -->
                <div style="flex:1;min-width:0;padding:16px 0">
                  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
                    <div>
                      <div class="v5-app-title">@app.JobTitle</div>
                      <div class="v5-app-meta">@app.CompanyName &nbsp;·&nbsp; @jobType &nbsp;·&nbsp; Applied @app.AppliedAt.ToString("MMM d")</div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0">
                      <span class="status @stClass" style="display:flex;align-items:center;gap:5px"><span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block"></span>@app.CurrentStatus</span>
                      <button type="button" class="btn-notes" onclick="openNotes(@app.ApplicationID)">NOTES</button>
                    </div>
                  </div>
                  <!-- Skill chips -->
                  <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;margin-bottom:10px">
                    @{int _aci=0;}
                    @foreach(var sk in appJobSkills.Take(3))
                    {
                      <span class="skill-chip scc-@(_aci%6)"><span class="sc-dot"></span>@sk.SkillName</span>
                      _aci++;
                    }
                  </div>
                  <!-- Match bar + ring -->
                  <div class="v5-app-bar-row">
                    <span class="acr-bar-label">MATCH</span>
                    <div class="acr-bar-track" style="flex:1"><div class="acr-bar-fill" style="background:@scoreColor;width:@sc%"></div></div>
                    <span class="acr-bar-pct" style="color:@scoreColor;font-weight:700">@sc%</span>
                    <div class="acr-ring" style="position:relative;width:36px;height:36px">
                      <svg viewBox="0 0 44 44" style="width:36px;height:36px;transform:rotate(-90deg)">
                        <circle cx="22" cy="22" r="18" fill="none" stroke="var(--warm)" stroke-width="3"/>
                        <circle cx="22" cy="22" r="18" fill="none" stroke="@scoreColor" stroke-width="3" stroke-dasharray="113" stroke-dashoffset="@offset" stroke-linecap="round"/>
                      </svg>
                      <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:8px;font-weight:700;color:@scoreColor">@sc%</span>
                    </div>
                  </div>
                </div>
              </div>
            }
          </div>
        </div>
      </div>

      <!-- ── MY SKILLS ── -->
      <div class="panel" id="sp-skills">
        @{
          System.Func<string,string> _devIcon = (string name) => {
            if (string.IsNullOrEmpty(name)) return "devicon-devicon-plain";
            var n = name.ToLower().Replace(".", "").Replace(" ", "").Replace("-", "").Replace("js","javascript");
            var map = new System.Collections.Generic.Dictionary<string,string>{
              {"react","devicon-react-original colored"},
              {"reactjavascript","devicon-react-original colored"},
              {"vue","devicon-vuejs-plain colored"},
              {"vuejavascript","devicon-vuejs-plain colored"},
              {"angular","devicon-angularjs-plain colored"},
              {"javascript","devicon-javascript-plain colored"},
              {"typescript","devicon-typescript-plain colored"},
              {"python","devicon-python-plain colored"},
              {"java","devicon-java-plain colored"},
              {"csharp","devicon-csharp-plain colored"},
              {"cplusplus","devicon-cplusplus-plain colored"},
              {"c","devicon-c-plain colored"},
              {"go","devicon-go-original-wordmark colored"},
              {"rust","devicon-rust-plain"},
              {"php","devicon-php-plain colored"},
              {"ruby","devicon-ruby-plain colored"},
              {"swift","devicon-swift-plain colored"},
              {"kotlin","devicon-kotlin-plain colored"},
              {"dart","devicon-dart-plain colored"},
              {"flutter","devicon-flutter-plain colored"},
              {"nodejavascript","devicon-nodejs-plain colored"},
              {"node","devicon-nodejs-plain colored"},
              {"express","devicon-express-original"},
              {"nextjavascript","devicon-nextjs-plain"},
              {"next","devicon-nextjs-plain"},
              {"nuxt","devicon-nuxtjs-plain colored"},
              {"django","devicon-django-plain colored"},
              {"flask","devicon-flask-original"},
              {"spring","devicon-spring-plain colored"},
              {"laravel","devicon-laravel-plain colored"},
              {"rails","devicon-rails-plain colored"},
              {"html","devicon-html5-plain colored"},
              {"html5","devicon-html5-plain colored"},
              {"css","devicon-css3-plain colored"},
              {"css3","devicon-css3-plain colored"},
              {"sass","devicon-sass-original colored"},
              {"tailwind","devicon-tailwindcss-plain colored"},
              {"tailwindcss","devicon-tailwindcss-plain colored"},
              {"bootstrap","devicon-bootstrap-plain colored"},
              {"sql","devicon-mysql-plain colored"},
              {"mysql","devicon-mysql-plain colored"},
              {"postgresql","devicon-postgresql-plain colored"},
              {"postgres","devicon-postgresql-plain colored"},
              {"mongodb","devicon-mongodb-plain colored"},
              {"redis","devicon-redis-plain colored"},
              {"sqlite","devicon-sqlite-plain colored"},
              {"firebase","devicon-firebase-plain colored"},
              {"supabase","devicon-supabase-plain colored"},
              {"git","devicon-git-plain colored"},
              {"github","devicon-github-original"},
              {"gitlab","devicon-gitlab-plain colored"},
              {"docker","devicon-docker-plain colored"},
              {"kubernetes","devicon-kubernetes-plain colored"},
              {"aws","devicon-amazonwebservices-plain-wordmark colored"},
              {"amazonwebservices","devicon-amazonwebservices-plain-wordmark colored"},
              {"azure","devicon-azure-plain colored"},
              {"googlecloud","devicon-googlecloud-plain colored"},
              {"linux","devicon-linux-plain colored"},
              {"bash","devicon-bash-plain"},
              {"figma","devicon-figma-plain colored"},
              {"photoshop","devicon-photoshop-plain colored"},
              {"illustrator","devicon-illustrator-plain colored"},
              {"graphql","devicon-graphql-plain colored"},
              {"redux","devicon-redux-original colored"},
              {"webpack","devicon-webpack-plain colored"},
              {"vite","devicon-vitejs-plain colored"},
              {"jest","devicon-jest-plain colored"},
              {"nginx","devicon-nginx-original colored"},
              {"unity","devicon-unity-original"},
              {"unreal","devicon-unrealengine-original"}
            };
            return map.ContainsKey(n) ? map[n] : "devicon-devicon-plain";
          };
        }
        <div class="two-col">
          <div class="card">
            <div class="card-head"><span class="card-title">My Skills</span><button class="btn btn-dark btn-sm" onclick="toggleSkillAdd()">+ Add Skill</button></div>
            <div class="card-body">
              <div id="skill-add-area" style="display:none;margin-bottom:20px;padding:14px;border:1px solid var(--line);border-radius:var(--r);background:var(--paper)">
                <form method="post" asp-page-handler="AddSkill">
                  @Html.AntiForgeryToken()
                  <div class="skill-dd-wrap" style="margin-bottom:10px">
                    <input class="field-input" id="skill-q" name="skillSearch" placeholder="Search skill (e.g. Docker, React...)" oninput="searchSkills(this.value)" onblur="setTimeout(closeSkillDD,200)" autocomplete="off">
                    <input type="hidden" name="skillId" id="skill-id-input">
                    <div class="skill-dd" id="skill-dd"></div>
                  </div>
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
                    <span style="font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)">Level:</span>
                    <div class="prof-row" id="prof-row">
                      <button type="button" class="prof-btn" onclick="setProf(this,'Beginner')">Beginner</button>
                      <button type="button" class="prof-btn" onclick="setProf(this,'Intermediate')">Intermediate</button>
                      <button type="button" class="prof-btn" onclick="setProf(this,'Advanced')">Advanced</button>
                    </div>
                    <input type="hidden" name="proficiency" id="prof-input" value="Intermediate">
                  </div>
                  <button type="submit" class="btn btn-dark btn-sm btn-w">Add to Profile</button>
                </form>
              </div>
              @if (!Model.StudentSkills.Any())
                {
                  <div style="text-align:center;color:var(--muted);font-size:13px;padding:20px">No skills added yet. Add your first skill above.</div>
                }
                @foreach (var sk in Model.StudentSkills)
                {
                  var pct = sk.ProficiencyLevel == "Advanced" ? 90 : sk.ProficiencyLevel == "Intermediate" ? 60 : 35;
                  var fillClass = sk.ProficiencyLevel == "Advanced" ? "scif-adv" : sk.ProficiencyLevel == "Intermediate" ? "scif-int" : "scif-beg";
                  var badgeClass = sk.ProficiencyLevel == "Advanced" ? "badge-lime" : "badge-default";
                  <div class="skill-card-item">
                    <div class="sci-icon" style="background:var(--warm)"><i class="@_devIcon(sk.SkillName)" style="font-size:20px"></i></div>
                    <div class="sci-body">
                      <div class="sci-name">@sk.SkillName</div>
                      <div class="sci-bar-row">
                        <div class="sci-track"><div class="sci-fill @fillClass" style="width:@pct%"></div></div>
                        <span class="sci-pct">@pct%</span>
                        <span class="badge @badgeClass" style="font-size:9px">@sk.ProficiencyLevel</span>
                        <form method="post" asp-page-handler="DeleteSkill" style="display:inline;margin-left:6px">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="studentSkillId" value="@sk.StudentSkillID">
                          <button type="submit" class="btn btn-ghost btn-sm" style="padding:3px 8px;color:var(--red)">✕</button>
                        </form>
                      </div>
                    </div>
                  </div>
                }
              
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Market Demand</span></div>
            <div class="card-body">
              <p style="font-size:12px;color:var(--muted);margin-bottom:18px;font-weight:300">How often your skills appear in active job postings</p>
              @if (!Model.StudentSkills.Any())
              {
                <div style="text-align:center;color:var(--muted);font-size:13px">Add skills to see demand data.</div>
              }
              @{ int rankIdx = 1; }
              @foreach (var sk in Model.StudentSkills.Take(6))
              {
                var demandPct = Math.Max(20, Math.Min(95, 88 - (rankIdx - 1) * 10));
                var demandClass = rankIdx == 1 ? "pf-ink" : rankIdx == 2 ? "pf-lime" : "pf-muted";
                <div class="demand-bar-item">
                  <span class="dbi-rank">#@rankIdx</span>
                  <span class="dbi-name"><i class="@_devIcon(sk.SkillName)" style="font-size:14px;margin-right:6px;vertical-align:-2px"></i>@sk.SkillName</span>
                  <div class="dbi-track"><div class="dbi-fill @demandClass" style="width:@demandPct%"></div></div>
                  <span class="dbi-pct">@demandPct%</span>
                </div>
                rankIdx++;
              }
            </div>
          </div>
        </div>
      </div>

      <!-- ── SKILL GAP ── -->
      <div class="panel" id="sp-gap">
        @if (!Model.Applications.Any())
        {
          <div class="notice notice-info">Apply to a job first to see your skill gap analysis for that role.</div>
        }
        else
        {
          var topApp = Model.Applications.OrderByDescending(a => a.MatchScore).First();
          var gap = Model.TopGap;
          <div class="card" style="margin-bottom:20px">
            <div class="card-head">
              <span class="card-title">Skill Gap — @topApp.JobTitle  @topApp.CompanyName</span>
              <span class="badge badge-dark">@topApp.MatchScore% Match</span>
            </div>
            <div class="card-body">
              <div class="gap-visual-section">
                <div class="gap-col gap-col-have">
                  <div class="gap-col-head">
                    <div class="gap-col-head-dot" style="background:#1a7a3a"></div>
                    <span style="color:#1a7a3a">You Have</span>
                    <span style="margin-left:auto;color:var(--muted)">@gap.MatchedSkills.Count matched</span>
                  </div>
                  @if (!gap.MatchedSkills.Any())
                  { <div style="font-size:12px;color:var(--muted)">No matching skills yet.</div> }
                  @foreach (var ms in gap.MatchedSkills)
                  {
                    <div class="gap-skill-row gap-row-have">
                      <span>@ms.SkillName</span>
                      <span style="font-family:var(--f-mono);font-size:9px">@ms.Priority</span>
                    </div>
                  }
                </div>
                <div class="gap-col">
                  <div class="gap-col-head">
                    <div class="gap-col-head-dot" style="background:var(--red)"></div>
                    <span style="color:var(--red)">Missing</span>
                    <span style="margin-left:auto;color:var(--muted)">@gap.MissingSkills.Count gaps</span>
                  </div>
                  @if (!gap.MissingSkills.Any())
                  { <div style="font-size:12px;color:#1a7a3a;font-weight:600">🎉 You have all required skills!</div> }
                  @foreach (var ms in gap.MissingSkills)
                  {
                    <div class="gap-skill-row gap-row-miss">
                      <span>@ms.SkillName</span>
                      <span style="font-family:var(--f-mono);font-size:9px">@ms.Priority</span>
                    </div>
                  }
                </div>
              </div>
              <div class="peer-bench">
                <div class="peer-cell"><div class="peer-label">Total Applicants</div><div class="peer-value">@Model.TopBenchmark.TotalApplicants</div></div>
                <div class="peer-cell"><div class="peer-label">Top Score</div><div class="peer-value">@Model.TopBenchmark.TopScore%</div></div>
                <div class="peer-cell"><div class="peer-label">Your Score</div><div class="peer-value" style="color:var(--lime-d)">@Model.TopBenchmark.MyScore%</div></div>
                <div class="peer-cell"><div class="peer-label">Your Percentile</div><div class="peer-value">@Model.TopBenchmark.Percentile%</div></div>
                            </div>
                        </div>
                    </div>

                    @if (Model.LearningResources.Any())
                    {
                        <div class="card" style="margin-bottom:20px">
                            <div class="card-head">
                                <span class="card-title">Learning Resources for Missing Skills</span>
                                <span class="badge badge-default">@Model.LearningResources.Count resource@(Model.LearningResources.Count == 1 ? "" : "s")</span>
                            </div>
                            <div class="card-body" style="padding:0">
                                @foreach (var skillGroup in Model.LearningResources.GroupBy(r => r.SkillID))
                                {
                                    var skillName = Model.TopGap.MissingSkills.FirstOrDefault(s => s.SkillID == skillGroup.Key)?.SkillName ?? "";
                                    var priority = Model.TopGap.MissingSkills.FirstOrDefault(s => s.SkillID == skillGroup.Key)?.Priority ?? "";
                                    <div style="padding:16px 22px;border-bottom:1px solid var(--line)">
                                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
                                            <span style="font-family:var(--f-mono);font-size:11px;font-weight:700;color:var(--ink)">@skillName</span>
                                            @if (priority == "Required")
                                            {
                                                <span class="badge badge-red" style="font-size:9px">REQUIRED</span>
                                            }
                                            else
                                            {
