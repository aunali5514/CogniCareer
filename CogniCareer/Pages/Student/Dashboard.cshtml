@page
@model CogniCareer.Pages.Student.DashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Student Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Dashboard — CogniCareer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css">
<style>
:root{--ink:#0f0e0d;--ink-2:#1e1c1a;--paper:#f5f0e8;--warm:#ede8e0;--line:#d6cfc4;--muted:#8a847b;--lime:#b8ff35;--lime-d:#8fd400;--red:#ff3f3f;--blue:#3b7fff;--white:#ffffff;--f-serif:'Playfair Display',Georgia,serif;--f-mono:'DM Mono','Courier New',monospace;--f-sans:'Jost',sans-serif;--r-sm:3px;--r:6px;--r-lg:12px;--shadow:0 2px 16px rgba(15,14,13,.08);--shadow-lg:0 8px 48px rgba(15,14,13,.16)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{font-size:16px}body{background:var(--paper);color:var(--ink);font-family:var(--f-sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}button{font-family:var(--f-sans);cursor:pointer}
h1,h2,h3,h4{font-family:var(--f-serif);font-weight:700;line-height:1.05;letter-spacing:-.03em}
input,select,textarea{font-family:var(--f-sans)}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--warm)}::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--lime-d)}
::selection{background:var(--lime);color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:7px;font-family:var(--f-sans);font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:10px 22px;border-radius:var(--r-sm);border:1.5px solid transparent;cursor:pointer;transition:all .16s;white-space:nowrap;user-select:none}
.btn-dark{background:var(--ink);color:var(--paper);border-color:var(--ink)}.btn-dark:hover{background:var(--ink-2);transform:translateY(-2px);box-shadow:0 6px 22px rgba(15,14,13,.22)}
.btn-lime{background:var(--lime);color:var(--ink);border-color:var(--lime)}.btn-lime:hover{background:var(--lime-d);border-color:var(--lime-d);transform:translateY(-2px);box-shadow:0 8px 28px rgba(143,212,0,.35)}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--ink)}.btn-outline:hover{background:var(--ink);color:var(--paper);transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--muted);border-color:var(--line)}.btn-ghost:hover{border-color:var(--ink);color:var(--ink)}
.btn-red{background:var(--red);color:#fff;border-color:var(--red)}
.btn-sm{font-size:10px;padding:7px 14px;letter-spacing:.06em}
.btn-w{width:100%;justify-content:center}
.field{margin-bottom:18px}.field-label{display:block;font-family:var(--f-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.field-input,.field-select,.field-textarea{width:100%;padding:11px 14px;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-sm);font-family:var(--f-sans);font-size:14px;color:var(--ink);outline:none;transition:border-color .15s,box-shadow .15s;appearance:none}
.field-input:focus,.field-select:focus,.field-textarea:focus{border-color:var(--lime-d)!important;box-shadow:0 0 0 3px rgba(143,212,0,.15),0 1px 4px rgba(15,14,13,.06)!important}
.field-textarea{resize:vertical;min-height:90px}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.badge{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:var(--r-sm);border:1px solid;display:inline-block;white-space:nowrap;transition:transform .12s,box-shadow .12s}
.badge:hover{transform:scale(1.05);box-shadow:0 2px 10px rgba(15,14,13,.09)}
.badge-default{color:var(--muted);border-color:var(--line);background:var(--warm)}
.badge-dark{color:var(--paper);border-color:var(--ink);background:var(--ink)}
.badge-lime{color:var(--ink);border-color:var(--lime);background:var(--lime)}
.badge-red{color:var(--red);border-color:rgba(255,63,63,.3);background:rgba(255,63,63,.06)}
.badge-blue{color:var(--blue);border-color:rgba(59,127,255,.3);background:rgba(59,127,255,.06)}
.badge-green{color:#1a7a3a;border-color:rgba(26,122,58,.3);background:rgba(26,122,58,.06)}
.status{font-family:var(--f-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:100px;display:inline-flex;align-items:center;gap:5px}
.status::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0}
.st-active{background:rgba(26,122,58,.08);color:#1a7a3a}.st-active::before{background:#1a7a3a}
.st-pending{background:rgba(180,100,0,.08);color:#b46400}.st-pending::before{background:#b46400}
.st-review{background:rgba(59,127,255,.08);color:var(--blue)}.st-review::before{background:var(--blue)}
.st-reject{background:rgba(255,63,63,.08);color:var(--red)}.st-reject::before{background:var(--red)}
.st-done{background:rgba(15,14,13,.08);color:var(--ink)}.st-done::before{background:var(--ink)}
.card{background:var(--white);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);transition:box-shadow .22s,transform .22s}
.card:hover{box-shadow:0 10px 40px rgba(15,14,13,.09),0 0 0 1px rgba(143,212,0,.07)!important;transform:translateY(-1px)}
.card-head{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;background:linear-gradient(135deg,var(--warm) 0%,rgba(245,240,232,.5) 100%)!important}
.card-title{font-family:var(--f-serif);font-size:15px;font-weight:700;letter-spacing:-.01em}
.card-body{padding:22px}
.card-body-p0{padding:0}
.notice{padding:11px 14px;border-radius:var(--r-sm);font-size:12px;line-height:1.5;margin-bottom:16px}
.notice-info{background:rgba(59,127,255,.06);border:1px solid rgba(59,127,255,.2);color:var(--blue)}
.notice-warn{background:rgba(255,63,63,.05);border:1px solid rgba(255,63,63,.2);color:var(--red)}
.notice-ok{background:rgba(26,122,58,.06);border:1px solid rgba(26,122,58,.2);color:#1a7a3a}
.toast{position:fixed;bottom:28px;right:28px;z-index:9999;padding:14px 20px;background:var(--ink);color:var(--paper);border-radius:var(--r-lg);font-size:13px;font-weight:500;display:flex;align-items:center;gap:10px;transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1);box-shadow:var(--shadow-lg);max-width:340px;pointer-events:none;border:1px solid rgba(255,255,255,.09);backdrop-filter:blur(14px)}
.toast.show{transform:translateY(0);opacity:1}.toast-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.toast.t-lime .toast-dot{background:var(--lime)}.toast.t-lime{border-color:rgba(184,255,53,.18)!important}
.toast.t-red .toast-dot{background:var(--red)}.toast.t-red{border-color:rgba(255,63,63,.22)!important}
.toast.t-blue .toast-dot{background:var(--blue)}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.dash-shell{min-height:100vh;display:flex}
.dash-sidebar{width:248px;position:fixed;top:0;left:0;bottom:0;background:var(--white);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow-y:auto;z-index:80}
.sidebar-logo{padding:20px 24px 16px;border-bottom:1px solid var(--line);font-family:var(--f-serif);font-size:17px;font-weight:900;letter-spacing:-.04em;cursor:pointer;user-select:none}
.sidebar-logo span{color:var(--lime-d);font-style:italic;font-weight:400}
.sb-section{font-family:var(--f-mono);font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);padding:18px 24px 6px}
.sb-link{display:flex;align-items:center;gap:11px;padding:9px 24px;font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;border-left:2px solid transparent;transition:all .12s;text-decoration:none}
.sb-link:hover{color:var(--ink);background:var(--paper)}
.sb-link.active,.sb-link.on{color:var(--ink);background:var(--paper);font-weight:700;border-left-color:var(--ink)}
.sb-ico{width:15px;text-align:center;font-size:13px;flex-shrink:0}
.sb-badge{margin-left:auto;background:var(--red);color:#fff;font-family:var(--f-mono);font-size:9px;padding:1px 6px;border-radius:100px}
.sb-foot{margin-top:auto;border-top:1px solid var(--line);padding:18px 24px}
.sb-user{display:flex;gap:11px;align-items:center;margin-bottom:12px}
.sb-avatar{width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:11px;font-weight:700;flex-shrink:0}
.av-student{background:var(--ink);color:var(--lime)}
.sb-uname{font-size:13px;font-weight:700}
.sb-urole{font-size:11px;color:var(--muted)}
.sb-signout{width:100%;padding:8px;border:1px solid var(--line);border-radius:var(--r-sm);background:transparent;color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:6px}
.sb-signout:hover{border-color:var(--ink);color:var(--ink)}
.dash-main{margin-left:248px;flex:1;min-height:100vh;display:flex;flex-direction:column;min-width:0}
.dash-topbar{position:sticky;top:0;z-index:70;height:54px;padding:0 36px;display:flex;align-items:center;justify-content:space-between;background:var(--paper);border-bottom:1px solid var(--line);box-shadow:var(--shadow);flex-shrink:0}
.dash-topbar-title{font-family:var(--f-serif);font-size:20px;font-weight:900;letter-spacing:-.02em}
.dash-content,.dash-body{padding:32px 36px;flex:1}
.panel{display:none}.panel.active{display:block;animation:pageReveal .35s cubic-bezier(.4,0,.2,1) both}
@@keyframes pageReveal{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.metric-strip{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;background:var(--white);margin-bottom:22px}
.metric-cell{padding:18px 22px;border-right:1px solid var(--line);position:relative;transition:background .15s}
.metric-cell:last-child{border-right:none}
.metric-cell::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.m-label{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.m-value{font-family:var(--f-serif);font-size:30px;font-weight:900;letter-spacing:-.04em;line-height:1;margin-bottom:4px;display:inline-block;transition:transform .2s}
.metric-cell:hover .m-value{transform:scale(1.05)}
.m-sub{font-size:11px;color:var(--muted);font-family:var(--f-mono)}
.progress-track{height:3px;background:var(--warm);border-radius:0;overflow:hidden}
.progress-fill{height:100%;border-radius:0;transition:width 1.2s cubic-bezier(.4,0,.2,1)}
.pf-ink{background:var(--ink)}.pf-lime{background:var(--lime-d)}.pf-red{background:var(--red)}.pf-muted{background:var(--muted)}.pf-blue{background:var(--blue)}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:10px 16px;border-bottom:1px solid var(--line);text-align:left;background:var(--warm);font-weight:400}
.data-table td{padding:12px 16px;border-bottom:1px solid var(--warm);vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:linear-gradient(to right,rgba(143,212,0,.035),var(--paper),rgba(143,212,0,.035))!important}
.job-desc-label{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.job-desc-full{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:12px;white-space:pre-wrap}
/* ── Change 2: v5 welcome banner — dark ink background, white text ── */
.wb-banner{
  background:var(--ink);
  border:1px solid rgba(255,255,255,.07);
  border-radius:var(--r-lg);padding:22px 28px;margin-bottom:22px;
  position:relative;overflow:hidden;
  background-image:
    repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,.007) 3px,rgba(255,255,255,.007) 4px),
    linear-gradient(rgba(255,255,255,.016) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.016) 1px,transparent 1px);
  background-size:auto,32px 32px,32px 32px;
}
.wb-banner::before{
  content:'';position:absolute;right:-40px;top:-40px;
  width:200px;height:200px;border-radius:50%;
  background:var(--lime);opacity:.06;pointer-events:none;
}
.wb-banner::after{
  content:'';position:absolute;left:38%;bottom:-50px;
  width:120px;height:120px;border-radius:50%;
  background:rgba(59,127,255,.05);pointer-events:none;
}
.wb-greeting{font-family:var(--f-mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:4px;font-weight:600}
.wb-name{font-family:var(--f-serif);font-size:22px;font-weight:900;letter-spacing:-.04em;color:var(--paper)}
.wb-name em{color:var(--lime);font-style:italic;font-weight:400}
.wb-meta{font-size:12px;color:rgba(255,255,255,.4);margin-top:6px}
.wb-stats{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.wb-stat{text-align:center;padding:8px 16px;border:1px solid rgba(255,255,255,.1);border-radius:var(--r);background:rgba(255,255,255,.06);transition:all .18s;position:relative;overflow:hidden}
.wb-stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.wb-stat:hover{transform:translateY(-2px);border-color:rgba(184,255,53,.3)}
.wb-stat-val{font-family:var(--f-serif);font-size:22px;font-weight:700;letter-spacing:-.04em;line-height:1}
.wb-stat-lbl{font-family:var(--f-mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-top:3px}
/* Stat pill accent colors — all from ZIP tokens */
.wb-stat-match::before{background:var(--lime-d)}
.wb-stat-match .wb-stat-val{color:var(--lime-d)}
.wb-stat-rank::before{background:var(--blue)}
.wb-stat-rank .wb-stat-val{color:var(--blue)}
.wb-stat-applied::before{background:#1a7a3a}
.wb-stat-applied .wb-stat-val{color:#1a7a3a}
.wb-stat-profile::before{background:var(--red)}
.wb-stat-profile .wb-stat-val{color:var(--red)}
/* ── Change 3: v5 KPI cards exactly matching screenshot 5 — individual cards, gradient top border ── */
/* Override metric-strip base: break the joined bar into separate cards */
.v5-kpi{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:14px;margin-bottom:22px;
  border:none !important;border-radius:0 !important;
  background:transparent !important;overflow:visible !important;
}
.v5-kpi .metric-cell{
  background:var(--white) !important;
  border:1px solid var(--line) !important;
  border-right:1px solid var(--line) !important;
  border-top:none !important;
  border-radius:var(--r-lg) !important;
  padding:22px 24px !important;
  overflow:hidden !important;
  box-shadow:0 2px 12px rgba(15,14,13,.05);
  transition:transform .18s,box-shadow .18s;
}
.v5-kpi .metric-cell:hover{transform:translateY(-3px) !important;box-shadow:0 10px 32px rgba(15,14,13,.1);background:var(--white) !important}
/* Gradient top border via pseudo */
.v5-kpi .metric-cell::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--r-lg) var(--r-lg) 0 0;
}
.v5-kpi .mc-ink::before{background:linear-gradient(to right,var(--lime-d),var(--lime))}
.v5-kpi .mc-lime::before{background:linear-gradient(to right,var(--blue),rgba(59,127,255,.5))}
.v5-kpi .mc-muted::before{background:linear-gradient(to right,#1a7a3a,rgba(26,122,58,.5))}
.v5-kpi .mc-blue::before{background:linear-gradient(to right,var(--red),rgba(255,63,63,.5))}
/* Remove old tiny dot */
.v5-kpi-dot{display:none}
/* Label */
.v5-kpi .m-label{font-family:var(--f-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;font-weight:600;display:block}
/* Huge serif number */
.v5-kpi .m-value{font-family:var(--f-serif) !important;font-size:38px !important;font-weight:900 !important;letter-spacing:-.05em !important;line-height:1 !important;margin-bottom:6px;color:var(--ink) !important}
.v5-kpi .metric-cell:hover .m-value{color:var(--ink) !important}
/* Context line */
.v5-kpi .m-sub{font-size:12px;color:var(--muted);font-weight:400;margin-bottom:0;display:block}
/* Trend line — green mono bold */
.v5-kpi .m-delta{font-family:var(--f-mono);font-size:10px;letter-spacing:.04em;color:#1a7a3a;font-weight:700;margin-top:7px;display:block}
/* ── Change 4: browse jobs header strip ── */
.v5-jobs-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;padding:4px 0}
.v5-jobs-count{font-family:var(--f-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
/* ── Search bar ── */
.browse-search-bar{display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap}
.browse-search-input-wrap{flex:1;min-width:220px;position:relative;display:flex;align-items:center}
.browse-search-icon{position:absolute;left:12px;width:16px;height:16px;color:var(--muted);pointer-events:none}
.browse-search-input{width:100%;padding:10px 14px 10px 36px;border:1px solid var(--line);border-radius:var(--r);font-family:var(--f-sans);font-size:13px;background:var(--white);color:var(--ink);outline:none;transition:border-color .15s}
.browse-search-input:focus{border-color:var(--ink)}
.browse-search-input::placeholder{color:var(--muted)}
.browse-filter-select{padding:10px 14px;border:1px solid var(--line);border-radius:var(--r);font-family:var(--f-sans);font-size:13px;background:var(--white);color:var(--ink);cursor:pointer;outline:none;transition:border-color .15s;min-width:120px}
.browse-filter-select:focus{border-color:var(--ink)}
/* ── Job row right column — ring + action stacked, aligned ── */
.job-right-col{display:flex;align-items:center;gap:14px;flex-shrink:0}
.job-action-col{display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-width:90px}
.job-action-btn{display:block;width:100%;text-align:center;white-space:nowrap}
/* ── v5 My Applications rows ── */
.v5-app-row{display:flex;align-items:stretch;border-bottom:1px solid var(--line);position:relative;transition:background .12s}
.v5-app-row:last-child{border-bottom:none}
.v5-app-row:hover{background:rgba(245,240,232,.5)}
.v5-app-accent{width:3px;flex-shrink:0;border-radius:0}
.v5-app-title{font-family:var(--f-serif);font-size:16px;font-weight:700;letter-spacing:-.02em;color:var(--ink);margin-bottom:2px}
.v5-app-meta{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-top:2px}
.v5-app-bar-row{display:flex;align-items:center;gap:10px;margin-top:4px}
.btn-notes{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:4px 10px;border:1px solid var(--line);border-radius:var(--r-sm);background:var(--white);color:var(--muted);cursor:pointer;transition:all .15s}
.btn-notes:hover{border-color:var(--ink);color:var(--ink)}
/* Status accent bars (left stripe color matches status) */
.v5-app-row .v5-app-accent.status-applied{background:var(--blue)}
.v5-app-row .v5-app-accent.status-shortlisted{background:var(--lime-d)}
.v5-app-row .v5-app-accent.status-interview{background:#1a7a3a}
.v5-app-row .v5-app-accent.status-rejected{background:var(--red)}
.v5-app-row .v5-app-accent.status-not-selected{background:var(--red)}
/* Skill chips: colored dot + label */
.skill-chip{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-family:var(--f-mono);font-size:9.5px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;border:1px solid;line-height:1.4;white-space:nowrap;transition:opacity .15s}
.skill-chip:hover{opacity:.8}
.skill-chip .sc-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.scc-0{background:rgba(59,127,255,.08);border-color:rgba(59,127,255,.3);color:var(--blue)}
.scc-0 .sc-dot{background:var(--blue)}
