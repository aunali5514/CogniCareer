<script>
var allSkills = @Html.Raw(Model.AllSkillsJson);

(function initDashDrawer() {
  var btn = document.getElementById('dash-menu-btn');
  var sidebar = document.getElementById('dash-sidebar');
  var overlay = document.getElementById('dash-drawer-overlay');
  if (!btn || !sidebar || !overlay) return;
  function openDrawer() {
    sidebar.classList.add('is-open');
    overlay.classList.add('is-visible');
    overlay.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close menu');
  }
  function closeDrawer() {
    sidebar.classList.remove('is-open');
    overlay.classList.remove('is-visible');
    overlay.setAttribute('aria-hidden', 'true');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open menu');
  }
  btn.addEventListener('click', function() {
    if (sidebar.classList.contains('is-open')) closeDrawer();
    else openDrawer();
  });
  overlay.addEventListener('click', closeDrawer);
  document.querySelectorAll('.dash-sidebar .sb-link').forEach(function(link) {
    link.addEventListener('click', closeDrawer);
  });
})();

function sw(panelId, title) {
  document.querySelectorAll('.panel').forEach(function(p){ p.classList.remove('active'); });
  var el = document.getElementById(panelId);
  if (el) el.classList.add('active');
  document.querySelectorAll('.sb-link').forEach(function(l){ l.classList.remove('on'); });
var lnkMap = {'sp-overview':'lnk-overview','sp-browse':'lnk-browse','sp-apps':'lnk-apps','sp-skills':'lnk-skills','sp-gap':'lnk-gap','sp-resume':'lnk-resume','sp-advisor':'lnk-advisor','sp-profile':'lnk-profile','sp-alerts':'lnk-alerts'};
  var lnk = document.getElementById(lnkMap[panelId]);
  if (lnk) lnk.classList.add('on');
  document.getElementById('page-title').textContent = title;
}
// ── Browse jobs: live search + filter + sort ──
function browseFilter() {
  var q = (document.getElementById('browse-search').value || '').toLowerCase();
  var type = (document.getElementById('browse-type').value || '').toLowerCase();
  var rows = document.querySelectorAll('#sp-browse .job-row-wow');
  var visible = 0;
  rows.forEach(function(row) {
    var text = row.textContent.toLowerCase();
    var typeMatch = !type || text.indexOf(type) !== -1;
    var qMatch = !q || text.indexOf(q) !== -1;
    if (typeMatch && qMatch) { row.style.display = ''; visible++; }
    else row.style.display = 'none';
  });
  var countEl = document.getElementById('browse-count');
  if (countEl) countEl.textContent = visible + ' JOBS FOUND';
  var chip = document.getElementById('browse-filter-chip');
  if (chip) chip.style.display = (q || type) ? 'inline-flex' : 'none';
}
function browseSort() {
  var sort = document.getElementById('browse-sort').value;
  var list = document.querySelector('#sp-browse .card-body-p0');
  if (!list) return;
  var rows = Array.from(list.querySelectorAll('.job-row-wow'));
  rows.sort(function(a, b) {
    if (sort === 'match') {
      var sa = parseFloat(a.querySelector('.ring-pct') ? a.querySelector('.ring-pct').textContent : '0');
      var sb = parseFloat(b.querySelector('.ring-pct') ? b.querySelector('.ring-pct').textContent : '0');
      return sb - sa;
    } else if (sort === 'deadline') {
      var da = a.querySelector('.job-co') ? a.querySelector('.job-co').textContent : '';
      var db = b.querySelector('.job-co') ? b.querySelector('.job-co').textContent : '';
      return da.localeCompare(db);
    }
    return 0;
  });
  rows.forEach(function(r){ list.appendChild(r); });
}


function showToast(msg, cls) {
  var t = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  t.className = 'toast ' + (cls || 't-lime');
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 3200);
}
function toggleSkillAdd() {
  var el = document.getElementById('skill-add-area');
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
function searchSkills(q) {
  var dd = document.getElementById('skill-dd');
  if (!q || q.length < 1) { dd.style.display = 'none'; return; }
  var filtered = allSkills.filter(function(s){ return s.skillName.toLowerCase().includes(q.toLowerCase()); });
  if (!filtered.length) { dd.style.display = 'none'; return; }
  dd.innerHTML = filtered.slice(0, 8).map(function(s){
    return '<div class="skill-opt" onmousedown="selectSkill('+s.skillID+',\''+s.skillName+'\')"><span class="skill-opt-name">'+s.skillName+'</span><span class="skill-opt-cat">'+s.category+'</span></div>';
  }).join('');
  dd.style.display = 'block';
}
function selectSkill(id, name) {
  document.getElementById('skill-q').value = name;
  document.getElementById('skill-id-input').value = id;
  document.getElementById('skill-dd').style.display = 'none';
}
function closeSkillDD() {
  document.getElementById('skill-dd').style.display = 'none';
}
function setProf(btn, level) {
  document.querySelectorAll('#prof-row .prof-btn').forEach(function(b){ b.className = 'prof-btn'; });
  var cls = level === 'Beginner' ? 'p-beg' : level === 'Intermediate' ? 'p-int' : 'p-adv';
  btn.className = 'prof-btn ' + cls;
  document.getElementById('prof-input').value = level;
}
                /* =====================================================
           AI helper — read anti-forgery token from the page
           ===================================================== */
        function getAfToken() {
          var el = document.querySelector('input[name="__RequestVerificationToken"]');
          return el ? el.value : '';
        }
                /* =====================================================
           PDF RESUME UPLOAD → extract text → fill textarea
           ===================================================== */
        async function uploadResumePdf(inputEl) {
          if (!inputEl.files || inputEl.files.length === 0) return;
          var file = inputEl.files[0];

          if (file.size > 5 * 1024 * 1024) {
            showToast('File too large. Maximum 5 MB.', 't-red');
            inputEl.value = '';
            return;
          }

          var btn = document.getElementById('btn-upload-pdf');
          var labelEl = btn.querySelector('.upload-label');
          var originalLabel = labelEl.textContent;
          btn.classList.add('is-busy');
          labelEl.innerHTML = '<span class="ai-spinner"></span>&nbsp; Extracting...';

          try {
            var formData = new FormData();
            formData.append('file', file);

            var res = await fetch('?handler=ExtractPdf', {
              method: 'POST',
              headers: { 'RequestVerificationToken': getAfToken() },
              body: formData
            });
            var raw = await res.text();
            if (!res.ok) throw new Error('Server returned HTTP ' + res.status);
            var data = JSON.parse(raw);
            if (!data.success) throw new Error(data.errorMessage || 'Extraction failed');

            document.getElementById('resume-input').value = data.text;
            showToast('PDF extracted (' + data.text.length + ' chars). Click "Analyze Resume" to score it.', 't-lime');
          } catch (err) {
            console.error('PDF upload error:', err);
            showToast('Could not extract PDF: ' + err.message, 't-red');
          } finally {
            btn.classList.remove('is-busy');
            labelEl.textContent = originalLabel;
            inputEl.value = ''; // reset so user can upload the same file again
          }
        }
        /* =====================================================
           AI RESUME ANALYZER
           ===================================================== */
        async function analyzeResume() {
          var txt = document.getElementById('resume-input').value.trim();
          if (txt.length < 50) {
            showToast('Please paste your full resume (at least 50 characters).', 't-red');
            return;
          }
          var btn = document.getElementById('btn-analyze');
          var status = document.getElementById('resume-status');
          btn.disabled = true; btn.style.opacity = '.6';
          status.style.display = 'block';

          try {
            var res = await fetch('?handler=AnalyzeResume', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAfToken()
              },
              body: JSON.stringify({ text: txt })
            });
            var raw = await res.text();
            if (!res.ok) throw new Error('Server returned HTTP ' + res.status + (raw ? ' — ' + raw.substring(0, 180) : ''));
            if (!raw) throw new Error('Server returned an empty response.');
            var data = JSON.parse(raw);
            if (!data.success) {
              showToast(data.errorMessage || 'Analysis failed.', 't-red');
              return;
            }
            renderResumeScore(data);
            showToast('Resume analyzed!', 't-lime');
          } catch (err) {
            console.error('Resume analyze error:', err);
            showToast(err.message || 'Network error', 't-red');
          } finally {
            btn.disabled = false; btn.style.opacity = '1';
            status.style.display = 'none';
          }
        }

        function renderResumeScore(d) {
          document.getElementById('score-num').textContent = d.overallScore;
          document.getElementById('score-circle').classList.add('has-score');
          document.getElementById('score-title').textContent = scoreLabel(d.overallScore);
          document.getElementById('score-tagline').textContent = 'AI overall score';

          setMetric('skills',   d.skillsAlignment);
          setMetric('complete', d.completeness);
          setMetric('exp',      d.experienceLanguage);
          setMetric('key',      d.keywordDensity);

          var fb = document.getElementById('ai-feedback');
          fb.textContent = d.feedback || 'No feedback returned.';
          fb.classList.remove('is-empty');
        }

        function setMetric(id, val) {
          document.getElementById('m-' + id).textContent = val + '/100';
          setTimeout(function(){ document.getElementById('f-' + id).style.width = val + '%'; }, 60);
        }

        function scoreLabel(s) {
          if (s >= 85) return 'Excellent';
          if (s >= 70) return 'Strong';
          if (s >= 55) return 'Decent';
          if (s >= 40) return 'Needs Work';
          return 'Weak';
        }

        /* =====================================================
           AI CAREER ADVISOR (chat)
           ===================================================== */
        var chatHistory = @Html.Raw(Model.ChatHistoryJson);

// Render any pre-loaded chat messages with proper formatting on page load
window.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.chat-msg[data-content]').forEach(function(el) {
    var content = el.getAttribute('data-content');
    if (el.classList.contains('from-user')) {
      el.textContent = content;
    } else {
      el.innerHTML = formatChatText(content);
    }
  });
  // Scroll chat to bottom if there's history
  var area = document.getElementById('chat-area');
  if (area) area.scrollTop = area.scrollHeight;
});

        function askAdvisor(presetText) {
          document.getElementById('chat-input').value = presetText;
          sendChat();
        }

        async function sendChat() {
          var inputEl = document.getElementById('chat-input');
          var question = inputEl.value.trim();
          if (!question) return;
          inputEl.value = '';

          appendChatMsg('user', question);
          var thinkingEl = appendChatMsg('ai', '…thinking', true);

          var sendBtn = document.getElementById('chat-send');
          sendBtn.disabled = true;

          try {
            var res = await fetch('?handler=AskAdvisor', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAfToken()
              },
              body: JSON.stringify({ question: question, history: chatHistory })
            });
            var raw = await res.text();
            if (!res.ok) throw new Error('Server returned HTTP ' + res.status + (raw ? ' — ' + raw.substring(0, 180) : ''));
            if (!raw) throw new Error('Server returned an empty response.');
            var data = JSON.parse(raw);
            var reply = data.reply || 'No response.';
            thinkingEl.classList.remove('thinking');
            thinkingEl.innerHTML = formatChatText(reply);
            chatHistory.push({ role: 'user',  content: question });
            chatHistory.push({ role: 'model', content: reply });
          } catch (err) {
            console.error('Advisor error:', err);
            thinkingEl.textContent = err.message || 'Network error';
            thinkingEl.classList.remove('thinking');
          } finally {
            sendBtn.disabled = false;
            var area = document.getElementById('chat-area');
            area.scrollTop = area.scrollHeight;
          }
        }

        function appendChatMsg(who, text, isThinking) {
          var area = document.getElementById('chat-area');
          var div = document.createElement('div');
          div.className = 'chat-msg ' + (who === 'user' ? 'from-user' : 'from-ai') + (isThinking ? ' thinking' : '');
          if (who === 'user') {
            div.textContent = text;
          } else {
            div.innerHTML = isThinking ? text : formatChatText(text);
          }
          area.appendChild(div);
          area.scrollTop = area.scrollHeight;
          return div;
        }

        function formatChatText(t) {
          var safe = t
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
          safe = safe.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
          safe = safe.replace(/\n/g, '<br>');
          return safe;
        }
                async function clearChat() {
          if (!confirm('Clear all chat history? This cannot be undone.')) return;
          try {
            var res = await fetch('?handler=ClearChat', {
              method: 'POST',
              headers: { 'RequestVerificationToken': getAfToken() }
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var data = await res.json();
            if (!data.success) throw new Error('Server refused');
            chatHistory = [];
            var area = document.getElementById('chat-area');
            area.innerHTML = '<div class="chat-msg from-ai">👋 Chat cleared. Ask me anything.</div>';
            showToast('Chat history cleared.', 't-lime');
          } catch (err) {
            showToast('Could not clear chat: ' + err.message, 't-red');
          }
        }
                /* =====================================================
           EXPLAIN MATCH SCORE (per-job AI breakdown)
           ===================================================== */
        async function explainMatch(jobId) {
          var modal = document.getElementById('explain-modal');
          var textEl = document.getElementById('em-text');
          var matchLine = document.getElementById('em-match-line');
          var pillEl = document.getElementById('em-pill');
          var titleEl = document.getElementById('em-title');
          var subEl = document.getElementById('em-sub');

          // Reset modal to loading state and show it
          titleEl.textContent = 'Why this match?';
          subEl.textContent = 'AI-generated breakdown';
          matchLine.style.display = 'none';
          textEl.innerHTML = '<span class="ai-spinner"></span>&nbsp; Asking AI...';
          modal.classList.add('is-open');

          try {
            var res = await fetch('?handler=ExplainMatch', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAfToken()
              },
              body: JSON.stringify({ jobId: jobId })
            });
            var raw = await res.text();
            if (!res.ok) throw new Error('Server returned HTTP ' + res.status + (raw ? ' — ' + raw.substring(0, 180) : ''));
            if (!raw) throw new Error('Server returned an empty response.');
            var data = JSON.parse(raw);

            if (data.jobTitle) {
              titleEl.textContent = data.jobTitle;
              subEl.textContent = (data.companyName || '') + ' — AI breakdown';
              pillEl.textContent = (data.matchScore || 0) + '% match';
              matchLine.style.display = 'flex';
            }
            textEl.innerHTML = formatChatText(data.explanation || 'No explanation returned.');
          } catch (err) {
            console.error('Explain match error:', err);
            textEl.textContent = 'Error: ' + err.message;
          }
        }

        function closeExplainModal() {
          document.getElementById('explain-modal').classList.remove('is-open');
        }
                /* =====================================================
           COVER LETTER GENERATOR
           ===================================================== */
        var clState = { jobId: 0, jobTitle: '', companyName: '', tone: 'professional' };

        function generateCoverLetter(jobId, jobTitle, companyName) {
          clState = { jobId: jobId, jobTitle: jobTitle, companyName: companyName, tone: 'professional' };

          // Reset tone buttons
          document.querySelectorAll('#cover-modal .cl-tone-btn').forEach(function(btn){
            btn.classList.toggle('is-active', btn.getAttribute('data-tone') === 'professional');
          });

          document.getElementById('cl-title').textContent = jobTitle;
          document.getElementById('cl-sub').textContent = companyName + ' · AI-generated';
          document.getElementById('cover-modal').classList.add('is-open');
          fetchCoverLetter();
        }

        function setCoverTone(btn) {
          var tone = btn.getAttribute('data-tone');
          if (clState.tone === tone) return;
          document.querySelectorAll('#cover-modal .cl-tone-btn').forEach(function(b){
            b.classList.toggle('is-active', b === btn);
          });
          clState.tone = tone;
          fetchCoverLetter();
        }

        function regenerateCoverLetter() {
          fetchCoverLetter();
        }

        async function fetchCoverLetter() {
          var body = document.getElementById('cl-body');
          var copyBtn = document.getElementById('cl-copy');
          var regenBtn = document.getElementById('cl-regen');

          body.classList.add('is-loading');
          body.innerHTML = '<span class="ai-spinner"></span>&nbsp; Writing your cover letter...';
          copyBtn.disabled = true;
          copyBtn.classList.remove('is-copied');
          copyBtn.textContent = 'Copy to clipboard';
          regenBtn.disabled = true;

          try {
            var res = await fetch('?handler=GenerateCoverLetter', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAfToken()
              },
              body: JSON.stringify({ jobId: clState.jobId, tone: clState.tone })
            });
            var raw = await res.text();
            if (!res.ok) throw new Error('Server returned HTTP ' + res.status);
            var data = JSON.parse(raw);
            if (!data.success) throw new Error(data.errorMessage || 'Generation failed');

            body.classList.remove('is-loading');
            body.textContent = data.letter; // textContent preserves whitespace inside white-space:pre-wrap
            copyBtn.disabled = false;
            regenBtn.disabled = false;
          } catch (err) {
            console.error('Cover letter error:', err);
            body.classList.remove('is-loading');
            body.textContent = 'Error: ' + err.message;
            regenBtn.disabled = false;
          }
        }

        async function copyCoverLetter() {
          var body = document.getElementById('cl-body');
          var copyBtn = document.getElementById('cl-copy');
          try {
            await navigator.clipboard.writeText(body.textContent);
            copyBtn.classList.add('is-copied');
            copyBtn.textContent = '✓ Copied!';
            setTimeout(function(){
              copyBtn.classList.remove('is-copied');
              copyBtn.textContent = 'Copy to clipboard';
            }, 2000);
          } catch (err) {
            // Fallback for older browsers
            var range = document.createRange();
            range.selectNodeContents(body);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            try { document.execCommand('copy'); copyBtn.textContent = '✓ Copied!'; } catch(e) {}
            sel.removeAllRanges();
          }
        }

        function closeCoverModal() {
          document.getElementById('cover-modal').classList.remove('is-open');
        }
        // V3 countup animation
        function countUp(el, target, suffix, dur) {
          dur = dur || 1100;
          var start = performance.now();
          (function step(now) {
            var p = Math.min((now - start) / dur, 1);
            var ease = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(ease * target) + suffix;
            if (p < 1) requestAnimationFrame(step);
          })(performance.now());
        }
        function runCounters() {
          document.querySelectorAll('.countup:not([data-done])').forEach(function(el) {
            el.dataset.done = '1';
            countUp(el, parseInt(el.dataset.target || el.textContent) || 0, el.dataset.suffix || '');
          });
        }
        window.addEventListener('load', runCounters);

@if (!string.IsNullOrEmpty(Model.ToastMessage))
{
  <text>window.addEventListener('load', function(){ showToast('@Model.ToastMessage', '@Model.ToastClass'); });</text>
}
</script>
</body>
</html>
