.score-circle{width:120px;height:120px;border-radius:50%;border:5px solid var(--warm);display:flex;align-items:center;justify-content:center;font-family:var(--f-serif);font-size:30px;font-weight:900;color:var(--ink);position:relative;background:var(--white);flex-shrink:0;transition:border-color .35s}
.score-circle .sc-sub{position:absolute;bottom:-2px;right:-2px;background:var(--ink);color:var(--paper);font-family:var(--f-mono);font-size:9px;padding:2px 7px;border-radius:100px;letter-spacing:.08em}
