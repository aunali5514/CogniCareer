.au{animation:fadeUp .55s ease both}
/* ===== NEW: AI Resume Analyzer + AI Advisor styles ===== */
.ai-sub{font-size:12px;color:var(--muted);margin-bottom:14px;font-family:var(--f-mono);letter-spacing:.04em}
.resume-textarea{width:100%;min-height:220px;padding:14px;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-sm);font-family:var(--f-mono);font-size:13px;line-height:1.55;color:var(--ink);resize:vertical;outline:none;transition:border-color .15s,box-shadow .15s}
