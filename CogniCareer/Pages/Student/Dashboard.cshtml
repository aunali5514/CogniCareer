.chat-send{padding:0 26px;background:var(--ink);color:var(--paper);border:none;font-family:var(--f-sans);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background .15s;display:flex;align-items:center;gap:6px}
