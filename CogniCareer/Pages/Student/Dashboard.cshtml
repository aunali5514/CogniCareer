.skill-card-item{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--line);border-radius:var(--r);background:var(--white);margin-bottom:8px;transition:border-color .15s,transform .15s,box-shadow .15s;cursor:default}
