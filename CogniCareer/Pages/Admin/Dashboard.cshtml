@page
@model CogniCareer.Pages.Admin.DashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — CogniCareer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <!-- Devicon for tech/skill logos -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css">
    <!-- Simple Icons via unpkg -->
    <style>
        /* ========== V3 ADMIN PORTAL – EXACT STYLES ========== */
        :root {
            --ink: #0f0e0d;
            --ink-2: #1e1c1a;
            --paper: #f5f0e8;
            --warm: #ede8e0;
            --line: #d6cfc4;
            --muted: #8a847b;
            --lime: #C6F135;
            --lime-d: #9ABF1A;
            --red: #ff3f3f;
            --blue: #3b7fff;
            --white: #ffffff;
            --success: #1a7a3a;
            --warn: #b46400;
            --p1: #3b7fff;
            --p2: #7c5cff;
            --f-serif: 'Playfair Display', Georgia, serif;
            --f-mono: 'DM Mono', 'Courier New', monospace;
            --f-sans: 'Jost', sans-serif;
            --r-sm: 3px;
            --r: 6px;
            --r-lg: 12px;
            --shadow: 0 2px 16px rgba(15,14,13,.08);
            --shadow-lg: 0 8px 48px rgba(15,14,13,.16);
        }
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { font-size: 16px; scroll-behavior: smooth; }
        body { background: var(--paper); color: var(--ink); font-family: var(--f-sans); overflow-x: hidden; }
        a { text-decoration: none; color: inherit; }
        button { font-family: var(--f-sans); cursor: pointer; }

        /* Buttons */
        .btn {
            display: inline-flex; align-items: center; gap: 7px;
            font-size: 12px; font-weight: 700; letter-spacing: .07em;
            text-transform: uppercase; padding: 10px 22px;
            border-radius: var(--r-sm); border: 1.5px solid transparent;
            cursor: pointer; transition: all .16s; white-space: nowrap;
        }
        .btn-dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
        .btn-dark:hover { background: var(--ink-2); transform: translateY(-2px); box-shadow: 0 6px 22px rgba(15,14,13,.22); }
        .btn-lime { background: var(--lime); color: var(--ink); border-color: var(--lime); }
        .btn-lime:hover { background: var(--lime-d); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(143,212,0,.35); }
        .btn-ghost { background: transparent; color: var(--muted); border-color: var(--line); }
        .btn-ghost:hover { border-color: var(--ink); color: var(--ink); }
        .btn-red { background: var(--red); color: #fff; border-color: var(--red); }
        .btn-sm { font-size: 10px; padding: 7px 14px; }
        .btn-w { width: 100%; justify-content: center; }

        /* Form */
        .field { margin-bottom: 16px; }
        .field-label { display: block; font-family: var(--f-mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 7px; }
        .field-input, .field-select, .field-textarea {
            width: 100%; padding: 11px 14px; background: var(--white);
            border: 1.5px solid var(--line); border-radius: var(--r-sm);
            font-size: 14px; color: var(--ink); outline: none;
        }
        .field-input:focus, .field-select:focus, .field-textarea:focus {
            border-color: var(--lime-d); box-shadow: 0 0 0 3px rgba(143,212,0,.15);
        }
        .field-textarea { resize: vertical; min-height: 80px; }
        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

        /* Badges & status */
        .badge {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .1em;
            text-transform: uppercase; padding: 3px 9px; border-radius: var(--r-sm);
            border: 1px solid; display: inline-block;
        }
        .badge-default { color: var(--muted); border-color: var(--line); background: var(--warm); }
        .badge-dark { color: var(--paper); border-color: var(--ink); background: var(--ink); }
        .badge-lime { color: var(--ink); border-color: var(--lime); background: var(--lime); }
        .badge-red { color: var(--red); border-color: rgba(255,63,63,.3); background: rgba(255,63,63,.06); }
        .badge-green { color: #1a7a3a; border-color: rgba(26,122,58,.3); background: rgba(26,122,58,.06); }
        .badge-blue { color: var(--blue); border-color: rgba(59,127,255,.3); background: rgba(59,127,255,.06); }

        .status {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .08em;
            text-transform: uppercase; padding: 4px 10px; border-radius: 100px;
            display: inline-flex; align-items: center; gap: 5px;
        }
        .status::before { content: ''; width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }
        .st-active { background: rgba(26,122,58,.08); color: #1a7a3a; }
        .st-active::before { background: #1a7a3a; }
        .st-pending { background: rgba(180,100,0,.08); color: #b46400; }
        .st-pending::before { background: #b46400; }
        .st-review { background: rgba(59,127,255,.08); color: var(--blue); }
        .st-review::before { background: var(--blue); }
        .st-reject { background: rgba(255,63,63,.08); color: var(--red); }
        .st-reject::before { background: var(--red); }

        /* Cards */
        .card {
            background: var(--white); border: 1px solid var(--line);
            border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow);
            transition: box-shadow .2s, transform .2s;
        }
        .card:hover { box-shadow: 0 10px 40px rgba(15,14,13,.09), 0 0 0 1px rgba(143,212,0,.07); transform: translateY(-2px); }
        .card-head {
            padding: 16px 22px; border-bottom: 1px solid var(--line);
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            background: linear-gradient(135deg, var(--warm) 0%, rgba(245,240,232,.5) 100%);
        }
        .card-title { font-family: var(--f-serif); font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
        .card-body { padding: 22px; }
        .card-body-p0 { padding: 0; }

        /* Toast */
        .toast {
            position: fixed; bottom: 28px; right: 28px; z-index: 9999;
            padding: 14px 20px; background: var(--ink); color: var(--paper);
            border-radius: var(--r-lg); font-size: 13px; display: flex;
            align-items: center; gap: 10px; transform: translateY(80px);
            opacity: 0; transition: all .3s cubic-bezier(.4,0,.2,1);
            box-shadow: var(--shadow-lg); max-width: 340px; pointer-events: none;
            border: 1px solid rgba(255,255,255,.09);
            backdrop-filter: blur(14px);
        }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast-dot { width: 7px; height: 7px; border-radius: 50%; }
        .toast.t-lime .toast-dot { background: var(--lime); }
        .toast.t-red .toast-dot { background: var(--red); }

        /* Dashboard layout */
        .dash-shell { min-height: 100vh; display: flex; }
        .dash-sidebar {
            width: 248px; position: fixed; top: 0; left: 0; bottom: 0;
            background: var(--white); border-right: 1px solid var(--line);
            display: flex; flex-direction: column; overflow-y: auto; z-index: 80;
        }
        .sidebar-logo {
            padding: 20px 24px 16px; border-bottom: 1px solid var(--line);
            font-family: var(--f-serif); font-size: 17px; font-weight: 900;
            letter-spacing: -.04em; cursor: pointer;
        }
        .sidebar-logo span { color: var(--lime-d); font-style: italic; font-weight: 400; }
        .sb-section {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .15em;
            text-transform: uppercase; color: var(--muted); padding: 18px 24px 6px;
            display: flex; align-items: center; gap: 8px;
        }
        .sb-section::after { content: ''; flex: 1; height: 1px; background: var(--line); }
        .sb-link {
            display: flex; align-items: center; gap: 11px; padding: 9px 24px;
            font-size: 13px; font-weight: 500; color: var(--muted);
            cursor: pointer; border-left: 2px solid transparent;
            transition: all .12s; text-decoration: none;
        }
        .sb-link:hover { color: var(--ink); background: var(--paper); }
        .sb-link.on, .sb-link.active {
            color: var(--ink); background: linear-gradient(to right, rgba(143,212,0,.07), transparent);
            font-weight: 700; border-left-color: var(--lime-d);
        }
        .sb-ico { width: 15px; text-align: center; flex-shrink: 0; }
        .sb-ico svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; }
        .sb-badge {
            margin-left: auto; background: var(--red); color: #fff;
            font-family: var(--f-mono); font-size: 9px; padding: 1px 6px;
            border-radius: 100px;
        }
        .sb-foot { margin-top: auto; border-top: 1px solid var(--line); padding: 18px 24px; }
        .sb-user { display: flex; gap: 11px; align-items: center; margin-bottom: 12px; }
        .sb-avatar {
            width: 36px; height: 36px; border-radius: var(--r-sm);
            display: flex; align-items: center; justify-content: center;
            font-family: var(--f-mono); font-size: 11px; font-weight: 700;
            box-shadow: 0 0 0 2px rgba(255,63,63,.5);
        }
        .av-admin { background: var(--red); color: #fff; }
        .sb-uname { font-size: 13px; font-weight: 700; }
        .sb-urole { font-size: 11px; color: var(--muted); }
        .admin-access-chip {
            display: inline-flex; align-items: center; gap: 4px;
            font-family: var(--f-mono); font-size: 8px; letter-spacing: .08em;
            text-transform: uppercase; padding: 2px 8px; border-radius: 100px;
            background: rgba(255,63,63,.08); border: 1px solid rgba(255,63,63,.2);
            color: var(--red); margin-top: 3px;
        }
        .admin-access-chip-dot { width: 5px; height: 5px; border-radius: 50%; background: #ff6b6b; flex-shrink: 0; animation: blink 1.8s infinite; }
        .sb-signout {
            width: 100%; padding: 8px; border: 1px solid var(--line);
            border-radius: var(--r-sm); background: transparent; color: var(--muted);
            font-size: 11px; font-weight: 700; letter-spacing: .06em;
            text-transform: uppercase; cursor: pointer; transition: all .15s;
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .sb-signout:hover { border-color: var(--ink); color: var(--ink); }

        .dash-main { margin-left: 248px; flex: 1; min-height: 100vh; display: flex; flex-direction: column; min-width: 0; }
        .dash-topbar {
            position: sticky; top: 0; z-index: 70; height: 54px; padding: 0 36px;
            display: flex; align-items: center; justify-content: space-between;
            background: rgba(245,240,232,.95); backdrop-filter: blur(18px) saturate(1.5);
            border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
            flex-shrink: 0;
        }
        .dash-topbar-title { font-family: var(--f-serif); font-size: 20px; font-weight: 900; letter-spacing: -.02em; display: flex; align-items: center; gap: 8px; }
        .ap-live-pill {
            display: inline-flex; align-items: center; gap: 6px;
            font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .1em;
            text-transform: uppercase; color: var(--muted); background: var(--warm);
            border: 1px solid var(--line); border-radius: 100px; padding: 4px 12px;
        }
        .ap-live-pill-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--lime-d); flex-shrink: 0; animation: blink 1.6s infinite; }
        .dash-body { padding: 32px 36px; }
        .panel { display: none; min-width: 0; }
        .panel.active { display: block; animation: fadeUp .4s ease both; }

        /* ====================================================
           V3 OVERVIEW BANNER (matches screenshot exactly)
           ==================================================== */
        .ap-welcome-banner {
            display: flex; align-items: center; justify-content: space-between;
            padding: 22px 28px; margin-bottom: 22px; background: var(--ink);
            border-radius: var(--r-lg); position: relative; overflow: hidden;
            min-height: 120px;
            background-image: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(255,255,255,.007) 3px, rgba(255,255,255,.007) 4px);
        }
        .apwb-left { display: flex; flex-direction: column; gap: 3px; position: relative; z-index: 1; }
        .apwb-greeting {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .14em;
            text-transform: uppercase; color: rgba(255,255,255,.4);
            display: flex; align-items: center; gap: 7px;
        }
        .apwb-name { font-family: var(--f-serif); font-size: 22px; font-weight: 900; color: var(--paper); letter-spacing: -.02em; }
        .apwb-name em { color: var(--lime); font-style: italic; font-weight: 400; }
        .apwb-right { display: flex; align-items: center; gap: 10px; position: relative; z-index: 1; }
        .apwb-stat {
            background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08);
            border-radius: var(--r-sm); padding: 10px 14px; text-align: center;
            min-width: 72px; transition: border-color .15s;
        }
        .apwb-stat:hover { border-color: rgba(184,255,53,.3); }
        .apwb-stat-val { font-family: var(--f-mono); font-size: 20px; font-weight: 700; color: var(--paper); line-height: 1; }
        .apwb-stat-val.v-lime { color: var(--lime); }
        .apwb-stat-val.v-red { color: #ff6b6b; }
        .apwb-stat-val.v-blue { color: #7eb3ff; }
        .apwb-stat-val.v-paper { color: var(--paper); }
        .apwb-stat-lbl { font-family: var(--f-mono); font-size: 8px; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.3); margin-top: 4px; }

        /* ====================================================
           NEW V3 METRIC CARDS (matches screenshot 2)
           4 cards: Students / Companies / Active Jobs / Total Applications
           Each has: top icon, large number, subtitle, delta chip, top colour bar
           ==================================================== */
        .v3-metric-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 22px;
        }
        .v3-mc {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--r-lg);
            padding: 20px 22px 18px;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform .2s, box-shadow .2s;
        }
        .v3-mc:hover { transform: translateY(-3px); box-shadow: 0 10px 36px rgba(15,14,13,.1); }
        /* top colour accent bar */
        .v3-mc::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 3px;
        }
        .v3-mc.mc-students::before { background: var(--ink); }
        .v3-mc.mc-companies::before { background: var(--lime-d); }
        .v3-mc.mc-jobs::before { background: var(--red); }
        .v3-mc.mc-apps::before { background: var(--blue); }

        /* icon row */
        .v3-mc-icon-row {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 14px;
        }
        .v3-mc-label {
            font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .12em;
            text-transform: uppercase; color: var(--muted);
            display: flex; align-items: center; gap: 7px;
        }
        .v3-mc-label svg { width: 13px; height: 13px; stroke: currentColor; stroke-width: 2; fill: none; flex-shrink: 0; }
        .v3-mc-icon-badge {
            width: 34px; height: 34px; border-radius: var(--r-sm);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .v3-mc-icon-badge svg { width: 16px; height: 16px; stroke-width: 2; fill: none; }
        .ib-students { background: rgba(15,14,13,.06); color: var(--ink); }
        .ib-companies { background: rgba(143,212,0,.12); color: #5a8a00; }
        .ib-jobs { background: rgba(255,63,63,.08); color: var(--red); }
        .ib-apps { background: rgba(59,127,255,.08); color: var(--blue); }

        /* big number */
        .v3-mc-value {
            font-family: var(--f-serif); font-size: 36px; font-weight: 900;
            letter-spacing: -.04em; line-height: 1; margin-bottom: 4px;
        }
        .v3-mc-value.val-students { color: var(--ink); }
        .v3-mc-value.val-companies { color: var(--lime-d); }
        .v3-mc-value.val-jobs { color: var(--ink); }
        .v3-mc-value.val-apps { color: var(--ink); }

        /* subtitle */
        .v3-mc-sub {
            font-size: 12px; color: var(--muted); font-weight: 400; margin-bottom: 10px;
        }

        /* divider line */
        .v3-mc-divider {
            height: 1px; background: var(--line); margin: 10px 0;
        }

        /* delta chip */
        .v3-mc-delta {
            display: inline-flex; align-items: center; gap: 5px;
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .06em;
            padding: 3px 9px; border-radius: 100px; font-weight: 500;
        }
        .v3-mc-delta svg { width: 10px; height: 10px; stroke-width: 2.5; fill: none; }
        .delta-up { background: rgba(26,122,58,.08); color: var(--success); border: 1px solid rgba(26,122,58,.18); }
        .delta-warn { background: rgba(180,100,0,.08); color: var(--warn); border: 1px solid rgba(180,100,0,.18); }
        .delta-blue { background: rgba(59,127,255,.08); color: var(--blue); border: 1px solid rgba(59,127,255,.18); }

        /* ====================================================
           INSIGHT GRID (unchanged – keep existing)
           ==================================================== */
        .insight-grid {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 18px; margin-bottom: 22px;
        }
        .insight-card {
            background: var(--white); border: 1px solid var(--line);
            border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow);
            transition: transform .2s;
        }
        .insight-card:hover { transform: translateY(-3px); }
        .insight-head { padding: 14px 18px; border-bottom: 1px solid var(--line); background: var(--warm); }
        .insight-title { font-family: var(--f-serif); font-size: 14px; font-weight: 700; letter-spacing: -.01em; }
        .insight-sub { font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 3px; }
        .insight-body { padding: 6px 0; }
        .insight-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 18px; border-bottom: 1px solid var(--warm);
        }
        .insight-row:last-child { border-bottom: none; }
        .insight-rank { font-family: var(--f-mono); font-size: 10px; color: var(--muted); width: 18px; flex-shrink: 0; }
        .insight-name { flex: 1; font-size: 13px; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .insight-meta { font-family: var(--f-mono); font-size: 9px; color: var(--muted); letter-spacing: .04em; }
        .insight-bar-wrap { width: 56px; height: 4px; background: var(--warm); border-radius: 2px; overflow: hidden; flex-shrink: 0; }
        .insight-bar { height: 100%; background: var(--lime-d); border-radius: 2px; }
        .insight-val { font-family: var(--f-mono); font-size: 10px; font-weight: 500; color: var(--ink); min-width: 32px; text-align: right; }

        /* ====================================================
           SKILL LIBRARY – devicon styles
           ==================================================== */
        .skills-layout { display: grid; grid-template-columns: 320px 1fr; gap: 20px; align-items: start; }
        .skills-search-wrap { position: relative; margin-bottom: 14px; }
        .skills-search {
            width: 100%; padding: 10px 14px 10px 36px;
            border: 1.5px solid var(--line); border-radius: var(--r-sm);
            font-size: 13px; background: var(--white); outline: none;
        }
        .skills-search:focus { border-color: var(--lime-d); box-shadow: 0 0 0 3px rgba(143,212,0,.12); }
        .skills-search-ico { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 14px; height: 14px; stroke: var(--muted); pointer-events: none; }
        .skills-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .skills-table th { font-family: var(--f-mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding: 10px 16px; text-align: left; background: var(--warm); border-bottom: 1px solid var(--line); font-weight: 400; }
        .skills-table td { padding: 11px 16px; border-bottom: 1px solid var(--warm); vertical-align: middle; }
        .skills-table tr:hover td { background: rgba(245,240,232,.6); }
        .sk-cat { font-family: var(--f-mono); font-size: 9px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
        .skill-demand-wrap { display: flex; align-items: center; gap: 8px; }
        .skill-demand-track { width: 60px; height: 4px; background: var(--warm); border-radius: 2px; overflow: hidden; flex-shrink: 0; }
        .skill-demand-fill { height: 100%; border-radius: 2px; background: var(--ink); }
        .skill-demand-num { font-family: var(--f-mono); font-size: 10px; font-weight: 500; color: var(--ink); }
        .res-badge {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .06em;
            padding: 3px 9px; border-radius: 100px; background: rgba(59,127,255,.08);
            border: 1px solid rgba(59,127,255,.2); color: var(--blue);
            display: inline-flex; align-items: center; gap: 4px;
            cursor: pointer; transition: all .14s;
        }
        .res-badge:hover { background: rgba(59,127,255,.14); }
        .sk-del { background: none; border: none; color: var(--line); font-size: 14px; padding: 4px 8px; cursor: pointer; border-radius: var(--r-sm); transition: all .14s; }
        .sk-del:hover { color: var(--red); background: rgba(255,63,63,.06); }

        /* Skill icon cell */
        .sk-icon-cell { display: flex; align-items: center; gap: 10px; }
        .sk-devicon {
            width: 30px; height: 30px; border-radius: var(--r-sm);
            display: flex; align-items: center; justify-content: center;
            background: var(--warm); border: 1px solid var(--line); flex-shrink: 0;
            font-size: 18px; line-height: 1;
        }
        .sk-devicon i { font-size: 18px; line-height: 1; }
        /* fallback for skills without devicon: show a coloured initial */
        .sk-devicon-fallback {
            width: 30px; height: 30px; border-radius: var(--r-sm);
            display: flex; align-items: center; justify-content: center;
            background: var(--ink); color: var(--lime);
            font-family: var(--f-mono); font-size: 11px; font-weight: 700;
            flex-shrink: 0;
        }

        /* ====================================================
           TWO-COL & PROGRESS
           ==================================================== */
        .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
        .progress-track { height: 4px; background: var(--warm); border-radius: 2px; overflow: hidden; }
        .progress-fill { height: 100%; border-radius: 2px; transition: width 1.2s cubic-bezier(.4,0,.2,1); }
        .pf-ink { background: var(--ink); }
        .pf-lime { background: var(--lime-d); }
        .pf-muted { background: var(--muted); }
        .pf-red { background: var(--red); }
        .pf-success { background: var(--success); }
        .pf-primary { background: var(--p1); }
        .pf-warn { background: var(--warn); }

        /* ====================================================
           LIVE ACTIVITY – professional icon tiles
           ==================================================== */
        .live-row {
            display: flex; gap: 14px; padding: 13px 20px;
            border-bottom: 1px solid var(--line); transition: background .12s;
            position: relative; align-items: flex-start;
        }
        .live-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: transparent; transition: background .15s; }
        .live-row:hover { background: var(--paper); }
        .live-row:hover::before { background: var(--lime-d); }

        /* Replaced .live-dot with icon tile */
        .live-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; animation: blink 2s infinite; }
        .live-dot-register { background: #1a7a3a; }
        .live-dot-job { background: var(--blue); }
        .live-dot-apply { background: var(--lime-d); }
        .live-dot-status { background: var(--ink); }
        .live-dot-company { background: #b46400; }
        .live-dot-score { background: var(--lime-d); }

        /* New professional icon tile */
        .live-ico {
            width: 34px; height: 34px; border-radius: var(--r-sm);
            display: inline-flex; align-items: center; justify-content: center;
            flex-shrink: 0; transition: transform .15s;
        }
        .live-ico svg { width: 15px; height: 15px; stroke-width: 2; fill: none; }
        .live-row:hover .live-ico { transform: scale(1.08); }

        .li-register  { background: rgba(26,122,58,.10);  color: var(--success); }
        .li-job       { background: rgba(59,127,255,.10);  color: var(--blue);    }
        .li-apply     { background: rgba(143,212,0,.12);   color: #5a8a00;        }
        .li-status    { background: rgba(15,14,13,.07);    color: var(--ink);     }
        .li-company   { background: rgba(180,100,0,.10);   color: var(--warn);    }
        .li-score     { background: rgba(124,92,255,.10);  color: var(--p2);      }
        .li-default   { background: var(--warm);           color: var(--muted);   }

        .live-t { font-size: 13px; font-weight: 700; margin-bottom: 2px; display: flex; align-items: center; gap: 6px; }
        .live-d { font-size: 12px; color: var(--muted); line-height: 1.5; font-weight: 300; }
        .live-ts { font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .08em; color: var(--line); margin-top: 4px; text-transform: uppercase; }

        /* ====================================================
           DATA TABLE (unchanged)
           ==================================================== */
        .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .data-table th { font-family: var(--f-mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding: 10px 16px; border-bottom: 1px solid var(--line); text-align: left; background: var(--warm); }
        .data-table td { padding: 12px 16px; border-bottom: 1px solid var(--warm); vertical-align: middle; }
        .data-table tr:hover td { background: linear-gradient(to right, rgba(143,212,0,.035), var(--paper), rgba(143,212,0,.035)) !important; }
        .actions-wrap { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
        .approval-age-chip {
            font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .06em;
            padding: 2px 8px; border-radius: 100px; display: inline-flex;
            align-items: center; gap: 4px;
        }
        .age-fresh { background: rgba(26,122,58,.07); color: #1a7a3a; border: 1px solid rgba(26,122,58,.2); }
        .age-aging { background: rgba(180,100,0,.07); color: #b46400; border: 1px solid rgba(180,100,0,.2); }
        .age-old { background: rgba(255,63,63,.07); color: var(--red); border: 1px solid rgba(255,63,63,.2); }
        .accounts-filter-strip {
            display: flex; gap: 6px; align-items: center;
            padding: 10px 16px; border-bottom: 1px solid var(--line);
            background: var(--warm);
        }
        .acf-btn {
            font-family: var(--f-mono); font-size: 9px; letter-spacing: .08em;
            text-transform: uppercase; padding: 4px 12px; border: 1px solid var(--line);
            border-radius: 100px; background: var(--white); color: var(--muted);
            cursor: pointer; transition: all .14px;
        }
        .acf-btn:hover, .acf-btn.on { background: var(--ink); color: var(--paper); border-color: var(--ink); }
        .account-av {
            width: 32px; height: 32px; border-radius: var(--r-sm);
            display: flex; align-items: center; justify-content: center;
            font-family: var(--f-mono); font-size: 10px; font-weight: 700;
        }
        .account-av-student { background: var(--ink); color: var(--lime); }
        .account-av-company { background: var(--lime); color: var(--ink); }

        /* Company logo cell */
        .co-logo {
            width: 32px; height: 32px; border-radius: var(--r-sm);
            display: inline-flex; align-items: center; justify-content: center;
            font-family: var(--f-mono); font-size: 11px; font-weight: 700;
            background: var(--ink); color: var(--lime); flex-shrink: 0;
        }
        .co-cell { display: flex; align-items: center; gap: 10px; }
        .co-cell .co-icon { font-size: 14px; opacity: .8; }

        /* ====================================================
           STUDENT ROW – graduation cap icon (screenshot 4)
           ==================================================== */
        .st-cell { display: flex; align-items: center; gap: 10px; }
        .st-av {
            width: 34px; height: 34px; border-radius: var(--r-sm);
            background: var(--lime); color: var(--ink);
            display: inline-flex; align-items: center; justify-content: center;
            font-family: var(--f-mono); font-size: 11px; font-weight: 700; flex-shrink: 0;
            position: relative;
        }
        /* cap icon overlaid top-right of avatar */
        .st-av-cap {
            position: absolute; top: -5px; right: -5px;
            width: 16px; height: 16px; background: var(--ink);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
        }
        .st-av-cap svg { width: 9px; height: 9px; stroke: var(--lime); stroke-width: 2.2; fill: none; }
        .st-name { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; }

        /* ====================================================
           ANALYTICS
           ==================================================== */
        .bar-list { display: flex; flex-direction: column; gap: 14px; }
        .bar-row-label { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600; margin-bottom: 6px; }
        .bar-row-label span:last-child { font-family: var(--f-mono); font-size: 11px; font-weight: 700; }
        .analytics-section-label {
            font-family: var(--f-mono); font-size: 10px; letter-spacing: .14em;
            text-transform: uppercase; color: var(--muted);
            display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
        }
        .analytics-section-label::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, var(--line), transparent); }
        .three-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
        .m-delta { font-family: var(--f-mono); font-size: 10px; margin-top: 6px; letter-spacing: .04em; }
        .m-delta-up { color: var(--success); }
        .m-delta-down { color: var(--red); }

        /* ====================================================
           NOTICE
           ==================================================== */
        .notice {
            padding: 12px 18px; border-radius: var(--r-sm);
            font-size: 13px; margin-bottom: 16px; border: 1px solid;
        }
        .notice-info { background: rgba(59,127,255,.06); border-color: rgba(59,127,255,.2); color: var(--blue); }

        /* ====================================================
           TABLE SCROLL
           ==================================================== */
        .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

        /* ====================================================
           ANIMATIONS
           ==================================================== */
        @@keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
        @@keyframes orbFloat { 0%,100% { transform: translate(0,0) scale(1); } 33% { transform: translate(8px,-6px) scale(1.05); } 66% { transform: translate(-5px,4px) scale(.97); } }
        .hero-orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(40px); animation: orbFloat 6s ease-in-out infinite; }
        .countup { display: inline-block; }

        /* ====================================================
           RESPONSIVE
           ==================================================== */
        @@media (max-width: 900px) {
            .dash-sidebar { width: 280px; left: -280px; transition: left .25s ease; }
            .dash-sidebar.is-open { left: 0; z-index: 90; box-shadow: var(--shadow-lg); }
            .dash-main { margin-left: 0; }
            .dash-topbar { padding: 0 16px 0 56px; }
            .dash-body { padding: 24px 16px; }
            .two-col, .field-row, .insight-grid, .skills-layout, .three-col { grid-template-columns: 1fr; }
            .v3-metric-grid { grid-template-columns: repeat(2, 1fr); }
            .ap-welcome-banner { flex-direction: column; align-items: flex-start; gap: 16px; }
            .dash-menu-btn {
                display: flex; position: fixed; top: 10px; left: 10px; z-index: 95;
                align-items: center; justify-content: center; width: 44px; height: 44px;
                background: var(--ink); color: var(--paper); border: none;
                border-radius: var(--r-sm); cursor: pointer; flex-direction: column; gap: 5px;
            }
            .dash-menu-btn span { display: block; width: 18px; height: 2px; background: currentColor; border-radius: 1px; }
            .dash-drawer-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 85; }
            .dash-drawer-overlay.is-visible { display: block; }
        }
        @@media (max-width: 640px) {
            .dash-topbar { padding: 0 12px 0 52px; height: 50px; }
            .dash-body { padding: 16px 12px; }
            .v3-metric-grid { grid-template-columns: 1fr; }
            .card-head { padding: 12px 14px; }
            .card-body { padding: 14px; }
            .data-table, .skills-table { min-width: 600px; }
            .toast { left: 12px; right: 12px; bottom: 16px; max-width: none; }
        }
    </style>
</head>
<body>

<div id="toast" class="toast @Model.ToastClass @(string.IsNullOrEmpty(Model.ToastMessage) ? "" : "show")">
    <div class="toast-dot"></div>
    <span id="toast-msg">@Model.ToastMessage</span>
</div>

<div class="dash-shell">
    <button type="button" class="dash-menu-btn" id="dash-menu-btn" aria-label="Open menu"><span></span><span></span><span></span></button>
    <div class="dash-drawer-overlay" id="dash-drawer-overlay" aria-hidden="true"></div>

    <aside class="dash-sidebar" id="dash-sidebar">
            <div class="sidebar-logo" onclick="window.location.href='/" style="display:flex;align-items:center;gap:10px;">
                <div style="width:28px;height:28px;background:var(--ink);border-radius:7px;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                    <svg viewBox="0 0 12 12" style="width:12px;height:12px;stroke:var(--lime);fill:none;stroke-width:2;stroke-linecap:round">
                        <path d="M2 9 L6 3 L10 9" />
                        <path d="M4 7h4" />
                    </svg>
                </div>
                Cogni<span>Career</span>
            </div>        <div class="sb-section">Analytics</div>
        <a href="#" class="sb-link @(Model.ActivePanel == "ad-overview" ? "on" : "")" id="lnk-overview" data-panel="ad-overview">
            <span class="sb-ico" data-feather="activity"></span> Platform Overview
        </a>
        <a href="#" class="sb-link @(Model.ActivePanel == "ad-analytics" ? "on" : "")" id="lnk-analytics" data-panel="ad-analytics">
            <span class="sb-ico" data-feather="bar-chart-2"></span> Analytics
        </a>
        <div class="sb-section">Management</div>
        <a href="#" class="sb-link @(Model.ActivePanel == "ad-companies" ? "on" : "")" id="lnk-companies" data-panel="ad-companies">
            <span class="sb-ico" data-feather="briefcase"></span> Companies
            @if (Model.PendingCompanies.Any()) { <span class="sb-badge">@Model.PendingCompanies.Count</span> }
        </a>
        <a href="#" class="sb-link @(Model.ActivePanel == "ad-skills" ? "on" : "")" id="lnk-skills" data-panel="ad-skills">
            <span class="sb-ico" data-feather="cpu"></span> Skill Library
        </a>
        <a href="#" class="sb-link @(Model.ActivePanel == "ad-users" ? "on" : "")" id="lnk-users" data-panel="ad-users">
            <span class="sb-ico" data-feather="users"></span> Students
        </a>
        <a href="#" class="sb-link @(Model.ActivePanel == "ad-live" ? "on" : "")" id="lnk-live" data-panel="ad-live">
            <span class="sb-ico" data-feather="zap"></span> Live Activity
        </a>
        <div class="sb-foot">
            <div class="sb-user">
                <div class="sb-avatar av-admin">AD</div>
                <div>
                    <div class="sb-uname">@Model.UserName</div>
                    <div class="sb-urole">Administrator</div>
                    <div class="admin-access-chip"><span class="admin-access-chip-dot"></span>Full Access</div>
                </div>
            </div>
            <form method="post" asp-page-handler="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="sb-signout">Sign Out</button>
            </form>
        </div>
    </aside>

    <div class="dash-main">
        <div class="dash-topbar">
            <div class="dash-topbar-title" id="page-title">
                <span data-feather="cpu"></span> Platform Overview
            </div>
            <span class="ap-live-pill"><span class="ap-live-pill-dot"></span>Live</span>
        </div>

        <div class="dash-scroll">
            <div class="dash-content" id="admin-panels">

                <!-- ============================================================
                     OVERVIEW PANEL  –  V3 redesign (matches screenshot 2)
                     Only this block is changed; all other panels are untouched.
                     ============================================================ -->
                <div class="panel @(Model.ActivePanel == "ad-overview" ? "active" : "")" id="ad-overview">
                    <div class="dash-body">

                        <!-- Dark welcome banner (unchanged) -->
                        <div class="ap-welcome-banner">
                            <div class="hero-orb" style="width:220px;height:220px;top:-90px;right:30px;background:rgba(255,63,63,.05);animation-duration:9s;"></div>
                            <div class="hero-orb" style="width:120px;height:120px;bottom:-60px;right:280px;background:rgba(59,127,255,.04);animation-duration:12s;animation-delay:-4s;"></div>
                            <div style="position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:32px 32px;opacity:.7;"></div>
                            <div class="apwb-left" style="position:relative;z-index:1;">
                                <div class="apwb-greeting">
                                    <span data-feather="shield" style="width:14px;height:14px;"></span>
                                    <span>Platform Command Center · Admin</span>
                                    <span style="width:5px;height:5px;border-radius:50%;background:#ff6b6b;display:inline-block;animation:blink 2s infinite;"></span>
                                </div>
                                <div class="apwb-name">Good morning, <em>Administrator</em></div>
                                <div style="font-family:var(--f-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.22);margin-top:6px;">Full Access · CogniCareer HQ · Lahore</div>
                            </div>
                            <div class="apwb-right" style="position:relative;z-index:1;gap:10px;">
                                <div class="apwb-stat">
                                    <!-- graduation cap SVG icon above number -->
                                    <div style="margin-bottom:6px;">
                                        <svg style="width:20px;height:20px;stroke:var(--paper);stroke-width:1.8;fill:none;display:block;margin:0 auto;" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c0 0 2.5 3 6 3s6-3 6-3v-5"/></svg>
                                    </div>
                                    <div class="apwb-stat-val v-paper countup" data-target="@Model.Stats.TotalStudents">0</div>
                                    <div class="apwb-stat-lbl">Students</div>
                                </div>
                                <div class="apwb-stat">
                                    <div style="margin-bottom:6px;">
                                        <svg style="width:20px;height:20px;stroke:var(--lime);stroke-width:1.8;fill:none;display:block;margin:0 auto;" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                                    </div>
                                    <div class="apwb-stat-val v-lime countup" data-target="@Model.Stats.TotalCompanies">0</div>
                                    <div class="apwb-stat-lbl">Companies</div>
                                </div>
                                <div class="apwb-stat" style="border-color:rgba(255,100,100,.3);">
                                    <div style="margin-bottom:6px;">
                                        <svg style="width:20px;height:20px;stroke:#ff6b6b;stroke-width:1.8;fill:none;display:block;margin:0 auto;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                    </div>
                                    <div class="apwb-stat-val v-red countup" data-target="@Model.PendingCompanies.Count">0</div>
                                    <div class="apwb-stat-lbl">Pending</div>
                                </div>
                                <div class="apwb-stat">
                                    <div style="margin-bottom:6px;">
                                        <svg style="width:20px;height:20px;stroke:#7eb3ff;stroke-width:1.8;fill:none;display:block;margin:0 auto;" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                    </div>
                                    <div class="apwb-stat-val v-blue countup" data-target="@Model.Stats.TotalActiveJobs">0</div>
                                    <div class="apwb-stat-lbl">Active Jobs</div>
                                </div>
                            </div>
                        </div>

                        <!-- ── NEW V3 METRIC CARDS (replaces old metric-strip) ── -->
                        <div class="v3-metric-grid">

                            <!-- Students -->
                            <div class="v3-mc mc-students">
                                <div class="v3-mc-icon-row">
                                    <div class="v3-mc-label">
                                        <svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c0 0 2.5 3 6 3s6-3 6-3v-5"/></svg>
                                        Students
                                    </div>
                                    <div class="v3-mc-icon-badge ib-students">
                                        <svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c0 0 2.5 3 6 3s6-3 6-3v-5"/></svg>
                                    </div>
                                </div>
                                <div class="v3-mc-value val-students countup" data-target="@Model.Stats.TotalStudents">0</div>
                                <div class="v3-mc-sub">Registered on platform</div>
                                <div class="v3-mc-divider"></div>
                                <span class="v3-mc-delta delta-up">
                                    <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
                                    + 34 this week
                                </span>
                            </div>

                            <!-- Companies -->
                            <div class="v3-mc mc-companies">
                                <div class="v3-mc-icon-row">
                                    <div class="v3-mc-label">
                                        <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                                        Companies
                                    </div>
                                    <div class="v3-mc-icon-badge ib-companies">
                                        <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                                    </div>
                                </div>
                                <div class="v3-mc-value val-companies countup" data-target="@Model.Stats.TotalCompanies">0</div>
                                <div class="v3-mc-sub">Verified &amp; active</div>
                                <div class="v3-mc-divider"></div>
                                <span class="v3-mc-delta delta-warn">
                                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                    @Model.PendingCompanies.Count pending approval
                                </span>
                            </div>

                            <!-- Active Jobs -->
                            <div class="v3-mc mc-jobs">
                                <div class="v3-mc-icon-row">
                                    <div class="v3-mc-label">
                                        <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                        Active Jobs
                                    </div>
                                    <div class="v3-mc-icon-badge ib-jobs">
                                        <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                    </div>
                                </div>
                                <div class="v3-mc-value val-jobs countup" data-target="@Model.Stats.TotalActiveJobs">0</div>
                                <div class="v3-mc-sub">Across all companies</div>
                                <div class="v3-mc-divider"></div>
