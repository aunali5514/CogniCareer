@page
@model CogniCareer.Pages.Admin.DashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";
    var adminPageTitle = Model.ActivePanel switch
    {
        "ad-companies" => "Companies",
        "ad-skills" => "Skill Library",
        "ad-users" => "Users",
        _ => "Overview"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard — CogniCareer</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#0f0e0d;--ink-2:#1e1c1a;--paper:#f5f0e8;--warm:#ede8e0;--line:#d6cfc4;--muted:#8a847b;--lime:#b8ff35;--lime-d:#8fd400;--red:#ff3f3f;--blue:#3b7fff;--white:#ffffff;--f-serif:'Playfair Display',Georgia,serif;--f-mono:'DM Mono','Courier New',monospace;--f-sans:'Jost',sans-serif;--r-sm:3px;--r:6px;--r-lg:12px;--shadow:0 2px 16px rgba(15,14,13,.08)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{font-size:16px}body{background:var(--paper);color:var(--ink);font-family:var(--f-sans);overflow-x:hidden}
a{text-decoration:none;color:inherit}button{font-family:var(--f-sans);cursor:pointer}
.btn{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:10px 22px;border-radius:var(--r-sm);border:1.5px solid transparent;cursor:pointer;transition:all .16s;white-space:nowrap}
.btn-dark{background:var(--ink);color:var(--paper);border-color:var(--ink)}.btn-dark:hover{background:var(--ink-2)}
.btn-lime{background:var(--lime);color:var(--ink);border-color:var(--lime)}.btn-lime:hover{background:var(--lime-d)}
.btn-ghost{background:transparent;color:var(--muted);border-color:var(--line)}.btn-ghost:hover{border-color:var(--ink);color:var(--ink)}
.btn-red{background:var(--red);color:#fff;border-color:var(--red)}
.btn-sm{font-size:10px;padding:7px 14px}
.btn-w{width:100%;justify-content:center}
.field{margin-bottom:16px}.field-label{display:block;font-family:var(--f-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.field-input,.field-select,.field-textarea{width:100%;padding:11px 14px;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-sm);font-size:14px;color:var(--ink);outline:none}
.field-textarea{resize:vertical;min-height:80px}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.badge{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:var(--r-sm);border:1px solid;display:inline-block}
.badge-default{color:var(--muted);border-color:var(--line);background:var(--warm)}
.badge-lime{color:var(--ink);border-color:var(--lime);background:var(--lime)}
.badge-red{color:var(--red);border-color:rgba(255,63,63,.3);background:rgba(255,63,63,.06)}
.status{font-family:var(--f-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:100px;display:inline-flex;align-items:center;gap:5px}
.st-active{background:rgba(26,122,58,.08);color:#1a7a3a}
.st-reject{background:rgba(255,63,63,.08);color:var(--red)}
.card{background:var(--white);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow)}
.card-head{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--warm)}
.card-title{font-family:var(--f-serif);font-size:15px;font-weight:700}
.card-body{padding:22px}.card-body-p0{padding:0}
.notice{padding:11px 14px;border-radius:var(--r-sm);font-size:12px;margin-bottom:16px}
.notice-info{background:rgba(59,127,255,.06);border:1px solid rgba(59,127,255,.2);color:var(--blue)}
.toast{position:fixed;bottom:28px;right:28px;z-index:9999;padding:14px 20px;background:var(--ink);color:var(--paper);border-radius:var(--r-lg);font-size:13px;display:flex;align-items:center;gap:10px;transform:translateY(80px);opacity:0;transition:all .3s;box-shadow:0 8px 48px rgba(15,14,13,.16);max-width:340px;pointer-events:none}
.toast.show{transform:translateY(0);opacity:1}.toast-dot{width:7px;height:7px;border-radius:50%}
.toast.t-lime .toast-dot{background:var(--lime)}.toast.t-red .toast-dot{background:var(--red)}
.dash-shell{display:flex;height:100vh;overflow:hidden;position:relative}
.dash-sidebar{width:220px;flex:0 0 220px;background:var(--white);border-right:1px solid var(--line);display:flex;flex-direction:column;position:relative;z-index:200;isolation:isolate}
.sidebar-logo{font-family:var(--f-serif);font-size:17px;font-weight:900;padding:20px 22px 16px;border-bottom:1px solid var(--line);cursor:pointer}
.sidebar-logo span{color:var(--red);font-style:italic;font-weight:400}
.sb-section{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--line);padding:18px 22px 6px}
.sb-link{display:flex;align-items:center;gap:10px;padding:9px 22px;font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;border:0;border-left:2px solid transparent;width:100%;text-align:left;background:none;border-radius:0;box-sizing:border-box}
.sb-link:hover{color:var(--ink);background:var(--paper)}
.sb-link.on{color:var(--ink);background:rgba(255,63,63,.05);border-left-color:var(--red);font-weight:700}
.sb-foot{margin-top:auto;padding:14px 16px;border-top:1px solid var(--line)}
.sb-user{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.sb-avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:11px;font-weight:700;background:var(--red);color:#fff}
.sb-uname{font-size:13px;font-weight:700}.sb-urole{font-family:var(--f-mono);font-size:9px;color:var(--muted)}
.sb-signout{width:100%;padding:8px;border:1px solid var(--line);background:transparent;border-radius:var(--r-sm);font-family:var(--f-mono);font-size:9.5px;text-transform:uppercase;color:var(--muted);cursor:pointer}
.sb-signout:hover{background:var(--red);color:#fff;border-color:var(--red)}
.dash-main{flex:1 1 0;min-width:0;overflow:hidden;display:flex;flex-direction:column;position:relative;z-index:1}
.dash-scroll{flex:1;min-width:0;overflow-x:auto;overflow-y:auto;display:flex;flex-direction:column}
.dash-topbar{position:sticky;top:0;z-index:9;height:54px;background:rgba(245,240,232,.95);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px}
.dash-topbar-title{font-family:var(--f-serif);font-size:17px;font-weight:700}
.dash-content{padding:28px;flex:1;min-width:0;display:grid;grid-template-columns:minmax(0,1fr)}
.panel{grid-column:1;grid-row:1;display:none;min-width:0}.panel.active{display:block}
.metric-strip{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;background:var(--white);margin-bottom:22px}
.metric-cell{padding:18px 22px;border-right:1px solid var(--line)}
.metric-cell:last-child{border-right:none}
.m-label{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.m-value{font-family:var(--f-serif);font-size:30px;font-weight:900;letter-spacing:-.04em;line-height:1}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:10px 16px;border-bottom:1px solid var(--line);text-align:left;background:var(--warm)}
.data-table td{padding:12px 16px;border-bottom:1px solid var(--warm);vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.actions-wrap{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.ad-banner{background:var(--ink);border-radius:var(--r-lg);padding:28px 32px;margin-bottom:22px;color:var(--paper)}
.ad-banner h2{font-family:var(--f-serif);font-size:26px;font-weight:900;margin-bottom:6px}
.ad-banner h2 em{color:var(--lime);font-style:italic}
.ad-kicker{font-family:var(--f-mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:8px}
.insight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:22px}
.insight-card{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow)}
.insight-head{padding:14px 18px;border-bottom:1px solid var(--line);background:var(--warm)}
.insight-title{font-family:var(--f-serif);font-size:14px;font-weight:700;letter-spacing:-.01em}
.insight-sub{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:3px}
.insight-body{padding:6px 0}
.insight-row{display:flex;align-items:center;gap:10px;padding:10px 18px;border-bottom:1px solid var(--warm)}
.insight-row:last-child{border-bottom:none}
.insight-rank{font-family:var(--f-mono);font-size:10px;color:var(--muted);width:18px;flex-shrink:0}
.insight-name{flex:1;font-size:13px;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.insight-meta{font-family:var(--f-mono);font-size:9px;color:var(--muted);letter-spacing:.04em}
.insight-bar-wrap{width:56px;height:4px;background:var(--warm);border-radius:2px;overflow:hidden;flex-shrink:0}
.insight-bar{height:100%;background:var(--lime-d);border-radius:2px}
.insight-val{font-family:var(--f-mono);font-size:10px;font-weight:500;color:var(--ink);min-width:32px;text-align:right}
.insight-empty{padding:20px 18px;font-size:12px;color:var(--muted);text-align:center}
.skills-layout{display:grid;grid-template-columns:320px 1fr;gap:20px;align-items:start}
.skills-add-card{position:static}
.skills-search-wrap{position:relative;margin-bottom:14px}
.skills-search{width:100%;padding:10px 14px 10px 36px;border:1.5px solid var(--line);border-radius:var(--r-sm);font-size:13px;background:var(--white);outline:none}
.skills-search:focus{border-color:var(--lime-d);box-shadow:0 0 0 3px rgba(143,212,0,.12)}
.skills-search-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:14px;opacity:.4;pointer-events:none}
.skills-table{width:100%;border-collapse:collapse;font-size:13px}
.skills-table th{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:10px 16px;text-align:left;background:var(--warm);border-bottom:1px solid var(--line);font-weight:400}
.skills-table td{padding:11px 16px;border-bottom:1px solid var(--warm);vertical-align:middle}
.skills-table tr:last-child td{border-bottom:none}
.skills-table tr:hover td{background:rgba(245,240,232,.6)}
.sk-cat{font-family:var(--f-mono);font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.sk-del{background:none;border:none;color:var(--line);font-size:14px;padding:4px 8px;cursor:pointer;border-radius:var(--r-sm);transition:all .14s}
.sk-del:hover{color:var(--red);background:rgba(255,63,63,.06)}
@@media(max-width:1100px){.insight-grid{grid-template-columns:1fr}.skills-layout{grid-template-columns:1fr}}
</style>
</head>
<body>
<div id="toast" class="toast @Model.ToastClass @(string.IsNullOrEmpty(Model.ToastMessage) ? "" : "show")"><div class="toast-dot"></div><span id="toast-msg">@Model.ToastMessage</span></div>

<div class="dash-shell">
  <aside class="dash-sidebar">
    <div class="sidebar-logo" onclick="window.location.href='/'">Cogni<span>Career</span></div>
    <div class="sb-section">Administration</div>
    <a href="#" class="sb-link @(Model.ActivePanel == "ad-overview" ? "on" : "")" id="lnk-overview" data-panel="ad-overview"><span>📊</span> Overview</a>
    <a href="#" class="sb-link @(Model.ActivePanel == "ad-companies" ? "on" : "")" id="lnk-companies" data-panel="ad-companies"><span>🏢</span> Companies @if (Model.PendingCompanies.Any()) { <span class="badge badge-red" style="margin-left:auto">@Model.PendingCompanies.Count</span> }</a>
    <a href="#" class="sb-link @(Model.ActivePanel == "ad-skills" ? "on" : "")" id="lnk-skills" data-panel="ad-skills"><span>⚡</span> Skill Library</a>
    <a href="#" class="sb-link @(Model.ActivePanel == "ad-users" ? "on" : "")" id="lnk-users" data-panel="ad-users"><span>👥</span> Users</a>
    <div class="sb-foot">
      <div class="sb-user">
        <div class="sb-avatar">AD</div>
        <div>
          <div class="sb-uname">@Model.UserName</div>
          <div class="sb-urole">Administrator</div>
        </div>
      </div>
      <form method="post" asp-page-handler="Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="sb-signout">Sign Out</button>
      </form>
    </div>
  </aside>

  <div class="dash-main">
    <div class="dash-topbar">
      <div class="dash-topbar-title" id="page-title">@adminPageTitle</div>
      <span class="badge badge-default">@DateTime.Now.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="dash-scroll">
    <div class="dash-content" id="admin-panels">

      <div class="panel @(Model.ActivePanel == "ad-overview" ? "active" : "")" id="ad-overview">
        <div class="ad-banner">
          <div class="ad-kicker">Admin Panel</div>
          <h2>Platform <em>Control</em></h2>
        </div>
        <div class="metric-strip">
          <div class="metric-cell"><div class="m-label">Students</div><div class="m-value">@Model.Stats.TotalStudents</div></div>
          <div class="metric-cell"><div class="m-label">Companies</div><div class="m-value">@Model.Stats.TotalCompanies</div></div>
          <div class="metric-cell"><div class="m-label">Active Jobs</div><div class="m-value">@Model.Stats.TotalActiveJobs</div></div>
          <div class="metric-cell"><div class="m-label">Applications</div><div class="m-value">@Model.Stats.TotalApplications</div></div>
        </div>
        @if (Model.PendingCompanies.Any())
        {
          <div class="notice notice-info">@Model.PendingCompanies.Count company account(s) awaiting approval. <a onclick="sw('ad-companies','Companies')" style="text-decoration:underline;cursor:pointer">Review now →</a></div>
        }
        @await Html.PartialAsync("_AdminInsights", Model)
      </div>

      <div class="panel @(Model.ActivePanel == "ad-companies" ? "active" : "")" id="ad-companies">
        <div class="card" style="margin-bottom:20px">
          <div class="card-head"><span class="card-title">Pending Approvals</span><span class="badge badge-red">@Model.PendingCompanies.Count pending</span></div>
          <div class="card-body-p0">
            @if (!Model.PendingCompanies.Any())
            {
              <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">No pending company registrations.</div>
            }
            <table class="data-table">
              <thead><tr><th>Company</th><th>Industry</th><th>Website</th><th>Actions</th></tr></thead>
              <tbody>
                @foreach (var co in Model.PendingCompanies)
                {
                  <tr>
                    <td><strong>@co.CompanyName</strong></td>
                    <td>@co.Industry</td>
                    <td style="font-family:var(--f-mono);font-size:11px">@(string.IsNullOrEmpty(co.Website) ? "—" : co.Website)</td>
                    <td>
                      <div class="actions-wrap">
                        <form method="post" asp-page-handler="ApproveCompany" style="display:inline">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="companyId" value="@co.CompanyID">
                          <button type="submit" class="btn btn-lime btn-sm">Approve</button>
                        </form>
                        <form method="post" asp-page-handler="RejectCompany" style="display:inline">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="companyId" value="@co.CompanyID">
                          <button type="submit" class="btn btn-red btn-sm">Reject</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-head"><span class="card-title">All Companies</span><span class="badge badge-default">@Model.AllCompanies.Count total</span></div>
          <div class="card-body-p0">
            <table class="data-table">
              <thead><tr><th>Company</th><th>Industry</th><th>Status</th></tr></thead>
              <tbody>
                @foreach (var co in Model.AllCompanies)
                {
                  <tr>
                    <td><strong>@co.CompanyName</strong></td>
                    <td>@co.Industry</td>
                    <td><span class="status @(co.IsApproved ? "st-active" : "st-reject")">@(co.IsApproved ? "Approved" : "Pending")</span></td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="panel @(Model.ActivePanel == "ad-skills" ? "active" : "")" id="ad-skills">
        @await Html.PartialAsync("_AdminSkillLibrary", Model)
      </div>

      <div class="panel @(Model.ActivePanel == "ad-users" ? "active" : "")" id="ad-users">
        <div class="card">
          <div class="card-head"><span class="card-title">User Accounts</span><span class="badge badge-default">@Model.AllUsers.Count users</span></div>
          <div class="card-body-p0">
            <table class="data-table">
              <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody>
                @foreach (var u in Model.AllUsers)
                {
                  <tr>
                    <td><strong>@u.FullName</strong></td>
                    <td style="font-family:var(--f-mono);font-size:11px">@u.Email</td>
                    <td><span class="badge badge-default">@u.Role</span></td>
                    <td><span class="status @(u.IsActive ? "st-active" : "st-reject")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                      <div class="actions-wrap">
                        @if (u.IsActive)
                        {
                          <form method="post" asp-page-handler="ToggleUser" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserID">
                            <input type="hidden" name="isActive" value="false">
                            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--red)">Deactivate</button>
                          </form>
                        }
                        else
                        {
                          <form method="post" asp-page-handler="ToggleUser" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserID">
                            <input type="hidden" name="isActive" value="true">
                            <button type="submit" class="btn btn-lime btn-sm">Activate</button>
                          </form>
                        }
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
    </div>
  </div>
</div>

<script>
var adminPanelTitles = {'ad-overview':'Overview','ad-companies':'Companies','ad-skills':'Skill Library','ad-users':'Users'};

function sw(panelId, title) {
  var panels = document.querySelectorAll('#admin-panels .panel');
  panels.forEach(function(p) {
    p.classList.remove('active');
    p.setAttribute('inert', '');
  });
  var el = document.getElementById(panelId);
  if (el) {
    el.classList.add('active');
    el.removeAttribute('inert');
  }
  document.querySelectorAll('.dash-sidebar .sb-link').forEach(function(l){ l.classList.remove('on'); });
  var lnkMap = {'ad-overview':'lnk-overview','ad-companies':'lnk-companies','ad-skills':'lnk-skills','ad-users':'lnk-users'};
  var lnk = document.getElementById(lnkMap[panelId]);
  if (lnk) lnk.classList.add('on');
  var heading = document.getElementById('page-title');
  if (heading) heading.textContent = title || adminPanelTitles[panelId] || 'Dashboard';
}

function showToast(msg, cls) {
  var t = document.getElementById('toast');
  if (!t) return;
  var msgEl = document.getElementById('toast-msg');
  if (msgEl) msgEl.textContent = msg;
  t.className = 'toast ' + (cls || 't-lime');
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 3200);
}

function filterSkillLib(q) {
  q = (q || '').toLowerCase().trim();
  document.querySelectorAll('#skill-lib-table tbody tr').forEach(function(row) {
    var name = row.getAttribute('data-name') || '';
    var cat = row.getAttribute('data-cat') || '';
    row.style.display = (!q || name.indexOf(q) >= 0 || cat.indexOf(q) >= 0) ? '' : 'none';
  });
}

document.addEventListener('DOMContentLoaded', function() {
  var active = document.querySelector('#admin-panels .panel.active');
  document.querySelectorAll('#admin-panels .panel').forEach(function(p) {
    if (p === active) p.removeAttribute('inert');
    else p.setAttribute('inert', '');
  });

  var sidebar = document.querySelector('.dash-sidebar');
  if (sidebar) {
    sidebar.addEventListener('click', function(e) {
      var link = e.target.closest('a[data-panel]');
      if (!link) return;
      e.preventDefault();
      var panelId = link.getAttribute('data-panel');
      sw(panelId, adminPanelTitles[panelId]);
    });
  }

  var toast = document.getElementById('toast');
  if (toast && toast.classList.contains('show')) {
    setTimeout(function(){ toast.classList.remove('show'); }, 3200);
  }
});
</script>
</body>
</html>
