<script>
    feather.replace();

    /* ----------------------------------------------------------------
       Panel switching
    ---------------------------------------------------------------- */
    function sw(panelId, title) {
        var panels = document.querySelectorAll('#admin-panels .panel');
        panels.forEach(function(p) { p.classList.remove('active'); p.setAttribute('inert', ''); });
        var el = document.getElementById(panelId);
        if (el) { el.classList.add('active'); el.removeAttribute('inert'); }
        document.querySelectorAll('.dash-sidebar .sb-link').forEach(function(l) { l.classList.remove('on'); });
        var lnkMap = { 'ad-overview':'lnk-overview', 'ad-analytics':'lnk-analytics', 'ad-companies':'lnk-companies', 'ad-skills':'lnk-skills', 'ad-users':'lnk-users', 'ad-live':'lnk-live' };
        var lnk = document.getElementById(lnkMap[panelId]);
        if (lnk) lnk.classList.add('on');
        var iconMap = { 'ad-analytics':'bar-chart-2', 'ad-companies':'briefcase', 'ad-skills':'cpu', 'ad-users':'users', 'ad-live':'zap', 'ad-overview':'cpu' };
        var titleMap = { 'ad-overview':'Platform Overview', 'ad-analytics':'Analytics', 'ad-companies':'Companies', 'ad-skills':'Skill Library', 'ad-users':'Students', 'ad-live':'Live Activity' };
        var heading = document.getElementById('page-title');
        if (heading) heading.innerHTML = '<span data-feather="' + (iconMap[panelId] || 'cpu') + '"></span> ' + (title || titleMap[panelId] || panelId);
        feather.replace();
    }

    function showToast(msg, cls) {
        var t = document.getElementById('toast');
        if (!t) return;
        var msgEl = document.getElementById('toast-msg');
        if (msgEl) msgEl.textContent = msg;
        t.className = 'toast ' + (cls || 't-lime');
        t.classList.add('show');
        setTimeout(function(){ t.classList.remove('show'); }, 3200);
    }

    /* ----------------------------------------------------------------
       Mobile drawer
    ---------------------------------------------------------------- */
    (function initDashDrawer() {
        var btn = document.getElementById('dash-menu-btn');
        var sidebar = document.getElementById('dash-sidebar');
        var overlay = document.getElementById('dash-drawer-overlay');
        if (!btn || !sidebar || !overlay) return;
        function openDrawer() { sidebar.classList.add('is-open'); overlay.classList.add('is-visible'); overlay.setAttribute('aria-hidden','false'); btn.setAttribute('aria-expanded','true'); }
        function closeDrawer() { sidebar.classList.remove('is-open'); overlay.classList.remove('is-visible'); overlay.setAttribute('aria-hidden','true'); btn.setAttribute('aria-expanded','false'); }
        btn.addEventListener('click', function() { if (sidebar.classList.contains('is-open')) closeDrawer(); else openDrawer(); });
        overlay.addEventListener('click', closeDrawer);
        document.querySelectorAll('.dash-sidebar .sb-link').forEach(function(link) { link.addEventListener('click', closeDrawer); });
    })();

    document.addEventListener('DOMContentLoaded', function() {
        var active = document.querySelector('#admin-panels .panel.active');
        document.querySelectorAll('#admin-panels .panel').forEach(function(p) {
            if (p === active) p.removeAttribute('inert');
            else p.setAttribute('inert', '');
        });
        var sidebar = document.querySelector('.dash-sidebar');
        if (sidebar) {
            sidebar.addEventListener('click', function(e) {
                var link = e.target.closest('a[data-panel]');
                if (!link) return;
                e.preventDefault();
                sw(link.getAttribute('data-panel'), null);
            });
        }
        var toast = document.getElementById('toast');
        if (toast && toast.classList.contains('show')) {
            setTimeout(function(){ toast.classList.remove('show'); }, 3200);
        }
    });

    /* ----------------------------------------------------------------
       Live activity polling (unchanged)
    ---------------------------------------------------------------- */
    var lastActivityTicks = @(Model.RecentActivities.Any() ? Model.RecentActivities.Max(a => a.OccurredAt).Ticks : DateTime.UtcNow.Ticks);

    /* Map dot-class → live-ico class + feather icon name */
    var liveIconMap = {
        'live-dot-register': { cls: 'li-register', icon: 'user-plus' },
        'live-dot-job':      { cls: 'li-job',      icon: 'briefcase' },
        'live-dot-apply':    { cls: 'li-apply',    icon: 'file-text' },
        'live-dot-status':   { cls: 'li-status',   icon: 'check-circle' },
        'live-dot-company':  { cls: 'li-company',  icon: 'building' },
        'live-dot-score':    { cls: 'li-score',    icon: 'award' }
    };

    function formatActivityTime(ticks) {
        var d = new Date(ticks);
        var diff = (Date.now() - d.getTime()) / 1000;
        if (diff < 120) return 'JUST NOW';
        if (diff < 3600) return Math.floor(diff/60) + 'M AGO';
        if (diff < 86400) return Math.floor(diff/3600) + 'H AGO';
        return d.toLocaleString(undefined,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}).toUpperCase();
    }

    function buildLiveIco(dotClass) {
        var m = liveIconMap[dotClass] || { cls: 'li-default', icon: 'activity' };
        return '<div class="live-ico ' + m.cls + '" data-feather="' + m.icon + '"></div>';
    }

    function prependLiveActivity(ev) {
        var feed = document.getElementById('live-feed');
        if (!feed) return;
        var empty = document.getElementById('live-feed-empty');
        if (empty) empty.remove();
        if (feed.querySelector('[data-ticks="' + ev.occurredAtTicks + '"]')) return;
        var row = document.createElement('div');
        row.className = 'live-row';
        row.setAttribute('data-ticks', ev.occurredAtTicks);
        row.style.opacity = '0';
        row.style.transition = 'opacity .4s';
        row.innerHTML = buildLiveIco(ev.dotClass) +
            '<div><div class="live-t">' + ev.title + '</div>' +
            '<div class="live-d">' + ev.description + '</div>' +
            '<div class="live-ts">' + formatActivityTime(ev.occurredAtTicks) + '</div></div>';
        feed.insertBefore(row, feed.firstChild);
        feather.replace();
        setTimeout(function(){ row.style.opacity = '1'; }, 20);
        while (feed.children.length > 30) feed.removeChild(feed.lastChild);
        if (ev.occurredAtTicks > lastActivityTicks) lastActivityTicks = ev.occurredAtTicks;
    }

    function pollLiveActivity() {
        fetch(window.location.pathname + '?handler=ActivityFeed&afterTicks=' + lastActivityTicks, { headers: { 'Accept': 'application/json' } })
            .then(function(r){ return r.ok ? r.json() : []; })
            .then(function(events){
                if (!Array.isArray(events) || !events.length) return;
                events.slice().reverse().forEach(prependLiveActivity);
            })
            .catch(function(){});
    }
    setInterval(pollLiveActivity, 5000);

    /* ----------------------------------------------------------------
       Count-up on load
    ---------------------------------------------------------------- */
    (function(){
        function countUp(el, target, dur) {
            dur = dur || 1100;
            var start = performance.now();
            (function step(now) {
                var p = Math.min((now - start) / dur, 1);
                var ease = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(ease * target) + (el.dataset.suffix || '');
                if (p < 1) requestAnimationFrame(step);
            })(performance.now());
        }
        function runCounters() {
            document.querySelectorAll('.countup:not([data-done])').forEach(function(el) {
                el.dataset.done = '1';
                countUp(el, parseInt(el.dataset.target || el.textContent) || 0);
            });
        }
        window.addEventListener('load', runCounters);
    })();
</script>

</body>
</html>
