@page
@model CogniCareer.Pages.Company.DashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Company Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Company Dashboard — CogniCareer</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#0f0e0d;--ink-2:#1e1c1a;--paper:#f5f0e8;--warm:#ede8e0;--line:#d6cfc4;--muted:#8a847b;--lime:#b8ff35;--lime-d:#8fd400;--red:#ff3f3f;--blue:#3b7fff;--white:#ffffff;--f-serif:'Playfair Display',Georgia,serif;--f-mono:'DM Mono','Courier New',monospace;--f-sans:'Jost',sans-serif;--r-sm:3px;--r:6px;--r-lg:12px;--shadow:0 2px 16px rgba(15,14,13,.08);--shadow-lg:0 8px 48px rgba(15,14,13,.16)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{font-size:16px}body{background:var(--paper);color:var(--ink);font-family:var(--f-sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}button{font-family:var(--f-sans);cursor:pointer}
h1,h2,h3,h4{font-family:var(--f-serif);font-weight:700;line-height:1.05;letter-spacing:-.03em}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--warm)}::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--lime-d)}
::selection{background:var(--lime);color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:7px;font-family:var(--f-sans);font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:10px 22px;border-radius:var(--r-sm);border:1.5px solid transparent;cursor:pointer;transition:all .16s;white-space:nowrap;user-select:none}
.btn-dark{background:var(--ink);color:var(--paper);border-color:var(--ink)}.btn-dark:hover{background:var(--ink-2);transform:translateY(-2px)}
.btn-lime{background:var(--lime);color:var(--ink);border-color:var(--lime)}.btn-lime:hover{background:var(--lime-d);transform:translateY(-2px);box-shadow:0 8px 28px rgba(143,212,0,.35)}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--ink)}.btn-outline:hover{background:var(--ink);color:var(--paper)}
.btn-ghost{background:transparent;color:var(--muted);border-color:var(--line)}.btn-ghost:hover{border-color:var(--ink);color:var(--ink)}
.btn-red{background:var(--red);color:#fff;border-color:var(--red)}
.btn-sm{font-size:10px;padding:7px 14px;letter-spacing:.06em}
.btn-w{width:100%;justify-content:center}
.field{margin-bottom:18px}.field-label{display:block;font-family:var(--f-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.field-input,.field-select,.field-textarea{width:100%;padding:11px 14px;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-sm);font-family:var(--f-sans);font-size:14px;color:var(--ink);outline:none;transition:border-color .15s;appearance:none}
.field-input:focus,.field-select:focus,.field-textarea:focus{border-color:var(--lime-d)!important;box-shadow:0 0 0 3px rgba(143,212,0,.15)!important}
.field-textarea{resize:vertical;min-height:90px}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.badge{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:var(--r-sm);border:1px solid;display:inline-block;white-space:nowrap}
.badge-default{color:var(--muted);border-color:var(--line);background:var(--warm)}
.badge-dark{color:var(--paper);border-color:var(--ink);background:var(--ink)}
.badge-lime{color:var(--ink);border-color:var(--lime);background:var(--lime)}
.badge-red{color:var(--red);border-color:rgba(255,63,63,.3);background:rgba(255,63,63,.06)}
.status{font-family:var(--f-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:100px;display:inline-flex;align-items:center;gap:5px}
.status::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0}
.st-active{background:rgba(26,122,58,.08);color:#1a7a3a}.st-active::before{background:#1a7a3a}
.st-pending{background:rgba(180,100,0,.08);color:#b46400}.st-pending::before{background:#b46400}
.st-review{background:rgba(59,127,255,.08);color:var(--blue)}.st-review::before{background:var(--blue)}
.st-reject{background:rgba(255,63,63,.08);color:var(--red)}.st-reject::before{background:var(--red)}
.card{background:var(--white);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow)}
.card-head{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;background:linear-gradient(135deg,var(--warm),rgba(245,240,232,.5))!important}
.card-title{font-family:var(--f-serif);font-size:15px;font-weight:700;letter-spacing:-.01em}
.card-body{padding:22px}
.card-body-p0{padding:0}
.notice{padding:11px 14px;border-radius:var(--r-sm);font-size:12px;line-height:1.5;margin-bottom:16px}
.notice-ok{background:rgba(26,122,58,.06);border:1px solid rgba(26,122,58,.2);color:#1a7a3a}
.notice-warn{background:rgba(255,63,63,.05);border:1px solid rgba(255,63,63,.2);color:var(--red)}
.notice-info{background:rgba(59,127,255,.06);border:1px solid rgba(59,127,255,.2);color:var(--blue)}
.toast{position:fixed;bottom:28px;right:28px;z-index:9999;padding:14px 20px;background:var(--ink);color:var(--paper);border-radius:var(--r-lg);font-size:13px;font-weight:500;display:flex;align-items:center;gap:10px;transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1);box-shadow:var(--shadow-lg);max-width:340px;pointer-events:none;border:1px solid rgba(255,255,255,.09);backdrop-filter:blur(14px)}
.toast.show{transform:translateY(0);opacity:1}.toast-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.toast.t-lime .toast-dot{background:var(--lime)}.toast.t-red .toast-dot{background:var(--red)}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.dash-shell{display:flex;height:100vh;overflow:hidden}
.dash-sidebar{width:220px;flex-shrink:0;background:var(--white);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow-y:auto}
.sidebar-logo{font-family:var(--f-serif);font-size:17px;font-weight:900;letter-spacing:-.04em;padding:20px 22px 16px;border-bottom:1px solid var(--line);cursor:pointer;user-select:none}
.sidebar-logo span{color:var(--lime-d);font-style:italic;font-weight:400}
.sb-section{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--line);padding:18px 22px 6px}
.sb-link{display:flex;align-items:center;gap:10px;padding:9px 22px;font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;transition:all .14s;border-left:2px solid transparent}
.sb-link:hover{color:var(--ink);background:var(--paper)}
.sb-link.on{color:var(--ink);background:linear-gradient(to right,rgba(143,212,0,.07),transparent)!important;border-left:2.5px solid var(--lime-d)!important;font-weight:700}
.sb-ico{width:20px;height:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sb-foot{margin-top:auto;padding:14px 16px;border-top:1px solid var(--line)}
.sb-user{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.sb-avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:11px;font-weight:700;flex-shrink:0;background:var(--lime);color:var(--ink)}
.sb-uname{font-size:13px;font-weight:700;letter-spacing:-.01em}
.sb-urole{font-family:var(--f-mono);font-size:9px;color:var(--muted);letter-spacing:.04em}
.sb-signout{width:100%;padding:8px;border:1px solid var(--line);background:transparent;border-radius:var(--r-sm);font-family:var(--f-mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);cursor:pointer;transition:all .14s}
.sb-signout:hover{background:var(--red);color:#fff;border-color:var(--red)}
.dash-main{flex:1;overflow-y:auto;display:flex;flex-direction:column}
.dash-topbar{position:sticky;top:0;z-index:9;height:54px;background:rgba(245,240,232,.95)!important;backdrop-filter:blur(18px)!important;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;flex-shrink:0}
.dash-topbar-title{font-family:var(--f-serif);font-size:17px;font-weight:700;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}
.dash-topbar-title::before{content:'';width:3px;height:18px;background:var(--lime-d);border-radius:2px;display:inline-block}
.dash-content{padding:28px;flex:1}
.panel{display:none}.panel.active{display:block;animation:pageReveal .35s cubic-bezier(.4,0,.2,1) both}
@@keyframes pageReveal{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.metric-strip{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;background:var(--white);margin-bottom:22px}
.metric-cell{padding:18px 22px;border-right:1px solid var(--line);position:relative}
.metric-cell:last-child{border-right:none}
.m-label{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.m-value{font-family:var(--f-serif);font-size:30px;font-weight:900;letter-spacing:-.04em;line-height:1;margin-bottom:4px}
.m-sub{font-size:11px;color:var(--muted);font-family:var(--f-mono)}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:10px 16px;border-bottom:1px solid var(--line);text-align:left;background:var(--warm);font-weight:400}
.data-table td{padding:12px 16px;border-bottom:1px solid var(--warm);vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:var(--paper)}
.data-table .actions-cell{white-space:nowrap;min-width:200px}
.actions-wrap{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.cp-welcome-banner{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;margin-bottom:22px;background:var(--ink);border-radius:var(--r-lg);position:relative;overflow:hidden;background-image:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,.007) 3px,rgba(255,255,255,.007) 4px)}
.cpwb-name{font-family:var(--f-serif);font-size:20px;font-weight:900;letter-spacing:-.03em;color:var(--paper);line-height:1.1}
.cpwb-name em{color:var(--lime);font-style:italic;font-weight:400}
.cpwb-greeting{font-family:var(--f-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:4px}
.cpwb-right{display:flex;align-items:center;gap:14px}
.cpwb-stat{text-align:center;padding:8px 16px;border:1px solid rgba(255,255,255,.08);border-radius:var(--r-sm)}
.cpwb-stat-val{font-family:var(--f-serif);font-size:22px;font-weight:900;letter-spacing:-.04em;color:var(--lime);line-height:1}
.cpwb-stat-lbl{font-family:var(--f-mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-top:3px}
.appl-row{display:flex;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);transition:background .15s}
.appl-row:hover{background:var(--paper)}
.appl-row:last-child{border-bottom:none}
.appl-rank{font-family:var(--f-serif);font-size:13px;font-weight:900;color:var(--muted);width:28px;flex-shrink:0}
.appl-av{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:11px;font-weight:700;flex-shrink:0;background:var(--ink);color:var(--lime)}
.appl-score{font-family:var(--f-serif);font-size:18px;font-weight:900;letter-spacing:-.04em;padding:4px 10px;border-radius:var(--r-sm);flex-shrink:0}
.appl-score-tier-high{color:#1a7a3a;background:rgba(26,122,58,.08)}
.appl-score-tier-mid{color:#b46400;background:rgba(180,100,0,.08)}
.appl-score-tier-low{color:var(--muted);background:var(--warm)}
.appl-actions{display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap}
.appl-skills-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
.appl-skill-tag{font-family:var(--f-mono);font-size:8px;letter-spacing:.06em;padding:2px 7px;border-radius:100px;background:var(--warm);border:1px solid var(--line);color:var(--muted)}
.skill-chip-added{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;background:rgba(143,212,0,.12);border:1px solid rgba(143,212,0,.3);font-size:11px;font-weight:600;color:var(--lime-d);margin:2px}
.pj-skills-list{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;min-height:32px;padding:8px;border:1px dashed var(--line);border-radius:var(--r-sm)}
.skill-dd-wrap{position:relative}
.skill-dd{position:absolute;left:0;right:0;top:100%;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow-lg);z-index:100;display:none;max-height:200px;overflow-y:auto}
.skill-opt{display:flex;align-items:center;justify-content:space-between;padding:9px 14px;cursor:pointer;transition:background .12s}
.skill-opt:hover{background:var(--lime)!important;color:var(--ink)}
.skill-opt-name{font-size:13px;font-weight:600}
.skill-opt-cat{font-family:var(--f-mono);font-size:9px;color:var(--muted);letter-spacing:.06em}
.cp-stat-row{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:var(--r-sm);overflow:hidden;margin-bottom:24px;background:var(--warm)}
.cp-stat-cell{padding:14px 18px;border-right:1px solid var(--line);text-align:center;position:relative;overflow:hidden}
.cp-stat-cell:last-child{border-right:none}
.cp-stat-cell::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,var(--lime-d),transparent);opacity:0;transition:opacity .2s}
.cp-stat-cell:hover::before{opacity:1}
.cp-stat-val{font-family:var(--f-serif);font-size:24px;font-weight:900;letter-spacing:-.04em;line-height:1;margin-bottom:3px}
.cp-stat-lbl{font-family:var(--f-mono);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
@@keyframes pageReveal{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
</style>
</head>
<body>
<div id="toast" class="toast"><div class="toast-dot"></div><span id="toast-msg"></span></div>

<div class="dash-shell">
  <aside class="dash-sidebar">
    <div class="sidebar-logo" onclick="window.location.href='/'">Cogni<span>Career</span></div>
    <div class="sb-section">Company</div>
    <a class="sb-link on" id="lnk-overview" onclick="sw('cp-overview','Overview')"><span class="sb-ico">📊</span>Overview</a>
    <a class="sb-link" id="lnk-post" onclick="sw('cp-post','Post a Job')"><span class="sb-ico">➕</span>Post Job</a>
    <a class="sb-link" id="lnk-jobs" onclick="sw('cp-jobs','My Jobs')"><span class="sb-ico">💼</span>My Jobs</a>
    <a class="sb-link" id="lnk-applicants" onclick="sw('cp-applicants','Applicants')"><span class="sb-ico">👥</span>Applicants</a>
    <a class="sb-link" id="lnk-profile" onclick="sw('cp-profile','Company Profile')"><span class="sb-ico">🏢</span>Profile</a>
    <div class="sb-foot">
      <div class="sb-user">
        <div class="sb-avatar">@Model.Initials</div>
        <div>
          <div class="sb-uname">@Model.CompanyName</div>
          <div class="sb-urole">Company</div>
        </div>
      </div>
      <form method="post" asp-page-handler="Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="sb-signout">Sign Out</button>
      </form>
    </div>
  </aside>

  <div class="dash-main">
    <div class="dash-topbar">
      <div class="dash-topbar-title" id="page-title">Overview</div>
      <span class="badge badge-default">@DateTime.Now.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="dash-content">

      <!-- ── OVERVIEW ── -->
      <div class="panel active" id="cp-overview">
        <div class="cp-welcome-banner">
          <div>
            <div class="cpwb-greeting">Company Dashboard</div>
            <div class="cpwb-name"><em>@Model.CompanyName</em> — Hire smarter.</div>
          </div>
          <div class="cpwb-right">
            <div class="cpwb-stat"><div class="cpwb-stat-val">@Model.TotalJobs</div><div class="cpwb-stat-lbl">Active Jobs</div></div>
            <div class="cpwb-stat"><div class="cpwb-stat-val">@Model.TotalApplications</div><div class="cpwb-stat-lbl">Applicants</div></div>
            <div class="cpwb-stat"><div class="cpwb-stat-val">@Model.AvgMatchScore%</div><div class="cpwb-stat-lbl">Avg Match</div></div>
          </div>
        </div>
        <div class="metric-strip">
          <div class="metric-cell"><div class="m-label">Active Jobs</div><div class="m-value">@Model.TotalJobs</div><div class="m-sub">posted</div></div>
          <div class="metric-cell"><div class="m-label">Total Applicants</div><div class="m-value">@Model.TotalApplications</div><div class="m-sub">across all jobs</div></div>
          <div class="metric-cell"><div class="m-label">Shortlisted</div><div class="m-value" style="color:var(--lime-d)">@Model.ShortlistedCount</div><div class="m-sub">in pipeline</div></div>
          <div class="metric-cell"><div class="m-label">Avg Match Score</div><div class="m-value">@Model.AvgMatchScore%</div><div class="m-sub">platform avg</div></div>
        </div>
        <div class="card">
          <div class="card-head"><span class="card-title">My Active Jobs</span><button class="btn btn-lime btn-sm" onclick="sw('cp-post','Post a Job')">+ Post Job</button></div>
          <div class="card-body-p0">
            @if (!Model.Jobs.Any())
            {
              <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">No jobs posted yet. <a onclick="sw('cp-post','Post a Job')" style="color:var(--ink);text-decoration:underline;cursor:pointer">Post your first job →</a></div>
            }
            <table class="data-table">
              <thead><tr><th>Job Title</th><th>Type</th><th>Applicants</th><th>Deadline</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody>
                @foreach (var job in Model.Jobs)
                {
                  var apps = Model.GetApplicationsByJob(job.JobID);
                  var daysLeft = (job.Deadline - DateTime.Now).Days;
                  var deadlineClass = daysLeft <= 3 ? "color:var(--red);font-weight:700" : daysLeft <= 7 ? "color:#b46400" : "";
                  <tr>
                    <td><strong>@job.Title</strong></td>
                    <td><span class="badge badge-default">@job.JobType</span></td>
                    <td><strong>@apps.Count</strong></td>
                    <td><span style="font-family:var(--f-mono);font-size:11px;@deadlineClass">@job.Deadline.ToString("MMM dd")</span></td>
                    <td><span class="status @(string.Equals(job.Status, "Closed", StringComparison.OrdinalIgnoreCase) ? "st-reject" : "st-active")">@job.Status</span></td>
                    <td class="actions-cell">
                      <div class="actions-wrap">
                        <button class="btn btn-ghost btn-sm" onclick="loadApplicants(@job.JobID,'@job.Title')">View Applicants</button>
                        @if (!string.Equals(job.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                        {
                          <form method="post" asp-page-handler="CloseJob" style="display:inline" onsubmit="return confirm('Close this job? Students will no longer be able to apply.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="jobId" value="@job.JobID" />
                            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--red)">Close Job</button>
                          </form>
                        }
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ── POST JOB ── -->
      <div class="panel" id="cp-post">
        <div style="background:var(--ink);border-radius:var(--r-lg);padding:32px;margin-bottom:22px;position:relative;overflow:hidden;background-image:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,.007) 3px,rgba(255,255,255,.007) 4px)">
          <div style="position:absolute;right:-20px;top:-20px;width:140px;height:140px;border-radius:50%;background:rgba(184,255,53,.05);pointer-events:none"></div>
          <div style="position:relative;z-index:1">
            <div style="font-family:var(--f-mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.28);margin-bottom:8px;display:flex;align-items:center;gap:8px"><span style="width:5px;height:5px;border-radius:50%;background:var(--lime-d);animation:pulseDot 2s infinite;display:inline-block"></span>AI Matching Live</div>
            <div style="font-family:var(--f-serif);font-size:32px;font-weight:900;color:var(--paper);letter-spacing:-.04em;line-height:1;margin-bottom:6px">Post a <span style="color:var(--lime);font-style:italic">New Job</span></div>
            <div style="font-family:var(--f-mono);font-size:10px;color:rgba(255,255,255,.3);letter-spacing:.06em">Matching begins the moment you publish</div>
          </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.PostMessage))
        {
          <div class="notice @(Model.PostSuccess ? "notice-ok" : "notice-warn")">@Model.PostMessage</div>
        }

        <div class="card">
          <div class="card-head"><span class="card-title">Job Details</span></div>
          <div class="card-body">
            <form method="post" asp-page-handler="PostJob" id="post-job-form">
              @Html.AntiForgeryToken()
              <div class="field">
                <label class="field-label">Job Title</label>
                <input name="Title" class="field-input" placeholder="e.g. Software Engineer Intern" required>
              </div>
              <div class="field">
                <label class="field-label">Description</label>
                <textarea name="Description" class="field-textarea" rows="4" placeholder="Describe the role, responsibilities, and what you're looking for..." required></textarea>
              </div>
              <div class="field-row">
                <div class="field">
                  <label class="field-label">Job Type</label>
                  <select name="JobType" class="field-input field-select">
                    <option>Internship</option><option>Part-time</option><option>Full-time</option><option>Contract</option>
                  </select>
                </div>
                <div class="field">
                  <label class="field-label">Duration</label>
                  <input name="Duration" class="field-input" placeholder="e.g. 3 months, Permanent">
                </div>
              </div>
              <div class="field">
                <label class="field-label">Application Deadline</label>
                <input name="Deadline" type="date" class="field-input" min="@DateTime.Now.ToString("yyyy-MM-dd")" required>
              </div>

              <div class="field" style="margin-top:8px">
                <label class="field-label">Required Skills</label>
                <div class="pj-skills-list" id="skills-preview">
                  <span style="font-family:var(--f-mono);font-size:9px;color:var(--muted);padding:4px">No skills added yet — search below</span>
                </div>
                <input type="hidden" name="SkillsJson" id="skills-json" value="[]">
                <div style="display:flex;gap:8px;margin-bottom:10px">
                  <div class="skill-dd-wrap" style="flex:1">
                    <input class="field-input" id="job-skill-q" placeholder="Search skill to add..." oninput="searchJobSkill(this.value)" onblur="setTimeout(closeJobDD,200)" autocomplete="off">
                    <div class="skill-dd" id="job-skill-dd"></div>
                  </div>
                  <select class="field-input field-select" id="job-skill-priority" style="width:130px">
                    <option value="Required">Required</option>
                    <option value="Preferred">Preferred</option>
                  </select>
                  <button type="button" class="btn btn-outline" onclick="addJobSkill()">+ Add</button>
                </div>
              </div>

              <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;background:linear-gradient(to right,rgba(184,255,53,.06),transparent);border:1px solid rgba(184,255,53,.15);border-radius:var(--r-lg);margin-top:4px">
                <div style="font-family:var(--f-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:6px">
                  <div style="width:5px;height:5px;border-radius:50%;background:var(--lime-d)"></div>
                  Matching starts on publish
                </div>
                <button type="submit" class="btn btn-lime">Publish Job →</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- ── MY JOBS ── -->
      <div class="panel" id="cp-jobs">
        <div class="card">
          <div class="card-head"><span class="card-title">My Jobs</span><button class="btn btn-lime btn-sm" onclick="sw('cp-post','Post a Job')">+ New Job</button></div>
          <div class="card-body-p0">
            @if (!Model.Jobs.Any())
            {
              <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">No jobs posted yet.</div>
            }
            <table class="data-table">
              <thead><tr><th>Title</th><th>Type</th><th>Duration</th><th>Posted</th><th>Deadline</th><th>Applicants</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody>
                @foreach (var job in Model.Jobs)
                {
                  var apps = Model.GetApplicationsByJob(job.JobID);
                  <tr>
                    <td><strong>@job.Title</strong></td>
                    <td><span class="badge badge-default">@job.JobType</span></td>
                    <td style="font-family:var(--f-mono);font-size:11px">@job.Duration</td>
                    <td style="font-family:var(--f-mono);font-size:11px">@job.PostedAt.ToString("MMM dd")</td>
                    <td style="font-family:var(--f-mono);font-size:11px">@job.Deadline.ToString("MMM dd")</td>
                    <td><strong>@apps.Count</strong></td>
                    <td><span class="status @(string.Equals(job.Status, "Closed", StringComparison.OrdinalIgnoreCase) ? "st-reject" : "st-active")">@job.Status</span></td>
                    <td class="actions-cell">
                      <div class="actions-wrap">
                        <button class="btn btn-ghost btn-sm" onclick="loadApplicants(@job.JobID,'@job.Title')">Applicants</button>
                        @if (!string.Equals(job.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                        {
                          <form method="post" asp-page-handler="CloseJob" style="display:inline" onsubmit="return confirm('Close this job? Students will no longer be able to apply.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="jobId" value="@job.JobID" />
                            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--red)">Close Job</button>
                          </form>
                        }
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ── APPLICANTS ── -->
      <div class="panel" id="cp-applicants">
        <div class="card">
          <div class="card-head"><span class="card-title" id="appl-panel-title">Ranked Applicants</span><span class="badge badge-default" id="appl-count-badge">Select a job to view applicants</span></div>
          @if (!Model.Jobs.Any())
          {
            <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">Post a job first to see applicants.</div>
          }
          else
          {
            <div style="padding:12px 20px;border-bottom:1px solid var(--line);background:var(--warm);display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <span style="font-family:var(--f-mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)">Select Job:</span>
              @foreach (var job in Model.Jobs)
              {
                <button class="btn btn-ghost btn-sm job-filter-btn" onclick="loadApplicants(@job.JobID,'@job.Title.Replace("'","\\'")')">@job.Title</button>
              }
            </div>
          }
          <div class="card-body-p0" id="appl-list">
            <div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">Click a job above to load its ranked applicants.</div>
          </div>
        </div>
      </div>

      <!-- ── COMPANY PROFILE ── -->
      <div class="panel" id="cp-profile">
        @if (!string.IsNullOrEmpty(Model.ProfileMessage))
        {
          <div class="notice notice-ok">@Model.ProfileMessage</div>
        }
        <div class="card">
          <div class="card-head"><span class="card-title">Company Profile</span></div>
          <div class="card-body">
            <form method="post" asp-page-handler="SaveProfile">
              @Html.AntiForgeryToken()
              <div class="field">
                <label class="field-label">Company Name</label>
                <input name="CompanyName" class="field-input" value="@(Model.Company?.CompanyName ?? "")" required>
              </div>
              <div class="field-row">
                <div class="field">
                  <label class="field-label">Industry</label>
                  <select name="Industry" class="field-input field-select">
                    @foreach (var ind in new[]{"Technology","Finance","Healthcare","Education","Other"})
                    {
                      <option value="@ind" selected="@(Model.Company?.Industry == ind ? "selected" : null)">@ind</option>
                    }
                  </select>
                </div>
                <div class="field">
                  <label class="field-label">Website</label>
                  <input name="Website" class="field-input" type="url" placeholder="https://yourcompany.com" value="@(Model.Company?.Website ?? "")">
                </div>
              </div>
              <div class="field">
                <label class="field-label">Company Description</label>
                <textarea name="Description" class="field-textarea" rows="4">@(Model.Company?.Description ?? "")</textarea>
              </div>
              <button type="submit" class="btn btn-lime">Save Profile →</button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
var allSkills = @Html.Raw(Model.AllSkillsJson);
var allApplicants = @Html.Raw(Model.AllApplicationsJson);
var jobSkills = [];

function sw(panelId, title) {
  document.querySelectorAll('.panel').forEach(function(p){ p.classList.remove('active'); });
  var el = document.getElementById(panelId);
  if (el) el.classList.add('active');
  document.querySelectorAll('.sb-link').forEach(function(l){ l.classList.remove('on'); });
  var lnkMap = {'cp-overview':'lnk-overview','cp-post':'lnk-post','cp-jobs':'lnk-jobs','cp-applicants':'lnk-applicants','cp-profile':'lnk-profile'};
  var lnk = document.getElementById(lnkMap[panelId]);
  if (lnk) lnk.classList.add('on');
  document.getElementById('page-title').textContent = title;
}

@if (TempData["ActiveTab"] != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', function() {
        var tabTitles = {'cp-overview':'Overview','cp-post':'Post a Job','cp-jobs':'My Jobs','cp-applicants':'Applicants','cp-profile':'Company Profile'};
        sw('@TempData["ActiveTab"]', tabTitles['@TempData["ActiveTab"]'] || 'Dashboard');
        @if (TempData["ActiveJobId"] != null)
        {
            <text>
            var savedJobId = @TempData["ActiveJobId"];
            var btn = document.querySelector('.job-filter-btn[onclick*="loadApplicants('+savedJobId+',"]');
            var title = btn ? btn.textContent.trim() : 'Job #' + savedJobId;
            loadApplicants(savedJobId, title);
            </text>
        }
    });
    </text>
}
function showToast(msg, cls) {
  var t = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  t.className = 'toast ' + (cls || 't-lime');
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 3200);
}
function searchJobSkill(q) {
  var dd = document.getElementById('job-skill-dd');
  if (!q || q.length < 1) { dd.style.display = 'none'; return; }
  var filtered = allSkills.filter(function(s){ return s.skillName.toLowerCase().includes(q.toLowerCase()); });
  if (!filtered.length) { dd.style.display = 'none'; return; }
  dd.innerHTML = filtered.slice(0, 8).map(function(s){
    return '<div class="skill-opt" onmousedown="selectJobSkill('+s.skillID+',\''+s.skillName+'\')"><span class="skill-opt-name">'+s.skillName+'</span><span class="skill-opt-cat">'+s.category+'</span></div>';
  }).join('');
  dd.style.display = 'block';
}
var selectedSkillId = null, selectedSkillName = null;
function selectJobSkill(id, name) {
  selectedSkillId = id; selectedSkillName = name;
  document.getElementById('job-skill-q').value = name;
  document.getElementById('job-skill-dd').style.display = 'none';
}
function closeJobDD() { document.getElementById('job-skill-dd').style.display = 'none'; }
function addJobSkill() {
  if (!selectedSkillId) { showToast('Select a skill first.', 't-red'); return; }
  var priority = document.getElementById('job-skill-priority').value;
  if (jobSkills.find(function(s){ return s.skillId === selectedSkillId; })) { showToast('Skill already added.', 't-red'); return; }
  jobSkills.push({skillId: selectedSkillId, skillName: selectedSkillName, priority: priority});
  document.getElementById('skills-json').value = JSON.stringify(jobSkills);
  var preview = document.getElementById('skills-preview');
  preview.innerHTML = jobSkills.map(function(s){
    return '<span class="skill-chip-added">'+s.skillName+' <span style="opacity:.6">·</span> '+s.priority+'</span>';
  }).join('');
  document.getElementById('job-skill-q').value = '';
  selectedSkillId = null; selectedSkillName = null;
}
function loadApplicants(jobId, title) {
  sw('cp-applicants', 'Applicants');
  var apps = allApplicants.filter(function(a){ return a.jobID === jobId; });
  apps.sort(function(a,b){ return b.matchScore - a.matchScore; });
  document.getElementById('appl-panel-title').textContent = 'Ranked Applicants — ' + title;
  document.getElementById('appl-count-badge').textContent = apps.length + ' applicants';
  var list = document.getElementById('appl-list');
  if (!apps.length) { list.innerHTML = '<div style="padding:28px;text-align:center;color:var(--muted);font-size:13px">No applications for this job yet.</div>'; return; }
  var token = document.querySelector("input[name='__RequestVerificationToken']").value;
  list.innerHTML = apps.map(function(a, i){
    var sc = parseFloat(a.matchScore);
    var tierClass = sc >= 80 ? 'appl-score-tier-high' : sc >= 60 ? 'appl-score-tier-mid' : 'appl-score-tier-low';
    var initials = (a.studentName || 'S').split(' ').map(function(p){ return p[0]; }).join('').toUpperCase().substring(0,2);
    var statusBadge = '';
    if (a.currentStatus && a.currentStatus !== 'Applied') {
      var badgeColor = a.currentStatus === 'Shortlisted' ? 'color:#1a7a3a;background:rgba(26,122,58,.1)' : a.currentStatus === 'Interview' ? 'color:#b46400;background:rgba(180,100,0,.1)' : 'color:var(--red);background:rgba(255,63,63,.08)';
      statusBadge = '<span style="font-family:var(--f-mono);font-size:9px;padding:2px 8px;border-radius:100px;'+badgeColor+'">'+a.currentStatus+'</span>';
    }
    return '<div class="appl-row" id="appl-row-'+a.applicationID+'">'+
      '<div class="appl-rank">#'+(i+1)+'</div>'+
      '<div class="appl-av">'+initials+'</div>'+
      '<div style="flex:1"><div style="font-size:13px;font-weight:700">'+(a.studentName || 'Student')+' '+statusBadge+'</div>'+
      '<div style="font-family:var(--f-mono);font-size:10px;color:var(--muted)">Applied '+a.appliedAt+'</div></div>'+
      '<div class="appl-score '+tierClass+'">'+sc+'%</div>'+
      '<div class="appl-actions">'+
      '<button class="btn btn-lime btn-sm" onclick="updateStatus('+a.applicationID+',\'Shortlisted\',\''+token+'\',this)">Shortlist</button>'+
      '<button class="btn btn-ghost btn-sm" onclick="updateStatus('+a.applicationID+',\'Interview\',\''+token+'\',this)">Interview</button>'+
      '<button class="btn btn-ghost btn-sm" style="color:var(--red)" onclick="updateStatus('+a.applicationID+',\'Rejected\',\''+token+'\',this)">Reject</button>'+
      '</div></div>';
  }).join('');
}

function updateStatus(applicationId, status, token, btn) {
  btn.disabled = true;
  btn.textContent = '...';
  var fd = new FormData();
  fd.append('applicationId', applicationId);
  fd.append('status', status);
  fd.append('__RequestVerificationToken', token);
  fetch('/Company/Dashboard?handler=UpdateStatus', { method: 'POST', body: fd })
    .then(function(r){
      if (r.ok) {
        var row = document.getElementById('appl-row-' + applicationId);
        if (row) {
          var badgeColor = status === 'Shortlisted' ? 'color:#1a7a3a;background:rgba(26,122,58,.1)' : status === 'Interview' ? 'color:#b46400;background:rgba(180,100,0,.1)' : 'color:var(--red);background:rgba(255,63,63,.08)';
          var nameDiv = row.querySelector('div[style*="font-weight:700"]');
          if (nameDiv) {
            var existing = nameDiv.querySelector('span');
            if (existing) existing.remove();
            var badge = document.createElement('span');
            badge.style.cssText = 'font-family:var(--f-mono);font-size:9px;padding:2px 8px;border-radius:100px;'+badgeColor;
            badge.textContent = status;
            nameDiv.appendChild(badge);
          }
        }
        showToast('Status updated to ' + status + '.', 't-lime');
        var actions = btn.parentElement;
        actions.querySelectorAll('button').forEach(function(b){ b.disabled = false; });
        if (status === 'Shortlisted') actions.querySelectorAll('button')[0].textContent = 'Shortlist';
        if (status === 'Interview')   actions.querySelectorAll('button')[1].textContent = 'Interview';
        if (status === 'Rejected')    actions.querySelectorAll('button')[2].textContent = 'Reject';
      } else {
        showToast('Update failed. Try again.', 't-red');
        btn.disabled = false;
        btn.textContent = status === 'Shortlisted' ? 'Shortlist' : status === 'Interview' ? 'Interview' : 'Reject';
      }
    })
    .catch(function(){
      showToast('Network error.', 't-red');
      btn.disabled = false;
    });
}
@if (!string.IsNullOrEmpty(Model.ToastMessage))
{
  <text>window.addEventListener('load', function(){ showToast('@Model.ToastMessage', '@Model.ToastClass'); });</text>
}
</script>
</body>
</html>