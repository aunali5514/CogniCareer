@page
@model CogniCareer.Pages.Auth.StudentAuthModel
@{
    Layout = null;
    ViewData["Title"] = "Student Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal — CogniCareer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Mono:wght@300;400;500&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div id="cursor-dot"></div>
    <div id="cursor-ring"></div>
    <div class="auth-wrap">
        <div class="auth-left">
            <div style="max-width:420px;margin:0 auto;width:100%">
                <a href="/" class="auth-back">← Back to Platform</a>
                <div class="auth-eyebrow">Student Portal</div>
                <h1 class="auth-h">Sign in<br><em class="serif-i">or register.</em></h1>
                <p class="auth-sub">Access your career dashboard, skill gap analysis, and matched job listings tailored to your profile.</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="notice notice-warn">@Model.ErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="notice notice-ok">@Model.SuccessMessage</div>
                }

                <div class="tab-row">
                    <button class="tab-btn on" id="tab-login" onclick="switchTab('login')">Sign In</button>
                    <button class="tab-btn" id="tab-reg" onclick="switchTab('reg')">Register</button>
                </div>

                <!-- Login Form -->
                <div id="login-form">
                    <form method="post" asp-page-handler="Login">
                        @Html.AntiForgeryToken()
                        <div class="field">
                            <label class="field-label">Email</label>
                            <input name="Email" class="field-input" type="email" placeholder="you@university.edu" required>
                        </div>
                        <div class="field">
                            <label class="field-label">Password</label>
                            <input name="Password" class="field-input" type="password" placeholder="••••••••" required>
                        </div>
                        <button type="submit" class="btn btn-dark btn-lg" style="margin-top:6px">Sign In →</button>
                    </form>
                </div>

                <!-- Register Form -->
                <div id="reg-form" style="display:none">
                    <form method="post" asp-page-handler="Register">
                        @Html.AntiForgeryToken()
                        <div class="field">
                            <label class="field-label">Full Name</label>
                            <input name="FullName" class="field-input" placeholder="Your full name" required>
                        </div>
                        <div class="field">
                            <label class="field-label">Email</label>
                            <input name="Email" class="field-input" type="email" placeholder="you@university.edu" required>
                        </div>
                        <div class="field-row">
                            <div class="field">
                                <label class="field-label">Password</label>
                                <input name="Password" class="field-input" type="password" placeholder="••••••••" required>
                            </div>
                            <div class="field">
                                <label class="field-label">Confirm</label>
                                <input name="ConfirmPassword" class="field-input" type="password" placeholder="••••••••" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-dark btn-lg" style="margin-top:6px">Create Account →</button>
                    </form>
                </div>

                <p style="margin-top:18px;font-size:12px;color:var(--muted)">Company? <a href="/Auth/CompanyAuth" style="color:var(--ink);text-decoration:underline">Login here →</a></p>
            </div>
        </div>

        <div class="auth-right">
            <div class="ar-label">Why CogniCareer</div>
            <div class="ar-title">Your score.<br>Your <em>rank.</em><br>Your roadmap.</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 24px">
                <div style="padding:10px 16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:3px">
                    <div style="font-family:'Playfair Display',serif;font-size:22px;font-weight:900;color:var(--lime);line-height:1;letter-spacing:-.04em">@Model.TotalStudents</div>
                    <div style="font-family:'DM Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.3)">Active Students</div>
                </div>
                <div style="padding:10px 16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:3px">
                    <div style="font-family:'Playfair Display',serif;font-size:22px;font-weight:900;color:var(--lime);line-height:1;letter-spacing:-.04em">@Model.TotalJobs</div>
                    <div style="font-family:'DM Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.3)">Active Jobs</div>
                </div>
            </div>
            <div class="ar-features">
                <div class="ar-feat"><div class="ar-num">01</div><div><div class="ar-feat-title">Match Score on Every Job</div><div class="ar-feat-desc">See your exact % compatibility before you apply.</div></div></div>
                <div class="ar-feat"><div class="ar-num">02</div><div><div class="ar-feat-title">Gap Analysis with Resources</div><div class="ar-feat-desc">Every missing skill links to a curated learning path.</div></div></div>
                <div class="ar-feat"><div class="ar-num">03</div><div><div class="ar-feat-title">Live Peer Benchmarking</div><div class="ar-feat-desc">Know your percentile among all applicants in real time.</div></div></div>
            </div>
        </div>
    </div>

    <script>
            function switchTab(tab) {
              document.getElementById('login-form').style.display = tab === 'login' ? 'block' : 'none';
              document.getElementById('reg-form').style.display = tab === 'reg' ? 'block' : 'none';
              document.getElementById('tab-login').className = 'tab-btn' + (tab === 'login' ? ' on' : '');
              document.getElementById('tab-reg').className = 'tab-btn' + (tab === 'reg' ? ' on' : '');
            }
            @if (Model.ShowRegisterTab)
            {
                    <text>switchTab('reg');</text>
            }
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>